<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="light_rig_tab_logic" class="panel_cine_light_rig" width="690" height="400" follows="all">
    <kit_page name="cine_light_rig_kit" page="light_group/cine_light_rig_tab" master_widget="cine_enabled" master_setting="CineLightRigEnabled" master_label="Light rig">
        <kit_page.section id="main" label="Main" cards="demo_card"/>
        <kit_card name="kc_demo_card" id="demo_card" title="Demo" kind="rows">
            <kit_row name="kr_strength" kind="slider" widget="demo_slider" label="Strength" setting="DemoStrength" bind="setting">
                <slider name="demo_slider" control_name="DemoStrength" min_val="0" max_val="1" increment="0.01"/>
            </kit_row>
            <kit_row name="kr_enabled" kind="toggle" widget="demo_switch" label="Enabled" bind="setting">
                <kit_switch name="demo_switch" control_name="DemoEnabled"/>
            </kit_row>
            <kit_row name="kr_status" kind="readout" widget="demo_text" label="Status">
                <text name="demo_text" font="SansSerifSmall"/>
            </kit_row>
        </kit_card>
        <light_rig_map name="cine_light_map" selector_card="demo_card" view_setting="DirectorV2LightMapView"/>
    </kit_page>
</panel>
