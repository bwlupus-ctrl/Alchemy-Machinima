struct NullStream {
    template <class T> NullStream& operator<<(const T&) { return *this; }
    NullStream& operator<<(std::ostream& (*)(std::ostream&)) { return *this; }
};
#define LL_WARNS(tag) NullStream()
#define LL_ENDL std::endl
constexpr F32 F_APPROXIMATELY_ZERO = 0.00001f;
enum { VX, VY, VZ, VW };
enum { TRANSLATED = 1, ROTATED = 2 };
void assert_main_thread() {}

struct LLUUID {
    int value = 0;
    LLUUID(int v = 0) : value(v) {}
    operator int() const { return value; }
    static const LLUUID null;
};
const LLUUID LLUUID::null;

struct LLQuaternion {
    F32 mQ[4]{0.f, 0.f, 0.f, 1.f};
    LLQuaternion() = default;
    LLQuaternion(F32 angle, F32 ax, F32 ay, F32 az) {
        const F32 n = std::sqrt(ax*ax + ay*ay + az*az), s = std::sin(angle * .5f) / n;
        mQ[0] = ax*s; mQ[1] = ay*s; mQ[2] = az*s; mQ[3] = std::cos(angle * .5f);
    }
    bool isFinite() const { return std::isfinite(mQ[0] + mQ[1] + mQ[2] + mQ[3]); }
};
struct LLVector3 {
    F32 mV[3]{};
    LLVector3() = default;
    LLVector3(F32 x, F32 y, F32 z) : mV{x, y, z} {}
    void clear() { mV[0] = mV[1] = mV[2] = 0.f; }
    bool isFinite() const { return std::isfinite(mV[0]) && std::isfinite(mV[1]) && std::isfinite(mV[2]); }
    void scaleVec(const LLVector3& s) { mV[0] *= s.mV[0]; mV[1] *= s.mV[1]; mV[2] *= s.mV[2]; }
    LLVector3 operator+(const LLVector3& b) const { return {mV[0]+b.mV[0], mV[1]+b.mV[1], mV[2]+b.mV[2]}; }
    LLVector3 operator-(const LLVector3& b) const { return {mV[0]-b.mV[0], mV[1]-b.mV[1], mV[2]-b.mV[2]}; }
    LLVector3 operator*(F32 k) const { return {mV[0]*k, mV[1]*k, mV[2]*k}; }
    LLVector3& operator+=(const LLVector3& b) { *this = *this + b; return *this; }
    LLVector3& operator-=(const LLVector3& b) { *this = *this - b; return *this; }
    static const LLVector3 zero;
};
const LLVector3 LLVector3::zero;
// The viewer's own v * q.
LLVector3 operator*(const LLVector3& a, const LLQuaternion& rot) {
    const F32 rw = -rot.mQ[VX]*a.mV[VX] - rot.mQ[VY]*a.mV[VY] - rot.mQ[VZ]*a.mV[VZ];
    const F32 rx =  rot.mQ[VW]*a.mV[VX] + rot.mQ[VY]*a.mV[VZ] - rot.mQ[VZ]*a.mV[VY];
    const F32 ry =  rot.mQ[VW]*a.mV[VY] + rot.mQ[VZ]*a.mV[VX] - rot.mQ[VX]*a.mV[VZ];
    const F32 rz =  rot.mQ[VW]*a.mV[VZ] + rot.mQ[VX]*a.mV[VY] - rot.mQ[VY]*a.mV[VX];
    return {-rw*rot.mQ[VX] + rx*rot.mQ[VW] - ry*rot.mQ[VZ] + rz*rot.mQ[VY],
            -rw*rot.mQ[VY] + ry*rot.mQ[VW] - rz*rot.mQ[VX] + rx*rot.mQ[VZ],
            -rw*rot.mQ[VZ] + rz*rot.mQ[VW] - rx*rot.mQ[VY] + ry*rot.mQ[VX]};
}
F32 dist_vec_squared(const LLVector3& a, const LLVector3& b) {
    const LLVector3 d = a - b; return d.mV[0]*d.mV[0] + d.mV[1]*d.mV[1] + d.mV[2]*d.mV[2];
}
struct LLVector3d {
    F64 mdV[3]{};
    LLVector3d() = default;
    LLVector3d(F64 x, F64 y, F64 z) : mdV{x, y, z} {}
    bool isFinite() const { return std::isfinite(mdV[0]) && std::isfinite(mdV[1]) && std::isfinite(mdV[2]); }
};
bool same(const LLVector3& a, const LLVector3& b) { return std::memcmp(a.mV, b.mV, sizeof(a.mV)) == 0; }
bool same(const LLVector3d& a, const LLVector3d& b) { return std::memcmp(a.mdV, b.mdV, sizeof(a.mdV)) == 0; }
bool near(const LLVector3& a, const LLVector3& b, F32 eps = 2.e-4f) { return dist_vec_squared(a, b) <= eps * eps; }
struct Agent {
    LLVector3d origin{256000., 512000., 0.}; // exact round trips, like a region origin
    LLVector3d getPosGlobalFromAgent(const LLVector3& p) const { return {origin.mdV[0]+p.mV[0], origin.mdV[1]+p.mV[1], origin.mdV[2]+p.mV[2]}; }
    LLVector3 getPosAgentFromGlobal(const LLVector3d& p) const { return {F32(p.mdV[0]-origin.mdV[0]), F32(p.mdV[1]-origin.mdV[1]), F32(p.mdV[2]-origin.mdV[2])}; }
} gAgent;

// "No skeleton writes anywhere": while a Stay in place or placement entry point
// runs, the only joint write allowed is the ROOT joint's world position/rotation.
int gStayScope = 0;
struct StayScope { StayScope() { ++gStayScope; } ~StayScope() { --gStayScope; } };
struct Joint {
    // LLJoint's dirty protocol: a write marks the subtree dirty (once); world position reads resolve
    // lazily; the CACHED world matrix, which rendering reads through a raw pointer, is only rebuilt
    // by updateWorldMatrixChildren().
    enum { MATRIX_DIRTY = 1, POSITION_DIRTY = 4 };
    mutable U32 mDirtyFlags = 0;
    std::vector<Joint*> children;
    LLVector3 cachedWorld;
    void touch(U32 flags = MATRIX_DIRTY | POSITION_DIRTY) {
        if ((flags | mDirtyFlags) == mDirtyFlags) return;
        mDirtyFlags |= flags;
        for (Joint* child : children) child->touch(flags);
    }
    Joint* parent = nullptr;
    LLVector3 pos, scale{1.f, 1.f, 1.f};
    LLQuaternion rot;
    int worldUpdates = 0, writes = 0;
    struct Overrides {
        std::map<int, LLVector3> values;
        const std::map<int, LLVector3>& getMap() const { return values; }
    } m_attachmentPosOverrides;
    const LLVector3& getPosition() const { return pos; }
    const LLVector3& getScale() const { return scale; }
    void setPosition(const LLVector3& v, bool overrides = true) {
        (void)overrides; assert(!gStayScope || !parent);
        if (!same(pos, v)) { pos = v; touch(); }
        ++writes;
    }
    void setRotation(const LLQuaternion& q) { assert(!gStayScope || !parent); rot = q; touch(); ++writes; }
    void setScale(const LLVector3& v) { assert(!gStayScope); scale = v; ++writes; }
    LLQuaternion getWorldRotation() const { assert(!parent); return rot; }
    void setWorldRotation(const LLQuaternion& q) { assert(!parent); rot = q; touch(); }
    LLVector3 getWorldPosition() const {
        mDirtyFlags &= ~U32(POSITION_DIRTY); // resolved lazily; the cached MATRIX is not
        if (!parent) return pos;
        LLVector3 local = pos; local.scaleVec(parent->scale);
        return local * parent->rot + parent->getWorldPosition();
    }
    void setWorldPosition(const LLVector3& v) { assert(!parent); if (!same(pos, v)) { pos = v; touch(); } }
    void updateWorldMatrixChildren() {
        ++worldUpdates;
        if (mDirtyFlags & MATRIX_DIRTY) { cachedWorld = getWorldPosition(); mDirtyFlags = 0; }
        for (Joint* child : children) child->updateWorldMatrixChildren();
    }
};
using LLJoint = Joint;
