    Check* mStayInPlaceCheck = &check;
    std::vector<int> selection;
    const std::vector<int>& selectedInstances() { return selection; }
    void onStayInPlaceCommit();
};
@UI@

// ---- the frame, in LLAppViewer::idle() order ------------------------------
std::function<void(LLGhostAvatar&)> gPoseStamp; // updatePostObjectList(): the last ordinary pose writer
std::function<void(LLGhostAvatar&)> gLatePose;  // the Switchboard tick: a forced pose cut after the main point
std::function<void()> gMidSample;               // HUD effects, drawable moves, particles: between the two
void postObjectList(std::vector<LLGhostAvatar*>& ghosts) { if (gPoseStamp) for (auto* g : ghosts) gPoseStamp(*g); }
void frame(std::vector<LLGhostAvatar*> ghosts, const std::function<void(LLGhostAvatar&)>& animate) {
    for (LLGhostAvatar* g : ghosts) {
        // LLVOAvatar::updateCharacter(): the root comes from the render position,
        // the mover may repaint it, then the controller evaluates the pose.
        g->mRoot->setWorldPosition(g->getRenderPosition());
        LLActorMover::instance().applyOverride(g);
        animate(*g);
        g->root.mDirtyFlags = g->pelvis.mDirtyFlags = Joint::MATRIX_DIRTY | Joint::POSITION_DIRTY;
        g->mRoot->updateWorldMatrixChildren(); // updateCharacter() leaves the matrices resolved
        StayScope scope;
        g->idleTail();
    }
    @FRAME_PRE@
    postObjectList(ghosts);
    @FRAME_MAIN@
    if (gMidSample) gMidSample();
    if (gLatePose) for (LLGhostAvatar* g : ghosts) gLatePose(*g);
    @FRAME_LATE@
}
LLVector3 rest(const LLGhostAvatar& g) {
    const auto& o = g.pelvis.m_attachmentPosOverrides.values;
    return {o.empty() ? 0.f : o.rbegin()->second.mV[VX], 0.f, g.pelvis.pos.mV[VZ]};
}
// Where the hips are drawn when they are over the clone's spot: the pose with only
// its rest forward offset and its own height, at the AUTHORED root.
LLVector3 spot(const LLGhostAvatar& g, const LLVector3& authored_root) {
    LLVector3 pivot_authored = authored_root; pivot_authored.mV[VZ] -= llmax(0.f, g.pelvisToFoot);
    if (g.mGhostFloorPosition) pivot_authored = gAgent.getPosAgentFromGlobal(g.mDesiredGhostFootGlobal);
    LLVector3 local = rest(g); local.scaleVec(g.root.scale);
    return pivot_authored + (authored_root + local * g.root.rot - pivot_authored) * g.mEntityScale;
}
LLVector3 footRoot(const LLGhostAvatar& g, const LLVector3& foot) { return {foot.mV[0], foot.mV[1], foot.mV[2] + g.pelvisToFoot + g.clientHeight}; }

struct Step { // ALSteppedAnimRuntime's pelvis and root position channels
    struct Local { LLVector3 pos; };
    struct Buffer { std::vector<Local> joints{{}}; LLVector3 rootPos; };
    struct Entry { Buffer mSmooth, mWritten, mVerifyPose; std::vector<int> mWrittenMask{0}, mVerifyMask{0}; int mRootWrittenMask = 0, mVerifyRootMask = 0; } entry;
    enum { WRITE_POS = 1 };
    Buffer held; bool holdPelvis = true, holdRoot = false;
    LLGhostAvatar* ghost = nullptr;
    static bool vecEqual(const LLVector3& x, const LLVector3& y) { return std::memcmp(x.mV, y.mV, sizeof(x.mV)) == 0; }
    void applyHeld() {
        LLVOAvatar* avatar = ghost; (void)avatar;
        @STEP_BEGIN@
        Joint* joint = ghost->mPelvisp; Joint* root = ghost->mRoot; const int i = 0;
        entry.mSmooth.joints[0].pos = joint->getPosition(); entry.mSmooth.rootPos = root->getPosition(); // readPose
        Buffer render = entry.mSmooth;
        if (holdPelvis) render.joints[0] = held.joints[0];
        if (holdRoot) render.rootPos = held.rootPos;
        entry.mWritten = render; entry.mWrittenMask[0] = 0; entry.mRootWrittenMask = 0;
        const Local& target = render.joints[i];
        @STEP_WRITE@
        @STEP_ROOT_WRITE@
        if (gStepVerify) avatar->captureStepAnimRenderState(); // writeOverlay()'s capture
        @STEP_PRESENT@
    }
    void endFrameRestore() {
        Joint* joint = ghost->mPelvisp; Joint* root = ghost->mRoot; const int i = 0;
        const int mask = entry.mWrittenMask[0]; bool restored = false;
        entry.mVerifyPose = entry.mSmooth; entry.mVerifyRootMask = 0;
        @STEP_RESTORE@
        @STEP_ROOT_RESTORE@
        (void)restored; entry.mWrittenMask[0] = 0; entry.mRootWrittenMask = 0;
        @STEP_RESTORE_END@
    }
    // The root half of ALSteppedAnimRuntime::verifyRestored(): no "unexpected root change".
    bool verifyRestored() {
        const LLVOAvatar* avatar = ghost; Joint* root = ghost->mRoot;
        @STEP_VERIFY_ROOT@
        return !(root && (entry.mVerifyRootMask & WRITE_POS) && !vecEqual(verify_root, entry.mVerifyPose.rootPos));
    }
};

int main() {
    auto& studio = ALGhostStudio::instance();
    auto& mover = LLActorMover::instance();
    const F32 PI = 3.14159265f;
    const LLQuaternion turned(1.1f, 0.f, 0.f, 1.f);            // yaw
    const LLQuaternion tilted(.9f, .3f, 1.f, .2f);             // local height has world-horizontal parts
    const LLQuaternion upside_down(PI, 1.f, 0.f, 0.f);         // Floor Reflect's body flip
    auto drift = [](int n) { return LLVector3(.125f + .31f * n, -.4f * n + .05f, -.2f - .03f * n); };

    // ---- OFF: nothing registered, nothing presented, nothing published --------
    {
        LLGhostAvatar off(1);
        const LLVector3 foot(40.f, 50.f, 20.f);
        { StayScope s; off.setGhostFootPosition(foot); }
        const LLVector3 authored = footRoot(off, foot);
        assert(same(off.object, authored) && same(off.root.pos, authored) && off.publishes == 1);
        for (int n = 0; n < 4; ++n) {
            frame({&off}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(n); });
            assert(same(off.object, authored) && same(off.root.pos, authored)); // the body drifts, as before
            assert(same(off.getBaseRootPosition(), authored));
        }
        assert(!LLGhostAvatar::hasStayInPlaceAvatars() && off.publishes == 1 && off.bounds == 0 && off.pelvis.writes == 0);
        assert(same(off.mStayOffset, LLVector3::zero) && !near(off.hips(), spot(off, authored)));
        assert(same(off.getPlacedRootPosition(), off.root.pos) && same(arrivalFacingDelta(&off, foot), off.root.pos - foot));
        mover.driving[&off] = LLVector3(41.f, 50.f, 21.f);    // a path walk, byte for byte the old contract
        frame({&off}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(2); });
        assert(same(off.object, LLVector3(41.f, 50.f, 21.f)) && same(off.root.pos, off.object) && off.publishes == 2);
        mover.driving.clear();
    }

    // ---- ON: hips over the spot, height kept, in every root frame ----------------
    struct Case { const char* name; LLQuaternion rot; F32 scale; };
    for (const Case& c : {Case{"upright", LLQuaternion(), 1.f}, Case{"turned", turned, 1.f}, Case{"tilted", tilted, 1.f},
                          Case{"turned and scaled", turned, 2.f}, Case{"tilted and small", tilted, .5f}}) {
        LLGhostAvatar a(2);
        a.root.rot = c.rot; a.mEntityScale = c.scale;
        a.pelvis.m_attachmentPosOverrides.values[3] = LLVector3(.25f, .5f, 9.f);
        a.pelvis.m_attachmentPosOverrides.values[8] = LLVector3(.125f, -.25f, 12.f); // the highest key is the active override
        const LLVector3 foot(60.f, 70.f, 25.f), authored = footRoot(a, foot);
        { StayScope s; a.setGhostFootPosition(foot); studio.setInstanceStayInPlace(2, true); }
        assert(a.mStayInPlace && LLGhostAvatar::hasStayInPlaceAvatars());
        assert(near(a.hips(), spot(a, authored))); // the toggle shows at once, before any idle
        const LLVector3d authored_foot = a.mDesiredGhostFootGlobal;
        for (int n = 0; n < 6; ++n) {
            frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(n); });
            assert(near(a.hips(), spot(a, authored)));                    // over the spot, this very frame
            assert(same(a.pelvis.pos, drift(n)) && a.pelvis.writes == 0); // the skeleton is untouched: height and pose kept
            assert(same(a.getBaseRootPosition(), authored));              // authoring space never sees the offset
            assert(same(a.mDesiredGhostFootGlobal, authored_foot));
            assert(same(a.object, a.root.pos));                           // culling/picking follow the presented root
        }
        assert(!near(a.root.pos, authored));                              // ...which really is displaced
        // A standing pose (rest forward offset, no sideways) presents the authored root itself.
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = LLVector3(.125f, 0.f, -.3f); });
        assert(near(a.root.pos, authored, 1.e-5f));
        // A held pose publishes nothing more.
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(3); });
        const int publishes = a.publishes, bounds = a.bounds;
        for (int n = 0; n < 3; ++n) frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(3); });
        assert(a.publishes == publishes && a.bounds == bounds);

        // Drag / Ghost Edit / crowd / undo: authored values go in and stay authored.
        const LLVector3 dragged(63.f, 68.f, 25.5f);
        { StayScope s; a.setGhostFootPosition(dragged); }
        assert(same(a.mDesiredGhostFootGlobal, gAgent.getPosGlobalFromAgent(dragged)));
        assert(same(a.getBaseRootPosition(), footRoot(a, dragged)) && near(a.hips(), spot(a, footRoot(a, dragged))));
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(4); });
        assert(near(a.hips(), spot(a, footRoot(a, dragged))) && same(a.getBaseRootPosition(), footRoot(a, dragged)));
        { StayScope s; a.setGhostFootPosition(foot); } // undo restores the stored authored foot
        assert(same(a.mDesiredGhostFootGlobal, authored_foot) && same(a.getBaseRootPosition(), authored));
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(5); });
        assert(near(a.hips(), spot(a, authored)));

        // A path walk: the mover repaints its own authored root every frame.
        for (int n = 0; n < 5; ++n) {
            const LLVector3 path(60.f + .001f * n, 70.f + .4f * n, 26.f);
            mover.driving[&a] = path;
            frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(n % 3); });
            assert(same(a.getBaseRootPosition(), path));   // the mover's capture space is its own path
            assert(near(a.hips(), spot(a, path)));
            assert(same(a.mDesiredGhostFootGlobal, authored_foot)); // the walk never touches the stored foot
        }
        // A slow walk in a standing pose (no offset to hide behind): still every frame.
        for (int n = 0; n < 4; ++n) {
            const LLVector3 path(61.f + .001f * n, 72.f, 26.f);
            mover.driving[&a] = path;
            frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = LLVector3(.125f, 0.f, -.3f); });
            assert(same(a.getBaseRootPosition(), path) && near(a.hips(), spot(a, path), 2.e-5f));
        }
        mover.driving.clear();
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(1); });   // the walk ends: back on the authored foot
        assert(near(a.hips(), spot(a, authored)) && same(a.getBaseRootPosition(), authored));

        // The last ordinary pose writer (a Flip / mirror stamp) is what gets measured.
        gPoseStamp = [](LLGhostAvatar& g) { g.pelvis.pos.mV[VY] = -g.pelvis.pos.mV[VY]; g.pelvis.pos.mV[VX] += .5f; };
        int sampled = 0;
        gMidSample = [&] { assert(near(a.hips(), spot(a, authored))); ++sampled; }; // particles and HUD see it too
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(2); });
        assert(near(a.hips(), spot(a, authored)) && sampled == 1);
        gPoseStamp = nullptr; gMidSample = nullptr;

        // A LATE pose writer (the Switchboard's forced pose cut) is presented before the cameras sample.
        gLatePose = [](LLGhostAvatar& g) { g.pelvis.pos = LLVector3(-.7f, .9f, -.5f); };
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(2); });
        assert(near(a.hips(), spot(a, authored)) && same(a.pelvis.pos, LLVector3(-.7f, .9f, -.5f)));
        gLatePose = nullptr;

        // Late TRANSFORM edits (Ghost Edit rotate / stretch from the manip proxy tick, the floor
        // hold's direct root turn): never the previous rotation's or scale's offset.
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(4); });
        { StayScope s; a.setGhostRotation(LLQuaternion(2.3f, 0.f, 0.f, 1.f)); }
        assert(near(a.hips(), spot(a, authored)));
        { StayScope s; a.setEntityScale(c.scale * 1.5f); }
        assert(near(a.hips(), spot(a, authored)));
        { StayScope s; a.mRoot->setWorldRotation(c.rot); a.ghostSlamPosition(authored); a.updateEntityOuterTransform(); }
        assert(near(a.hips(), spot(a, authored)));
        { StayScope s; a.setEntityScale(c.scale); }
        assert(near(a.hips(), spot(a, authored)) && same(a.getBaseRootPosition(), authored));

        // The manip proxy's root lift excludes the shift (it turns with the body).
        frame({&a}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(4); });
        // Readers of where the clone STANDS (arrival facing, heading preview, rig bisector): the
        // authored root, not the displaced one.
        const LLVector3 from(1.f, 2.f, 3.f);
        assert(!near(a.root.pos, authored) && same(a.getPlacedRootPosition(), authored));
        assert(same(arrivalFacingDelta(&a, from), authored - from) && same(headingPreviewOrigin(&a), authored));
        assert(same(rigBisectorFoot(&a), authored));
        const LLVector3 lift = a.rendered(a.root.pos) - a.getStayInPlaceRenderedOffset() - foot;
        assert(near(lift, LLVector3(0.f, 0.f, a.pelvisToFoot * a.mEntityScale)));

        // OFF again: exactly the authored placement, at once.
        { StayScope s; studio.setInstanceStayInPlace(2, false); }
        assert(!LLGhostAvatar::hasStayInPlaceAvatars() && same(a.object, authored) && same(a.root.pos, authored));
        assert(same(a.mStayOffset, LLVector3::zero) && a.forcedBounds == 1 && a.pelvis.writes == 0);
        (void)c.name;
    }

    // ---- Floor Reflect: upside-down root, mirrored pose, pinned scale pivot ----------
    for (F32 scale : {1.f, 2.f}) {
        LLGhostAvatar f(4);
        studio.instances[4].mReflectFloor = true;
        f.mEntityDriveMode = ALGhostStudio::DRIVE_REFLECT; f.mEntityScale = scale;
        const LLVector3 floor_root(80.f, 90.f, 9.f), floor_foot(80.f, 90.f, 10.f);
        { StayScope s; studio.setInstanceStayInPlace(4, true); }
        for (int n = 0; n < 5; ++n) {
            // Studio's post pass: mirrored placement, then the stamp (root flip + hold, reflected local pose).
            gPoseStamp = [&](LLGhostAvatar& g) {
                StayScope s;
                g.setGhostFloorPosition(floor_root, floor_foot);
                g.floorStamp(upside_down);
                const LLVector3 d = drift(n);
                g.pelvis.pos = LLVector3(d.mV[0], -d.mV[1], d.mV[2]);
            };
            frame({&f}, [](LLGhostAvatar&) {});
            assert(near(f.hips(), spot(f, floor_root)));
            assert(same(f.getBaseRootPosition(), floor_root));
            assert(same(gAgent.getPosAgentFromGlobal(f.mReflectFloorRootHold.position), floor_root)); // the hold is authored
        }
        // The source goes away: the frozen hold alone keeps placing the clone (idleUpdate), never twice.
        gPoseStamp = nullptr;
        for (int n = 0; n < 3; ++n) {
            frame({&f}, [](LLGhostAvatar&) {});
            assert(near(f.hips(), spot(f, floor_root)) && same(f.getBaseRootPosition(), floor_root));
        }
        { StayScope s; studio.setInstanceStayInPlace(4, false); }
        assert(same(f.root.pos, floor_root) && f.pelvis.writes == 0);
    }

    // ---- Stepped: its held overlay changes the pelvis after the main point ---------
    for (bool hold_root : {false, true}) {
        LLGhostAvatar s(5);
        s.root.rot = turned;
        const LLVector3 foot(100.f, 110.f, 30.f), authored = footRoot(s, foot);
        { StayScope scope; s.setGhostFootPosition(foot); studio.setInstanceStayInPlace(5, true); }
        Step step; step.ghost = &s; step.holdRoot = hold_root;
        LLControlAvatar worn; LLViewerObject tail; tail.control = &worn;   // a worn animesh
        LLViewerJointAttachment point; point.mAttachedObjects = {&tail};
        s.mAttachmentPoints[1] = &point;
        gStepVerify = true;
        step.held.joints[0].pos = LLVector3(2.f, 3.f, -.8f);
        const LLVector3 held_root = authored + LLVector3(.5f, -.25f, 0.f); // a root Stepped captured on an earlier tick
        step.held.rootPos = held_root;
        for (int n = 0; n < 3; ++n) {
            const LLVector3 smooth = drift(n + 1);
            frame({&s}, [&](LLGhostAvatar& g) { g.pelvis.pos = smooth; });
            assert(near(s.hips(), spot(s, authored)));                 // particles, VCam and cameras sample this
            step.applyHeld();
            assert(same(step.entry.mSmooth.rootPos, authored));        // Stepped captured the AUTHORED root
            assert(same(step.entry.mSmooth.joints[0].pos, smooth));    // ...and the raw pose
            assert(same(s.pelvis.pos, LLVector3(2.f, 3.f, -.8f)));     // its held pelvis is what renders
            assert(near(s.hips(), spot(s, hold_root ? held_root : authored))); // hips over the spot for THAT pelvis
            // StepAnimDebugVerify expects exactly what renders (clone and worn animesh): no false mismatch.
            assert(same(s.capturedRoot, s.root.pos) && s.captures == 2 * (n + 1) && worn.captures == n + 1);
            assert(same(s.getBaseRootPosition(), authored));
            step.endFrameRestore();
            assert(same(s.pelvis.pos, smooth));                        // Stepped restored its own channels
            assert(near(s.hips(), spot(s, authored)));                 // a snapshot between frames still stays
            assert(near(s.root.pos - s.mStayOffset, authored, 5.e-5f) && same(s.getBaseRootPosition(), authored));
            assert(!s.mStaySteppedWindow && step.verifyRestored());
        }
        assert(s.pelvis.writes == 6); // Stepped's own writes only: one hold and one restore a frame
        // A held pelvis at its rest reference presents no offset, so Stepped DOES restore the root it
        // held; the smooth pose's offset is presented afterwards. Its restore check still passes.
        step.held.joints[0].pos = LLVector3(0.f, 0.f, -.6f);
        frame({&s}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(2); });
        step.applyHeld();
        assert(near(s.hips(), spot(s, hold_root ? held_root : authored)));
        step.endFrameRestore();
        assert(!hold_root || (step.entry.mVerifyRootMask & Step::WRITE_POS));
        assert(near(s.hips(), spot(s, authored)) && !near(s.root.pos, authored) && step.verifyRestored());
        if (hold_root) { // ...and a REAL root change after the restore is still reported
            const LLVector3 kept = s.root.pos;
            s.root.pos = kept + LLVector3(.01f, 0.f, 0.f);
            assert(!step.verifyRestored());
            s.root.pos = kept;
            assert(step.verifyRestored());
            // An offset below the presenter's tolerance is not written: the joint still IS the restored root.
            const LLVector3 kept_offset = s.mStayOffset;
            s.root.pos = authored; s.mStayOffset = LLVector3(3.e-5f, 0.f, 0.f);
            assert(step.verifyRestored());
            s.root.pos = kept; s.mStayOffset = kept_offset;
        }
        s.mStaySteppedWindow = true; s.built = false;      // a stale window on a body that cannot be presented
        frame({&s}, [](LLGhostAvatar&) {});
        assert(!s.mStaySteppedWindow);
        s.built = true;
        { StayScope scope; studio.setInstanceStayInPlace(5, false); }
        assert(same(s.root.pos, authored));
        gStepVerify = false;
    }

    // ---- a Stay in place clone as another clone's SOURCE (Reflect "Mirror position") --
    {
        LLGhostAvatar src(20), mirror(21);
        LLGhostAvatar::sLiveSources.insert(20);
        src.root.rot = turned;
        const LLVector3 foot(120.f, 130.f, 40.f), authored = footRoot(src, foot);
        { StayScope s; src.setGhostFootPosition(foot); studio.setInstanceStayInPlace(20, true); }
        LLVector3d wall, floor, floor_root; int reads = 0;
        gPoseStamp = [&](LLGhostAvatar& g) {
            if (&g != &mirror) return;
            wall = reflectSourceFoot(&src);            // Wall: the source's root joint
            floor = reflectSourceFoot(&src, true);     // Floor: its base root
            floor_root = gAgent.getPosGlobalFromAgent(src.getRootJoint()->getWorldPosition()); // Floor root
            ++reads;
        };
        for (int n = 0; n < 3; ++n) {
            frame({&src, &mirror}, [&](LLGhostAvatar& g) { if (&g == &src) g.pelvis.pos = drift(n + 1); });
            assert(reads == n + 1);
            // What Studio stores into the mirror clone's authored foot never contains the source's offset.
            assert(same(wall, gAgent.getPosGlobalFromAgent(foot)) && same(floor, gAgent.getPosGlobalFromAgent(foot)));
            assert(same(floor_root, gAgent.getPosGlobalFromAgent(authored)));
            assert(near(src.hips(), spot(src, authored)) && !near(src.root.pos, authored)); // presented again right after
        }
        // A stationary source (held pose, nonzero offset) publishes NOTHING per frame: its presented
        // root joint is put back exactly after the pass.
        {
            const int publishes = src.publishes;
            const LLVector3 presented = src.root.pos;
            for (int n = 0; n < 3; ++n) {
                frame({&src, &mirror}, [&](LLGhostAvatar& g) { if (&g == &src) g.pelvis.pos = drift(3); });
                assert(same(wall, gAgent.getPosGlobalFromAgent(foot)) && same(floor_root, gAgent.getPosGlobalFromAgent(authored)));
                assert(src.publishes == publishes && same(src.root.pos, presented) && near(src.hips(), spot(src, authored)));
                assert(src.drawnWhereItStands()); // its cached matrices never left presented space
            }
            assert(reads == 6);
            int expected = publishes;
            // A Flip stamp on the source (Mirror/Directed drive; not "stamp driven") writes the pose and
            // propagates the child matrices at the AUTHORED root inside the pass. With a steady offset
            // nothing else would publish: the skeleton must still end up drawn in presented space.
            gPoseStamp = [&](LLGhostAvatar& g) {
                if (&g != &src) return;
                g.pelvis.pos.mV[VY] = -g.pelvis.pos.mV[VY];
                g.pelvis.touch(); g.mRoot->updateWorldMatrixChildren();
            };
            for (int n = 0; n < 3; ++n) {
                frame({&src, &mirror}, [&](LLGhostAvatar& g) { if (&g == &src) g.pelvis.pos = drift(3); });
                assert(src.publishes == ++expected && src.drawnWhereItStands() && near(src.hips(), spot(src, authored)));
            }
            // The start-offset history: the same propagation (its delayed pose equal to the live one here).
            gPoseStamp = [&](LLGhostAvatar& g) { if (&g == &src) g.mRoot->updateWorldMatrixChildren(); };
            for (int n = 0; n < 3; ++n) {
                frame({&src, &mirror}, [&](LLGhostAvatar& g) { if (&g == &src) g.pelvis.pos = drift(3); });
                assert(src.publishes == ++expected && src.drawnWhereItStands() && same(src.root.pos, presented));
            }
            // So does a transform setter or an unconditional placement write inside the pass.
            gPoseStamp = [&](LLGhostAvatar& g) { if (&g == &src) { StayScope s; g.setGhostRotation(turned); } };
            frame({&src, &mirror}, [&](LLGhostAvatar& g) { if (&g == &src) g.pelvis.pos = drift(3); });
            expected += 2; // the setter's own + the re-present
            assert(src.publishes == expected && same(src.root.pos, presented) && src.drawnWhereItStands());
            gPoseStamp = [&](LLGhostAvatar& g) { if (&g == &src) { StayScope s; g.ghostSlamPosition(authored); } };
            frame({&src, &mirror}, [&](LLGhostAvatar& g) { if (&g == &src) g.pelvis.pos = drift(3); });
            expected += 2;
            assert(src.publishes == expected && same(src.root.pos, presented) && src.drawnWhereItStands());
            // A per-frame foot placement of the SAME spot inside the pass (a Reflect "Mirror position"
            // clone that is itself a source) is no write at all: its foot lock holds.
            gPoseStamp = [&](LLGhostAvatar& g) { if (&g == &src) { StayScope s; g.setGhostFootPosition(foot); } };
            for (int n = 0; n < 2; ++n) frame({&src, &mirror}, [&](LLGhostAvatar& g) { if (&g == &src) g.pelvis.pos = drift(3); });
            assert(src.publishes == expected && same(src.root.pos, presented) && near(src.hips(), spot(src, authored)));
            assert(src.drawnWhereItStands());
            reads = 3; // keep the placement / rotation alternation of the next test
        }
        // The source is itself re-placed inside that pass before the mirror reads it.
        const LLVector3 moved(121.f, 131.f, 40.f);
        gPoseStamp = [&](LLGhostAvatar& g) {
            if (&g == &src) { StayScope s; if (reads % 2) g.setGhostFootPosition(moved); else g.setGhostRotation(turned); return; }
            wall = reflectSourceFoot(&src);
            floor_root = gAgent.getPosGlobalFromAgent(src.getRootJoint()->getWorldPosition());
            ++reads;
        };
        for (int n = 0; n < 2; ++n) { // a placement write, then a rotation write, inside the pass
            frame({&src, &mirror}, [&](LLGhostAvatar& g) { if (&g == &src) g.pelvis.pos = drift(2 + n); });
            assert(same(wall, gAgent.getPosGlobalFromAgent(moved)) && same(floor_root, gAgent.getPosGlobalFromAgent(footRoot(src, moved))));
            assert(near(src.hips(), spot(src, footRoot(src, moved))));
        }
        gPoseStamp = nullptr;
        LLGhostAvatar::sLiveSources.clear();
        { StayScope s; studio.setInstanceStayInPlace(20, false); }
    }

    // ---- switched off while the body cannot be placed: the restore is owed, then paid --
    {
        LLGhostAvatar d(22);
        const LLVector3 foot(140.f, 150.f, 45.f), authored = footRoot(d, foot);
        { StayScope s; d.setGhostFootPosition(foot); studio.setInstanceStayInPlace(22, true); }
        frame({&d}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(3); });
        assert(!near(d.root.pos, authored));
        d.region = false;
        { StayScope s; studio.setInstanceStayInPlace(22, false); }
        assert(d.mStayInPlace && d.mStayDisabling && LLGhostAvatar::hasStayInPlaceAvatars());
        frame({&d}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(4); });
        assert(d.mStayDisabling && !near(d.root.pos, authored));    // still not placeable
        d.region = true;
        frame({&d}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(5); });
        assert(!d.mStayInPlace && !LLGhostAvatar::hasStayInPlaceAvatars());
        assert(same(d.object, authored) && same(d.root.pos, authored) && same(d.mStayOffset, LLVector3::zero));
        // Switched back on before an owed restore ran: it simply stays on.
        { StayScope s; studio.setInstanceStayInPlace(22, true); }
        frame({&d}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(3); });
        d.region = false;
        { StayScope s; studio.setInstanceStayInPlace(22, false); studio.setInstanceStayInPlace(22, true); }
        d.region = true;
        assert(d.mStayInPlace && !d.mStayDisabling);
        frame({&d}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(2); });
        assert(near(d.hips(), spot(d, authored)) && same(d.getBaseRootPosition(), authored));
        { StayScope s; studio.setInstanceStayInPlace(22, false); }
        assert(same(d.root.pos, authored));
    }

    // ---- registry, respawn, overlay, history ------------------------------------------
    {
        studio.instances[7].mStayInPlace = true;                       // an instance whose switch is on
        studio.instances[8].mKind = ALGhostStudio::BACKING_OVERLAY;
        studio.instances[8].mStayInPlace = true;                       // (a converted copy): never an overlay helper
        {
            LLGhostAvatar first(7), overlay(8);
            assert(first.mStayInPlace && LLGhostAvatar::sStayInPlaceAvatars.count(&first) == 1);
            assert(!overlay.mStayInPlace && LLGhostAvatar::sStayInPlaceAvatars.count(&overlay) == 0);
            { StayScope s; overlay.setStayInPlace(true); studio.setInstanceStayInPlace(8, false); }
            assert(!overlay.mStayInPlace && studio.instances[8].mStayInPlace); // the model setter ignores overlays too
            { StayScope s; first.setGhostFootPosition(LLVector3(5.f, 6.f, 7.f)); }
            frame({&first}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(2); });
            assert(near(first.hips(), spot(first, footRoot(first, LLVector3(5.f, 6.f, 7.f)))));
            first.markForDeath();                                      // delete: the registry forgets the body at once
            assert(!LLGhostAvatar::hasStayInPlaceAvatars() && !first.mStayInPlace && same(first.mStayOffset, LLVector3::zero));
            LLGhostAvatar::applyStayInPlaceAvatars();
            LLGhostAvatar respawned(7);                                // the fresh body of the same instance re-arms
            assert(respawned.mStayInPlace && same(respawned.mStayOffset, LLVector3::zero));
            { StayScope s; respawned.setGhostFootPosition(LLVector3(5.f, 6.f, 7.f)); }
            frame({&respawned}, [&](LLGhostAvatar& g) { g.pelvis.pos = drift(1); });
            assert(near(respawned.hips(), spot(respawned, footRoot(respawned, LLVector3(5.f, 6.f, 7.f)))));
        }
        assert(!LLGhostAvatar::hasStayInPlaceAvatars());               // destruction clears it as well
        ALGhostStudio::Instance copy = studio.instances[7];            // duplicates / crowd copies are wholesale
        assert(copy.mStayInPlace);
        studio.instances[7].mStayInPlace = false;

        LLGhostAvatar a(11), b(12), overlay(13);
        studio.instances[13].mKind = ALGhostStudio::BACKING_OVERLAY;
        ALPanelGhostStudio panel; panel.selection = {11, 12, 13};      // expanded group / multi-selection
        auto& history = ALKitShell::shell().h;
        { StayScope s; panel.onStayInPlaceCommit(); }
        assert(history.records == 1 && a.mStayInPlace && b.mStayInPlace && !overlay.mStayInPlace);
        assert(studio.instances[11].mStayInPlace && studio.instances[12].mStayInPlace && !studio.instances[13].mStayInPlace);
        panel.selection = {13};                                        // undo targets the captured clones, not the selection
        { StayScope s; assert(history.run(false)); }
        assert(!a.mStayInPlace && !b.mStayInPlace && !LLGhostAvatar::hasStayInPlaceAvatars());
        { StayScope s; assert(history.run(true)); }
        assert(a.mStayInPlace && b.mStayInPlace);
        { StayScope s; studio.setInstanceStayInPlace(11, false); }     // a conflict fails the whole step before any replay
        assert(!history.run(false) && studio.instances[12].mStayInPlace);
        { StayScope s; panel.selection = {11, 12}; panel.check.value = true; panel.onStayInPlaceCommit(); }
        assert(history.records == 2);
        { StayScope s; panel.onStayInPlaceCommit(); }                  // nothing changes: no empty undo step
        assert(history.records == 2);
    }
    assert(!LLGhostAvatar::hasStayInPlaceAvatars());
    std::cout << "PASS OFF inert; ON hips over the spot (upright/turned/tilted/scaled/floor), height and pose kept, "
                 "authored drag/path/undo/floor hold untouched, no skeleton writes, Stepped held pelvis + held root + "
                 "between-frame snapshot + debug verify, late pose and transform writers, Stay source for Reflect, "
                 "owed switch-off restore, delete/respawn/overlay registry, multi-select history\n";
    return 0;
}
