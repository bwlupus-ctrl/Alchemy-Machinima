};
struct DrawablePtr {
    LLDrawable* p = nullptr;
    bool notNull() const { return p != nullptr; }
    LLDrawable* operator->() const { return p; }
};
struct Pipeline { void updateMoveNormalAsync(const DrawablePtr& d); } gPipeline;
struct ALGhostStudio {
    enum { BACKING_ENTITY_CLONE, BACKING_OVERLAY };
    enum { DRIVE_MIRROR, DRIVE_DIRECTED, DRIVE_FROZEN, DRIVE_TRUE_MIRROR, DRIVE_REFLECT };
    struct Instance {
        bool mDeleting = false;
        int mKind = BACKING_ENTITY_CLONE;
        bool mStayInPlace = false;
        bool mReflectFloor = false;
        LLVector3d mFootGlobal; // authored; only the tests write it
        LLGhostAvatar* ghost = nullptr;
    };
    std::map<int, Instance> instances;
    int revision = 0;
    static ALGhostStudio& instance() { static ALGhostStudio s; return s; }
    Instance* getInstance(int id) { auto i = instances.find(id); return i == instances.end() ? nullptr : &i->second; }
    const Instance* findInstanceByRuntime(int id) { return getInstance(id); }
    void touchInstances() { ++revision; }
    LLGhostAvatar* resolveEntityClone(int id) { Instance* i = getInstance(id); return i ? i->ghost : nullptr; }
    void setInstanceStayInPlace(const LLUUID& id, bool enabled);
};
struct LLActorMover {
    std::map<LLGhostAvatar*, LLVector3> driving; // the mover's AUTHORED moving root
    static LLActorMover& instance() { static LLActorMover s; return s; }
    bool applyOverride(LLGhostAvatar* ghost);
};
struct LLGhostAvatar : LLVOAvatar {
    LLUUID mClientHeightKey;
    LLVector3 object;                 // the viewer object position (agent)
    LLDrawable drawable;
    DrawablePtr mDrawable{&drawable};
    LLVector3 pivot;                  // outer-scale foot pivot
    bool dead = false, built = true, region = true, mMarkedForDeath = false;
    bool mDesiredGhostFootValid = false, mGhostFloorPosition = false;
    LLVector3d mDesiredGhostFootGlobal;
    ALReflect::FloorRootHold mReflectFloorRootHold;
    F32 mEntityScale = 1.f, mEntityAnimTimeFactor = 1.f, clientHeight = 0.f;
    std::map<int, LLViewerJointAttachment*> mAttachmentPoints;
    bool mTiltRotationValid = false;
    LLQuaternion objectRotation;
    void setRotation(const LLQuaternion& q, bool) { objectRotation = q; }
    inline static std::set<int> sLiveSources; // clones some other clone uses as its source
    static bool hasLiveSource(const LLUUID& id) { return sLiveSources.count(id) != 0; }
    int mEntityDriveMode = ALGhostStudio::DRIVE_MIRROR;
    int publishes = 0, bounds = 0, forcedBounds = 0, outers = 0;
    // [StayInPlace] the production members
    static std::set<LLGhostAvatar*> sStayInPlaceAvatars;
    bool mStayInPlace = false;
    bool mStayAuthoredValid = false;
    bool mStaySteppedWindow = false;
    bool mStayRootAuthored = false;
    bool mStayDisabling = false;
    bool mStayPassDirtied = false;
    // What the system mesh draws from: the pelvis's CACHED world matrix.
    bool drawnWhereItStands() const { return same(pelvis.cachedWorld, pelvis.getWorldPosition()); }
    LLVector3 mStayPassRoot;
    LLVector3 mStayOffset;
    bool poseStampDriven = false; // True mirror / Reflect: its own stamp moves its attachments every frame
    bool isPoseStampDriven() const { return poseStampDriven; }
    void endStayInPlacePostPass();
    static void steppedVerifyRoot(const LLVOAvatar* avatar, LLVector3& root_agent);
    LLVector3d mStayAuthoredRootGlobal;

    explicit LLGhostAvatar(int id) { pelvis.parent = &root; root.children = {&pelvis}; drawable.objectPosition = &object; ALGhostStudio::instance().instances[id].ghost = this; setClientHeightKey(id); }
    ~LLGhostAvatar() override {
        @DEATH_CLEAR@
        if (auto* inst = ALGhostStudio::instance().getInstance(mClientHeightKey)) if (inst->ghost == this) inst->ghost = nullptr;
    }
    void markForDeath() {
        @DEATH_CLEAR@
        mMarkedForDeath = true;
    }
    LLUUID getID() const { return mClientHeightKey; }
    bool isDead() const { return dead; }
    bool isBuilt() const { return built; }
    const void* getRegion() const { return region ? this : nullptr; }
    const LLVector3& getPositionAgent() const { return object; }
    LLVector3 getRenderPosition() const { return drawable.position; }
    void setPositionAgent(const LLVector3& p) { object = p; }
    void setChanged(int) {}
    F32 getClientHeightZ() const { return clientHeight; }
    void publishGhostTransform() { mRoot->updateWorldMatrixChildren(); ++publishes; }
    void refreshVisualBounds(bool force = false) { ++bounds; forcedBounds += force; }
    void updateEntityOuterTransform() {
        ++outers;
        pivot = mRoot->getWorldPosition();
        pivot.mV[VZ] -= llmax(0.f, pelvisToFoot);
        if (mGhostFloorPosition) pivot = gAgent.getPosAgentFromGlobal(mDesiredGhostFootGlobal);
    }
    // Where a skeleton point is DRAWN (the outer scale pivots on the foot).
    LLVector3 rendered(const LLVector3& p) const { return pivot + (p - pivot) * mEntityScale; }
    LLVector3 hips() const { return rendered(mPelvisp->getWorldPosition()); }

    void setClientHeightKey(const LLUUID& key);
    void ghostSlamPosition(const LLVector3& pos_agent);
    void slamGhostRoot(const LLVector3& object_agent, const LLVector3& root_agent);
    void setGhostPosition(const LLVector3& pos_agent);
    void setGhostRotation(const LLQuaternion& rotation);
    void setEntityScale(F32 scale);
    void setGhostFootPosition(const LLVector3& foot_agent);
    void setGhostFloorPosition(const LLVector3& root_agent, const LLVector3& foot_agent);
    void applyDesiredGhostFootPosition();
    void syncGhostObjectToMovingRoot();
    void idleTail();
    static bool hasStayInPlaceAvatars() { return !sStayInPlaceAvatars.empty(); }
    static void applyStayInPlaceAvatars();
    static void beginStayInPlacePostPass();
    static void beginStayInPlaceStepped(LLVOAvatar* avatar);
    static void presentStayInPlaceStepped(bool recapture_verify);
    void finishStayInPlaceDisable();
    static void endStayInPlaceStepped();
    void setStayInPlace(bool enabled);
    void applyStayInPlace();
    void clearStayInPlace();
    bool getStayInPlaceAuthoredRoot(LLVector3& root_agent) const;
    LLVector3 getStayInPlaceRenderedOffset() const;
    LLVector3 measureStayInPlaceOffset();
    void presentStayInPlace(const LLVector3& offset, const LLVector3& root_base_agent);
    // The Floor Reflect stamp's root write and hold capture (production statement).
    void floorStamp(const LLQuaternion& q, bool floor = true) {
        mRoot->setWorldRotation(q);
        @FLOOR_CAPTURE@
    }
};
// The drawable takes the object position.
void Pipeline::updateMoveNormalAsync(const DrawablePtr& d) { d.p->position = *d.p->objectPosition; }
bool LLActorMover::applyOverride(LLGhostAvatar* ghost) {
    auto found = driving.find(ghost);
    if (found == driving.end()) return false;
    LLVector3 root_world = found->second;
    root_world.mV[VZ] += ghost->mClientHeightCache.effective();
    ghost->getRootJoint()->setWorldPosition(root_world); // the ROOT JOINT only, without the offset
    return true;
}
