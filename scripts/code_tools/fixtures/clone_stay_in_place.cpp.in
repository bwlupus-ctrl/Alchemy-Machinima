struct LLSD { bool value; bool asBoolean() const { return value; } };
struct Check { bool value = true; LLSD getValue() const { return {value}; } };
struct History {
    using Fn = std::function<bool(bool, std::string&)>;
    Fn replay, validate;
    int records = 0;
    void recordCustom(void*, const std::string&, const std::string&, Fn f, bool, Fn v) { ++records; replay = f; validate = v; }
    bool run(bool redo) { std::string why; return validate(redo, why) && replay(redo, why); }
};
struct ALKitShell {
    History h;
    static ALKitShell& shell() { static ALKitShell s; return s; }
    static ALKitShell* find(void*) { return &shell(); }
    History& history() { return h; }
};
struct ALPanelGhostStudio {
