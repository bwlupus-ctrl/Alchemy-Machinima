struct LLGhostAvatar;
struct LLCharacter { F32 timeFactor = 1.f; void setAnimTimeFactor(F32 f) { timeFactor = f; } };
struct LLVOAvatar : LLCharacter {
    virtual ~LLVOAvatar() = default;
    Joint root, pelvis;
    Joint* mRoot = &root;
    Joint* mPelvisp = &pelvis;
    struct { F32 value = 0.f; F32 effective() const { return value; } } mClientHeightCache;
    F32 pelvisToFoot = 1.f;
    int captures = 0;
    LLVector3 capturedRoot;
    virtual bool isGhostAvatar() const { return true; }
    Joint* getRootJoint() { return mRoot; }
    F32 getPelvisToFoot() const { return pelvisToFoot; }
    LLVector3 getBaseRootPosition() const;
    LLVector3 getPlacedRootPosition() const;
    // StepAnimDebugVerify's expected render state (here: where the root renders).
    void captureStepAnimRenderState() { ++captures; capturedRoot = mRoot->getWorldPosition(); }
};
struct LLControlAvatar {
    int captures = 0;
    bool isDead() const { return false; }
    void captureStepAnimRenderState() { ++captures; }
};
