#define llfinite std::isfinite
#define llclamp std::clamp
constexpr float GHOST_SCALE_MIN = 0.1f, GHOST_SCALE_MAX = 10.f;
struct Settings {} gSavedSettings;
bool gStepVerify = false; // StepAnimDebugVerify
template <class T> struct LLCachedControl {
    LLCachedControl(Settings&, const char*) {}
    operator T() const { return gStepVerify; }
