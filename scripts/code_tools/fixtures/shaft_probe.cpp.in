void auctionFrame(LLVOVolume& a,LLVOVolume& b,LLVOVolume* test=nullptr){
 using L=ALShadowSlot::Light<LLUUID>;std::vector<LLVOVolume*> lights{&a,&b};if(test && !test->isDead())lights.push_back(test);
 auto score=[&](LLVOVolume* v){return v==&a?100.:v==&b?90.:1.;};
 std::sort(lights.begin(),lights.end(),[&](auto* x,auto* y){return ALShaftDecision::outranks(true,gPipeline.spotShadowTier(x),false,score(x),gPipeline.spotShadowTier(y),score(y));});
 ++gFrameCount;now+=1./60.;gPipeline.mSpotAuctionFrame=gFrameCount;
 for(int i=0;i<2;++i){auto* v=lights[i];gPipeline.mSpotAuctionMain[i]={v->mDrawable,{v->id,score(v),gPipeline.spotShadowTier(v)}};
 auto* owner=gPipeline.mShadowSpotLight[i].get();gPipeline.mSpotAuctionEligible[i]=owner;
 auto* ov=owner?owner->volume:nullptr;gPipeline.mSpotAuctionOwnerScores[i]=ov?L{ov->id,score(ov),gPipeline.spotShadowTier(ov)}:L{};}
 gPipeline.retainSpotShadowOwners();gPipeline.fade();
}
void seedWorlds(LLVOVolume& a,LLVOVolume& b){a.id=1;b.id=2;gPipeline.createObject(&a);gPipeline.createObject(&b);
 gPipeline.mShadowSpotLight[0]=a.mDrawable;gPipeline.mShadowSpotLight[1]=b.mDrawable;gPipeline.mSpotLightFade[0]=gPipeline.mSpotLightFade[1]=1;}
void cleanup(){LLEventTimer::updateClass();LLEventTimer::updateClass();assert(!ALShaftSelfTest::probe);assert(LLEventTimer::timers.empty());assert(!ALShaftSelfTest::active);}
void verifyRemoved(LLVOVolume* light,bool master){assert(light->dead && !light->enabled);assert(!LLPipeline::shafts.count(light->id));
 assert(!LLPipeline::heroes.count(light->id));assert(!LLPipeline::overrides.count(light->id));assert(!LLPipeline::noShadow.count(light->id));
 assert(gSavedSettings.master==master);assert(gSavedSettings.declined==expectedDeclined);assert(sVCamVolumetricMaster.mDeclined==expectedPolicyDeclined);assert(!gPipeline.mProjVolHistoryValid && !gPipeline.mFroxelHistoryValid);}
int main(){
 {
  bool selected=true;selection.clear();assert(!alSelectedProjector(selected) && !selected);
  LLVOVolume root,child;child.enabled=true;root.children={&child};LLSelectNode node{&root};selection={&node};
  assert(alSelectedProjector(selected)==&child && selected);
  root.enabled=true;assert(alSelectedProjector(selected)==&root);
  root.enabled=false;child.enabled=false;assert(!alSelectedProjector(selected) && selected);
 }

 for(bool enabled:{false,true})for(bool individual:{false,true})for(int bits=0;bits<16;++bits){
  LLVOVolume root,child;root.id=71;child.id=72;child.root=&root;root.children={&child};
  LLPipeline::shafts.clear();LLPipeline::heroes.clear();
  if(bits&1)LLPipeline::shafts.insert(root.id);if(bits&2)LLPipeline::heroes.insert(root.id);
  if(bits&4)LLPipeline::shafts.insert(child.id);if(bits&8)LLPipeline::heroes.insert(child.id);
  // Force the desired click direction via the primary object's effective flag.
  if(enabled){LLPipeline::shafts.erase(root.id);if(individual)LLPipeline::shafts.erase(child.id);}
  else LLPipeline::shafts.insert(root.id);
  LLSelectNode node{individual?&child:&root,individual};selection={&node};handle_object_volumetric_shaft({});
  assert(LLPipeline::isHeroProjector(root.id)==LLPipeline::isVolumetricShaftEnabled(root.id));
  assert(LLPipeline::isHeroProjector(child.id)==LLPipeline::isVolumetricShaftEnabled(child.id));
  if(!enabled){assert(!LLPipeline::isVolumetricShaftEnabled(root.id));assert(!LLPipeline::isVolumetricShaftEnabled(child.id));}
 }
 LLPipeline::shafts.clear();LLPipeline::heroes.clear();
 // Success, black failure, allocation failure, read error, cancellation, panel
 // destruction, teleport, logout, reload/realloc cancellation, nested timer/restart.
 for(int scenario=0;scenario<12;++scenario)for(int framebuffer:{0,4,5})for(bool master:{false,true}){
  gl=GLState{};gl.draw=framebuffer==5?0:framebuffer;if(framebuffer==5)gl.buffers[0]={GL_FRONT};gl.read=9;gl.readBuffer=GL_COLOR_ATTACHMENT0+1;gl.enabled=scenario%2;
  const GLState entry=gl;errors.clear();blackPixels=scenario==1;failAllocation=scenario==2;readError=scenario==3;
  gSavedSettings.master=master;gSavedSettings.declined=expectedDeclined=scenario%2;sVCamVolumetricMaster={};sVCamVolumetricMaster.mDeclined=expectedDeclined;LLApp::exiting=false;gAgent.region=&region;gAgent.teleport=0;
  LLVOVolume a,b;seedWorlds(a,b);const auto natural0=a.mDrawable.get(),natural1=b.mDrawable.get();
  auto owner=std::make_unique<LLView>();ALShaftSelfTest::start(owner.get());auto* light=ALShaftSelfTest::probe->light.get();expectedPolicyDeclined=sVCamVolumetricMaster.mDeclined;
  assert(light->mIsLocalOnly && !light->mbCanSelect && light->enabled);
  assert(light->color==1 && light->intensity==1 && light->radius==12 && light->falloff==1);
  for(int f=0;f<40;++f)auctionFrame(a,b,light);assert(gPipeline.hasProjectorShaftShadowSlot(light));
  gPipeline.mProjVolHistoryValid=gPipeline.mFroxelHistoryValid=true; // ordinary passes wrote test content
  int before=readbacks;
  auxCallback={};
  if(scenario==4)ALShaftSelfTest::cancel("page close");
  if(scenario==5)owner.reset();
  if(scenario==6)gAgent.teleport=LLAgent::TELEPORTING;
  if(scenario==7)gAgent.region=nullptr;
  if(scenario==8)ALShaftSelfTest::cancel("shader reload or target reallocation");
  if(scenario==9)auxCallback=[&]{auto* saved=ALShaftSelfTest::probe;ALShaftSelfTest::cancel("nested event");LLEventTimer::updateClass();assert(ALShaftSelfTest::probe==saved);};
  if(scenario==10)auxCallback=[&]{auto* saved=ALShaftSelfTest::probe;ALShaftSelfTest::start(owner.get());LLEventTimer::updateClass();assert(ALShaftSelfTest::probe==saved);};
  if(scenario==11)LLApp::exiting=true;
  LLRenderTarget march;LLGLSLShader shader;ALShaftSelfTest::submitted(light,shader,march);
  assert(gl==entry);assert(errors.empty());assert(readbacks-before==((scenario==0 || scenario==1 || scenario==3 || scenario==9 || scenario==10)?1:0));
  if(scenario==0)assert(ALShaftSelfTest::result().starts_with("PASS"));
  if(scenario>=1 && scenario<=3)assert(ALShaftSelfTest::result().starts_with("FAIL step 4"));
  if(scenario==10){ // queued restart cleans first, then creates a new generation
   LLEventTimer::updateClass();verifyRemoved(light, true);
   assert(ALShaftSelfTest::probe && ALShaftSelfTest::probe->light.get()!=light);
   ALShaftSelfTest::cancel("stop restarted probe");
  }
  if (ALShaftSelfTest::probe->light) LLPipeline::noShadow.insert(ALShaftSelfTest::probe->light->id); // cleanup removes even this flag
  cleanup();verifyRemoved(light,master);auxCallback={};
  gAgent.region=&region;gAgent.teleport=0;LLApp::exiting=false;
  for(int f=0;f<120;++f)auctionFrame(a,b);
  assert(gPipeline.mShadowSpotLight[0]==natural0 && gPipeline.mShadowSpotLight[1]==natural1);
  assert(gPipeline.mSpotLightFade[0]==1 && gPipeline.mSpotLightFade[1]==1);
 }
 // Actual shared VCam/master ownership, including acquisitions AFTER test start.
 for(bool initial:{false,true})for(bool declined:{false,true})for(int event=0;event<9;++event){
  assert(sVCamVolumetricOverrides.empty());sVCamVolumetricMaster={};sVCamVolumetricMaster.mDeclined=declined;
  gSavedSettings.master=initial;gSavedSettings.declined=expectedDeclined=declined;gSavedSettings.writes=0;
  LLView owner;const LLUUID vcam(900);
  if(event==5)LLPipeline::acquireVCamVolumetrics(vcam,true); // preexisting owner
  ALShaftSelfTest::start(&owner);auto* light=ALShaftSelfTest::probe->light.get();expectedPolicyDeclined=sVCamVolumetricMaster.mDeclined;assert(gSavedSettings.master);
  assert(!sVCamVolumetricOverrides[light->id].mAutoEnabled); // diagnostic stays user-tier
  if(event==1 || event==2)assert(LLPipeline::acquireVCamVolumetrics(vcam,true));
  if(event==2)LLPipeline::releaseVCamVolumetrics(vcam); // VCam leaves first
  if(event==3 || event==4){gSavedSettings.setBOOL("BDMergeProjectorVolumetrics",false);expectedDeclined=expectedPolicyDeclined=true;}
  if(event==4){gSavedSettings.setBOOL("BDMergeProjectorVolumetrics",true);expectedDeclined=expectedPolicyDeclined=false;}
  if(event==6 || event==7){ // production reset releases the diagnostic's keyed hold
   while(!sVCamVolumetricOverrides.empty())LLPipeline::releaseVCamVolumetrics(sVCamVolumetricOverrides.begin()->first);
   sVCamVolumetricMaster={};sVCamVolumetricMasterConnection.disconnect();sVCamVolumetricMasterWriteConnection.disconnect();expectedPolicyDeclined=false;
   if(event==7)LLPipeline::acquireVCamVolumetrics(vcam,true); // new scene owner before old probe retires
  }
  if(event==8){gSavedSettings.setBOOL("BDMergeProjectorVolumetrics",true);expectedDeclined=expectedPolicyDeclined=false;} // same-value Director/preset/user ON
  ALShaftSelfTest::cancel("ownership fixture");cleanup();
  bool expected=event==3?false:(event==1 || event==4 || event==5 || event==7 || event==8)?true:initial;
  verifyRemoved(light,expected);
  if(initial && event==0)assert(gSavedSettings.writes==0); // already on is untouched
  if(event==1 || event==5 || event==7){
   assert(LLPipeline::isVolumetricShaftEnabled(vcam));assert(gSavedSettings.master);
   LLPipeline::releaseVCamVolumetrics(vcam);
   assert(gSavedSettings.master==(initial));
  }
  assert(sVCamVolumetricOverrides.empty());assert(sVCamVolumetricMaster.mUsers==0);
 }
 // Partial creation failure is also timer-owned and leaves no settings/flags.
 gObjectList.fail=true;LLView owner;ALShaftSelfTest::start(&owner);cleanup();
 std::cout<<"PASS probe fixture: 72 outcomes + 36 shared-master ownership cases, BACK/FRONT/FBO draw buffers, requested light values, exact GL restoration, no pending GL error, deferred cancellation/restart, cleanup/history invalidation, natural owners after 120 frames; 64 menu cases\n";
}


