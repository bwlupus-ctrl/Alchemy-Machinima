 unsigned getCurrTexture(){return texture;}eTextureType getCurrType(){return type;}bool hasMipMaps(){return mip;}
 void bindManual(eTextureType t,unsigned v,bool m){type=t;texture=v;mip=m;}void disable(){type=TT_NONE;}
 void enable(eTextureType t){type=t;}void unbind(eTextureType){texture=0;}void setHasMipMaps(bool m){mip=m;}void activate(){} };
