struct Settings{bool master=false,declined=false;int engine=1,writes=0;LLControlVariable control;
 bool getBOOL(const char*){return master;}LLControlVariable* getControl(const char*){return &control;}
 void notify(){if(masterSignal.callback)masterSignal.callback(&control,LLSD(master),LLSD());}
 void setBOOL(const char*,bool v){if(masterWriteSignal.callback)masterWriteSignal.callback(&control);bool changed=master!=v;master=v;declined=!v;++writes;if(changed)notify();}}gSavedSettings;
