using GLint=int; using GLenum=unsigned; using GLboolean=bool; using GLsizei=int; using GLfloat=float;
enum : GLenum { GL_DRAW_FRAMEBUFFER_BINDING=1, GL_READ_FRAMEBUFFER_BINDING,
 GL_READ_BUFFER, GL_MAX_DRAW_BUFFERS, GL_VIEWPORT, GL_SCISSOR_BOX, GL_SCISSOR_TEST,
 GL_COLOR_WRITEMASK, GL_PIXEL_PACK_BUFFER_BINDING, GL_PACK_ALIGNMENT, GL_PACK_ROW_LENGTH,
 GL_PACK_SKIP_ROWS, GL_PACK_SKIP_PIXELS, GL_PACK_SWAP_BYTES, GL_DRAW_FRAMEBUFFER,
 GL_READ_FRAMEBUFFER, GL_FRAMEBUFFER, GL_BACK, GL_PIXEL_PACK_BUFFER, GL_RGBA16F,
 GL_COLOR, GL_RGBA, GL_FLOAT, GL_FRONT, GL_DRAW_BUFFER, GL_DRAW_BUFFER0=100, GL_COLOR_ATTACHMENT0=200 };
constexpr GLenum GL_NO_ERROR=0; constexpr bool GL_FALSE=false;
struct GLState {
 int draw=0, read=0, readBuffer=GL_BACK, viewport[4]={3,7,640,480}, scissor[4]={9,11,31,43};
 int pack=17, alignment=8, row=97, rows=3, pixels=5, swap=1;
 bool enabled=true, mask[4]={true,false,true,false};
 std::map<int,std::array<GLenum,8>> buffers;
 GLState() { buffers[0]={GL_BACK}; buffers[4]={GL_COLOR_ATTACHMENT0+2,0,GL_COLOR_ATTACHMENT0,0}; }
 bool operator==(const GLState& b) const {
  auto relevant=[](const GLState& s) { return std::array<int,20>{s.draw,s.read,s.readBuffer,
   s.viewport[0],s.viewport[1],s.viewport[2],s.viewport[3],s.scissor[0],s.scissor[1],s.scissor[2],s.scissor[3],
   s.pack,s.alignment,s.row,s.rows,s.pixels,s.swap,s.enabled,s.mask[0]+2*s.mask[1]+4*s.mask[2]+8*s.mask[3],0}; };
  return relevant(*this)==relevant(b) && buffers.at(draw)==b.buffers.at(b.draw);
 }
} gl;
std::vector<GLenum> errors; int readbacks=0; bool failAllocation=false, blackPixels=false, readError=false;
void glGetIntegerv(GLenum key, GLint* v) {
 if(key>=GL_DRAW_BUFFER0 && key<GL_DRAW_BUFFER0+8) { *v=gl.buffers[gl.draw][key-GL_DRAW_BUFFER0];return; }
 switch(key) {
 case GL_DRAW_FRAMEBUFFER_BINDING:*v=gl.draw;break; case GL_READ_FRAMEBUFFER_BINDING:*v=gl.read;break;
 case GL_READ_BUFFER:*v=gl.readBuffer;break;case GL_DRAW_BUFFER:*v=gl.buffers[gl.draw][0];break;case GL_MAX_DRAW_BUFFERS:*v=8;break;
 case GL_VIEWPORT:std::copy_n(gl.viewport,4,v);break;case GL_SCISSOR_BOX:std::copy_n(gl.scissor,4,v);break;
 case GL_PIXEL_PACK_BUFFER_BINDING:*v=gl.pack;break;case GL_PACK_ALIGNMENT:*v=gl.alignment;break;
 case GL_PACK_ROW_LENGTH:*v=gl.row;break;case GL_PACK_SKIP_ROWS:*v=gl.rows;break;
 case GL_PACK_SKIP_PIXELS:*v=gl.pixels;break;case GL_PACK_SWAP_BYTES:*v=gl.swap;break;default:assert(false);
 }
}
void glGetBooleanv(GLenum, GLboolean* v) {std::copy_n(gl.mask,4,v);}
bool glIsEnabled(GLenum){return gl.enabled;}
void glBindFramebuffer(GLenum key,int fbo){if(key!=GL_READ_FRAMEBUFFER)gl.draw=fbo;if(key!=GL_DRAW_FRAMEBUFFER)gl.read=fbo;}
void glDrawBuffers(int n,const GLenum* values){
 if(!gl.draw && (n!=1 || (values[0]!=GL_BACK && values[0]!=GL_FRONT))) {errors.push_back(1282);return;}
 if(gl.draw)for(int i=0;i<n;++i)if(values[i]==GL_BACK){errors.push_back(1282);return;}
 gl.buffers[gl.draw]={};std::copy_n(values,n,gl.buffers[gl.draw].begin());
}
void glDrawBuffer(GLenum value){glDrawBuffers(1,&value);}
void glReadBuffer(GLenum value){gl.readBuffer=value;}
void glViewport(int a,int b,int c,int d){int v[]={a,b,c,d};std::copy_n(v,4,gl.viewport);}
void glScissor(int a,int b,int c,int d){int v[]={a,b,c,d};std::copy_n(v,4,gl.scissor);}
void glEnable(GLenum){gl.enabled=true;} void glDisable(GLenum){gl.enabled=false;}
void glBindBuffer(GLenum,int value){gl.pack=value;}
void glPixelStorei(GLenum key,int value){switch(key){case GL_PACK_ALIGNMENT:gl.alignment=value;break;
 case GL_PACK_ROW_LENGTH:gl.row=value;break;case GL_PACK_SKIP_ROWS:gl.rows=value;break;
 case GL_PACK_SKIP_PIXELS:gl.pixels=value;break;case GL_PACK_SWAP_BYTES:gl.swap=value;break;default:assert(false);}}
GLenum glGetError(){if(errors.empty())return 0;auto e=errors.back();errors.pop_back();return e;}
void glClearBufferfv(GLenum,int,const float*){}
void glReadPixels(int,int,int w,int h,GLenum,GLenum,float* out){++readbacks;
 assert(gl.pack==0 && gl.alignment==1 && gl.row==0 && gl.rows==0 && gl.pixels==0 && gl.swap==0);
 std::fill_n(out,w*h*4,blackPixels?0.f:.1f);if(readError)errors.push_back(1282);}
