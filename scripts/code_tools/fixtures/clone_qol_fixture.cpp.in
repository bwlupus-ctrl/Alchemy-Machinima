using F32=float;using F64=double;using S32=int;using U8=unsigned char;using U32=unsigned;using U64=unsigned long long;
struct LLUUID {int id=0;std::array<U8,16> mData{};LLUUID(int n=0):id(n){mData[0]=U8(n);mData[1]=U8(n>>8);}
 std::string asString()const{return std::to_string(id);}
 bool isNull()const{return !id;}bool notNull()const{return id;}void setNull(){*this={};}
 bool operator==(LLUUID b)const{return id==b.id;}bool operator!=(LLUUID b)const{return id!=b.id;}bool operator<(LLUUID b)const{return id<b.id;}
 static const LLUUID null;};const LLUUID LLUUID::null{};LLUUID gAgentID{900};
template<class T>T llclamp(T x,T lo,T hi){return std::clamp(x,lo,hi);}template<class T>T llmin(T a,T b){return std::min(a,b);}template<class T>T llmax(T a,T b){return std::max(a,b);}
enum{VX,VY,VZ};inline bool llfinite(float v){return std::isfinite(v);}
struct LLVector3 {float value=0;float mV[3]{};LLVector3()=default;LLVector3(float x):value(x){}LLVector3(float x,float y,float z):value(x),mV{x,y,z}{}void set(float x,float y,float z){mV[0]=x;mV[1]=y;mV[2]=z;}bool isFinite()const{return true;}
 LLVector3 operator+(LLVector3 b)const{return {mV[0]+b.mV[0],mV[1]+b.mV[1],mV[2]+b.mV[2]};}
 LLVector3 operator-(LLVector3 b)const{return {mV[0]-b.mV[0],mV[1]-b.mV[1],mV[2]-b.mV[2]};}
 LLVector3 operator*(float b)const{return {mV[0]*b,mV[1]*b,mV[2]*b};}
 LLVector3 operator*(LLVector3 q)const{float c=cos(q.value),s=sin(q.value);return {mV[0]*c-mV[1]*s,mV[0]*s+mV[1]*c,mV[2]};}
 LLVector3& operator+=(LLVector3 b){return *this=*this+b;}
 float magVecSquared()const{return mV[0]*mV[0]+mV[1]*mV[1]+mV[2]*mV[2];}float length()const{return std::sqrt(magVecSquared());}static const LLVector3 zero;};const LLVector3 LLVector3::zero{};
using LLQuaternion=LLVector3;struct LLMatrix4{float value=0;};
LLVector3 lerp(LLVector3 a,LLVector3 b,float t){return {a.value+(b.value-a.value)*t};}LLQuaternion slerp(float t,LLQuaternion a,LLQuaternion b){return lerp(a,b,t);}
