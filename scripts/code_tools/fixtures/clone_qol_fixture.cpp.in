 struct MatrixPaletteCache{std::vector<float>mGLMp{3.f};}palette;const MatrixPaletteCache& updateSkinInfoMatrixPalette(LLMeshSkinInfo*){return palette;}float getPelvisToFoot(){return 1;}Joint* getJoint(const char*){return nullptr;}
 LLVector3 ext[2]{{-1,-1,0},{1,1,2}};const LLVector3* getLastAnimExtents(){return ext;}bool isBuilt(){return true;}bool isFullyLoaded(){return true;}Joint* getRootJoint(){return &root;}LLQuaternion getRotation(){return {};}
 const std::vector<Joint*>& getSkeleton(){return joints;}LLVisualParam* getVisualParam(int n){return &params[n];}void setVisualParamWeight(LLVisualParam* p,float w){p->w=w;}void updateVisualParams(){}void dirtyMesh(){}};
