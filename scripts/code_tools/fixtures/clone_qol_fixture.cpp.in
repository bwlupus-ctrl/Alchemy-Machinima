 static std::set<const LLGhostAvatar*>sOffsetHotGazes;std::map<double,std::map<size_t,LLQuaternion>>mOffsetHotRotations;double mOffsetLastHotTime=0;int mOffsetHotSkeletonSerial=-1;int getSkeletonSerialNum(){return 1;}
