struct ALGhostStudio{
 enum{BACKING_OVERLAY,BACKING_ENTITY_CLONE};enum{DRIVE_MIRROR,DRIVE_TRUE_MIRROR,DRIVE_REFLECT,DRIVE_DIRECTED,DRIVE_FROZEN};enum{POSE_LIVE,POSE_FROZEN};enum{STATE_READY,STATE_TEARING_DOWN};
 using palette_map_t=std::map<std::pair<LLUUID,U64>,std::vector<float>>;
 struct Instance{
 LLUUID mId,mEntityId,mGroupId,mCrowdId,mSource,mAppearanceSource,mAnimationSource,mOverlayAvatar,mAppearanceSwapTintSeed;
 bool mDeleting=false,mEnabled=true,mSoloVisible=true,mHasAnimationSource=false,mSourceRemoved=false,mAppearanceSourceRemoved=false,mAnimationSourceRemoved=false,mCrowdMixed=false;
 int mKind=BACKING_OVERLAY,mState=STATE_READY,mDriveMode=DRIVE_MIRROR,mPose=POSE_LIVE,mPendingFreezeFrames=0,mCrowdRow=0,mStyle=0,mCrowdSingleStyle=0;U32 mCrowdSeed=0;
 float mPoseRateHz=0,mStartOffset=0,mFadeAlpha=1,mScale=2,mNextPoseRefresh=0;double mCrowdLocalX=0,mCrowdLocalY=0;std::string mSourceLabel;
 float mFrozenBoundsRadius=2,mCadenceBoundsRadius=2;
 LLVector3 mFrozenBounds[2],mCadenceBounds[2];LLQuaternion mCadenceRotation;std::map<LLUUID,LLMatrix4>mCadenceAttachMats;palette_map_t mFrozenPalettes,mCadencePalettes;LLVector3 mFrozenFootAgent,mFrozenHeadAgent,mCadenceFootAgent,mCadenceHeadAgent;bool mFrozenHeadValid=false,mCadenceHeadValid=false;
 std::vector<LLQuaternion>mFrozenJointRotations;std::vector<LLVector3>mFrozenJointPositions;std::map<LLUUID,LLMatrix4>mFrozenAttachMats;LLQuaternion mRotation;
 std::shared_ptr<const Instance>mOffsetPose;
 };
 std::vector<Instance>mInstances;std::set<LLUUID>mOffsetInstances;std::map<LLUUID,LLUUID>mPrivateOverlayRuntimes;std::map<LLUUID,size_t>mOverlayHelperRefs;std::set<LLUUID>mPrivateOverlayActors;void rememberOverlayDomain(LLViewerObject*);
 struct History{double mNextCapture=0,mPausedAt=0;bool mPaused=false;std::deque<std::pair<double,std::shared_ptr<const Instance>>>mFrames;};std::map<LLUUID,History>mOverlayHistory;
 struct Fade{ALCloneQol::Fade mFade;};std::map<LLUUID,Fade>mFades;LLUUID mFadeRegion;U64 mInstanceRevision=0;
 LLUUID incompleteAttachments;std::string mSwapStatus;int created=0,transactions=0;float inputPose=0;bool mShowAll=true,mSolo=false;
 static ALGhostStudio* current;static ALGhostStudio& instance(){return *current;}
 Instance* getInstance(LLUUID id)const{for(auto& i:const_cast<ALGhostStudio*>(this)->mInstances)if(i.mId==id)return &i;return nullptr;}
 const Instance* findInstanceByRuntime(LLUUID id)const{for(auto& i:mInstances)if(i.mEntityId==id&&id.notNull())return &i;return nullptr;}
 LLGhostAvatar* resolveEntityClone(LLUUID id)const{auto* i=getInstance(id);if(!i||i->mKind!=BACKING_ENTITY_CLONE)return nullptr;auto* o=gObjectList.findObject(i->mEntityId);return o&&!o->isDead()?dynamic_cast<LLGhostAvatar*>(o):nullptr;}
 std::vector<LLUUID> groupMembers(LLUUID id){return getInstance(id)?std::vector<LLUUID>{id}:std::vector<LLUUID>{};}
 struct Member{LLUUID mInstanceId;};struct Group{std::vector<Member>mMembers;};const Group* groupForMember(LLUUID)const{return nullptr;}
 bool isVisible(const Instance&i)const{return ALCloneQol::visible(mShowAll,i.mEnabled,mSolo,i.mSoloVisible);}
 static bool isOverlayStyle(int look){return look>=0&&look<100;}
 static LLVOAvatar* resolveSourceAvatar(const Instance&i){return i.mSourceRemoved?nullptr:LLDirectorCast::instance().resolve(i.mSource);}
 static LLVOAvatar* resolveOverlayAvatar(const Instance&);
 LLGhostAvatar* createEntityRuntime(Instance&i,S32&){if(!LLDirectorCast::instance().resolve(i.mAppearanceSource)||i.mAppearanceSource==incompleteAttachments)return nullptr;auto* g=new LLGhostAvatar;g->id=LLUUID(1000+(++created));gObjectList.objects[g->id]=g;return g;}
 // External runtime setup boundary; independently checked for resolver wiring.
 void applyEntityRuntimeState(Instance&i,LLGhostAvatar*g){g->scale=i.mScale;g->offset=i.mStartOffset;g->mode=i.mDriveMode;g->animation=i.mAnimationSource;}
 void onEntityRuntimeReplaced(Instance&i,LLUUID id,LLGhostAvatar*){i.mEntityId=id;++transactions;}
 bool captureOverlayPose(Instance&i){i.mFrozenPalettes[{{77},1}]={inputPose};i.mFrozenJointRotations={{inputPose}};i.mFrozenJointPositions={{inputPose}};i.mPose=POSE_FROZEN;return true;}
 bool refreshPoseCadence(const LLUUID&,F64);void getWantedSources(uuid_vec_t&)const;
 void unfreezeInstance(const LLUUID&);bool freezeInstance(const LLUUID&);bool swapSource(const LLUUID&,const LLUUID&,const std::string&);void beginAppearance(const LLUUID&,bool=true);
 void invalidateOverlayPose(Instance&);void releaseOverlayHelper(const LLUUID&);void releaseOverlayReference(const LLUUID&);bool acquireOverlayHelper(const LLUUID&);LLUUID reserveOverlayHelper(const Instance&);
 LLUUID actorOwner(const LLUUID&)const;bool isPrivateOverlayRuntime(const LLUUID&)const;bool isDeleting(const LLUUID&)const;
 bool setStartOffset(const LLUUID&,float);void syncOffsets(const std::vector<LLUUID>&);void applyCrowdVariation(const LLUUID&,U32,bool=true,bool=true,bool=false);void refreshOverlayOffset(Instance&,double);
};ALGhostStudio* ALGhostStudio::current=nullptr;
U32 LLGhostAvatar::sRenderHiddenReasons=0;
@PRODUCTION@
int main(){
 ALGhostStudio studio;ALGhostStudio::current=&studio;auto& cast=LLDirectorCast::instance();
 // Exercise the production palette selector, including ordinary draw fallback.
 LLVOAvatar draw;draw.id={600};LLMeshSkinInfo mesh;LLDrawInfo info{{&draw},{&mesh}};
 std::map<std::pair<LLUUID,U64>,std::vector<float>> palettes{{{draw.id,mesh.mHash},std::vector<float>(12,42.f)}};
 LLActorMover::GhostProxy heldProxy;heldProxy.mHeldPalettes=&palettes;sDrawingGhostProxy=&heldProxy;
 assert(uploadGhostPalette(info)&&shader.uploaded==std::vector<float>(12,42.f)&&LLRenderPass::liveUploads==0);
 sDrawingGhostProxy=nullptr;assert(uploadGhostPalette(info)&&LLRenderPass::liveUploads==1);
 // With no hidden clone/helper, even populated owner IDs must cost zero lookups.
 LLVOAvatar ordinary;gObjectList.objects[{501}]=&ordinary;gObjectList.objects[{502}]=&ordinary;
 gObjectList.lookups=0;for(int n=0;n<1000;++n) assert(!LLGhostAvatar::isRenderHidden(&ordinary,{501},{502}));
 assert(gObjectList.lookups==0);
 LLGhostAvatar policy;policy.setRenderOnlyHidden(true);assert(LLGhostAvatar::hasRenderHiddenPolicy()&&LLGhostAvatar::isRenderHidden(&policy));
 policy.setRenderOnlyHidden(true);policy.setRenderOnlyHidden(false);assert(!LLGhostAvatar::hasRenderHiddenPolicy());

 // Execute production bounds transform, using capture-frame geometry and a live source elsewhere.
 LLActorMover::GhostProxy proxy;LLVOAvatar moving;moving.ext[0]={9,-1,0};moving.ext[1]={11,1,2};
 LLVector3 held[2]={{-1,-1,0},{1,1,2}};proxy.mHeldBounds=held;
 for(float scale:{.5f,1.f,2.5f}) for(float angle:{0.f,.7f,1.57f,3.14f})
 {
   proxy.mScale=scale;proxy.mRotation={angle};proxy.mFootAgent={99,0,0};
   LLActorMover::instance().computeProxyBounds(proxy,&moving);
   // Every corner of the drawn held mesh is inside its admitted AABB.
   for(int c=0;c<8;++c){LLVector3 v={(c&1)?1.f:-1.f,(c&2)?1.f:-1.f,(c&4)?2.f:0.f};
    v=(v*scale)*proxy.mRotation+proxy.mFootAgent;
    for(int axis=0;axis<3;++axis) assert(std::abs(v.mV[axis]-proxy.mWorldBoundsCenter.mV[axis])<=proxy.mWorldBoundsHalfExtent.mV[axis]+.0001f);
   }
   assert(proxy.mWorldBoundsCenter.mV[0]-proxy.mWorldBoundsHalfExtent.mV[0]<=100.f); // frustum edge admission
 }

 LLVOAvatar a,b;a.id={70};b.id={80};gObjectList.objects[a.id]=&a;gObjectList.objects[b.id]=&b;
 ALGhostStudio::Instance x;x.mId={1};x.mSource=a.id;x.mCrowdId={44};x.mCrowdLocalX=0;
 auto y=x;y.mId={2};y.mCrowdLocalX=-5;y.mCrowdRow=1;studio.mInstances={x,y};
 gSavedSettings.ints={{"GhostStudioStartMode",2},{"GhostStudioLooksMode",1},{"GhostStudioMixLook1",7},{"GhostStudioMixLook2",8},{"GhostStudioMixLook3",-1},{"GhostStudioMixLook4",-1},{"GhostStudioMixLook5",-1},{"GhostStudioMixLook6",-1},{"GhostStudioLookSpread",1}};
 gSavedSettings.floats["GhostStudioStartSpread"]=2;
 studio.applyCrowdVariation({1},123);assert(studio.mInstances[0].mStartOffset==0&&studio.mInstances[1].mStartOffset==2);assert(studio.mInstances[0].mStyle==7&&studio.mInstances[1].mStyle==8);
 studio.setStartOffset({1},.75f);studio.applyCrowdVariation({1},123,false,true);assert(studio.mInstances[0].mStartOffset==.75f);
 studio.syncOffsets({{1},{2}});assert(gSavedSettings.getS32("GhostStudioStartMode")==0&&studio.mOffsetInstances.empty());
 studio.setStartOffset({1},.75f);studio.applyCrowdVariation({1},123,true,true,true);assert(studio.mInstances[0].mStartOffset==.75f);
 auto& i=studio.mInstances[0];studio.inputPose=10;studio.refreshOverlayOffset(i,10);studio.inputPose=20;studio.refreshOverlayOffset(i,11);studio.inputPose=30;studio.refreshOverlayOffset(i,12);
 assert(i.mOffsetPose&&i.mOffsetPose->mFrozenPalettes.begin()->second[0]==30); // 12-.75 selects first sample at/after 11.25
 studio.setStartOffset({1},2);studio.refreshOverlayOffset(i,12);assert(i.mOffsetPose->mFrozenPalettes.begin()->second[0]==10);
 LLTimer::now=12;assert(studio.freezeInstance({1})&&i.mFrozenPalettes.begin()->second[0]==10);
 // Pause longer than the two-second window; resume keeps delayed pose and cadence clock.
 i.mNextPoseRefresh=12.2;auto deadline=studio.mOverlayHistory[{1}].mNextCapture;
 LLTimer::now=22;studio.unfreezeInstance({1});assert(i.mOffsetPose&&i.mOffsetPose->mFrozenPalettes.begin()->second[0]==10);
 assert(studio.mOverlayHistory[{1}].mFrames.front().first==20&&studio.mOverlayHistory[{1}].mNextCapture==deadline+10);
 assert(std::abs(i.mNextPoseRefresh-22.2)<.00001);
 studio.inputPose=900;studio.refreshOverlayOffset(i,22);assert(i.mOffsetPose->mFrozenPalettes.begin()->second[0]==10);
 assert(studio.freezeInstance({1})); // retain the existing frozen-swap coverage below

 // Swapped copies share a harvest-only helper, and failed copies are registered.
 i.mCadencePalettes[{{70},2}]={99};i.mCadenceFootAgent.value=99;i.mNextPoseRefresh=100;
 assert(studio.swapSource({1},b.id,"B"));assert(i.mCadencePalettes.empty()&&i.mNextPoseRefresh==0);auto helper=i.mOverlayAvatar;assert(studio.freezeInstance({1})&&!i.mFrozenPalettes.empty());assert(helper.notNull()&&studio.created==1&&i.mSource==a.id&&i.mAnimationSource==a.id);
 assert(studio.swapSource({2},b.id,"B")&&studio.created==1&&studio.mInstances[1].mOverlayAvatar==helper&&studio.mOverlayHelperRefs[helper]==2);
 auto* body=dynamic_cast<LLGhostAvatar*>(gObjectList.findObject(helper));assert(body&&body->mRenderOnlyHidden&&body->scale==1&&body->offset==0);
 // Loaded replacement with incomplete attachment copies must keep live prior helper and presentation.
 LLVOAvatar incomplete;incomplete.id={81};gObjectList.objects[incomplete.id]=&incomplete;studio.incompleteAttachments=incomplete.id;
 auto prior=i;auto refs=studio.mOverlayHelperRefs;auto revision=studio.mInstanceRevision;
 assert(!studio.swapSource({1},incomplete.id,"incomplete"));
