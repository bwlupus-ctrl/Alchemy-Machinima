{
  "name": "vcam_tab",
  "label": "VCam",
  "sum": "Extra virtual cameras fed from captures or camera feeds, managed in Virtual Cam Manager.",
  "pre": "none",
  "master": {"w": "vc_enable", "l": "Virtual Cam", "s": "PrismLensEnabled"},
  "cards": [
    {"id": "vcam_master", "t": "Virtual Cam", "k": "rows", "badge": "ALL CAMERAS", "rows": [
      {"l": "Status", "k": "readout", "w": "vc_summary", "h": "VCam camera, face and visible-face counts.", "bind": "code"},
      {"l": "Performance", "k": "readout", "w": "vc_perf", "h": "Presented FPS, render p95, scale, admitted attempts and Adaptive state.", "bind": "code"},
      {"l": "Action", "k": "readout", "w": "vc_status", "h": "The latest action result or failure. Warnings remain visible long enough to read.", "bind": "code", "show_if": "status"},
      {"l": "Open full manager", "k": "button", "w": "vc_open_manager", "h": "Open the full Virtual Cam Manager.", "btn": "Open full manager", "bind": "code"}
    ]},
    {"id": "monitors", "t": "Monitors", "k": "rows", "badge": "ALL CAMERAS", "rows": [
      {"l": "", "k": "custom", "w": "vc_monitor_header", "h": "Large shows four cameras with pages; Compact shows eight. Toggle previews and choose their refresh speed here.", "custom_tag": "vcam_monitor_header", "bind": "code", "row_height": 60},
      {"l": "Pages", "k": "custom", "w": "vc_monitor_pager", "h": "Show cameras 1-4 or 5-8 in Large mode.", "custom_tag": "vcam_monitor_pager", "bind": "code", "show_if": "large_and_more_than_four"},
      {"l": "", "k": "custom", "w": "vc_monitor_strip", "h": "What each camera sends out. Drag anywhere on a monitor tile onto a modifiable object face to show that camera there.", "custom_tag": "vcam_monitor_strip", "bind": "code", "row_height": 170},
      {"l": "Monitor tile", "k": "custom", "w": "vc_monitor_tile_manifest", "h": "Eight fixed atlas-backed PREVIEW, LIVE, PAUSED, THROTTLED, OFFLINE, or WARMING tile slots with timestamp, camera, Shows, status, drag handle, and menu.", "custom_tag": "vcam_monitor_tile", "bind": "code", "show_if": "never"},
      {"l": "", "k": "readout", "row_height": 60, "w": "vc_monitor_footer", "h": "How monitor previews reuse retained pictures and consume the shared attempt budget.", "bind": "code"}
    ]},
    {"id": "camera_selector", "t": "Settings for", "k": "inline", "rows": [
      {"l": "", "k": "custom", "w": "vc_camera_selector", "h": "Choose the camera edited below, add a camera, or remove the selected capture in one row. Monitor clicks never change this selection.", "custom_tag": "vcam_camera_selector", "selector_actions": [{"value": "media", "label": "Media from a prim face (video)", "index": 5}], "kw": "Add media video URL local file prim face VLC", "bind": "code", "fill_width": true, "row_height": 24}
    ]},
    {"id": "media_source", "t": "Source", "k": "rows", "badge": "CAM n", "rows": [
      {"l": "Name", "k": "text", "w": "vc_media_name", "h": "A short camera name saved with the Prism scene. Empty restores the default name.", "bind": "code", "search_alias": "vc_camera_name"},
      {"l": "Source", "k": "segmented", "w": "vc_media_kind", "h": "Video URL plays a private video file. Prim face borrows existing prim video.", "bind": "code", "it": ["Video URL", "Prim face"], "iv": ["url", "face"], "kw": "media video URL local file prim face VLC"},
      {"l": "Video", "k": "text", "w": "vc_media_video", "hint": "https://…/clip.mp4  or  D:\\Footage\\clip.mov", "h": "An http(s) link or absolute local/file: path. Enter or Load checks and plays the link; clicking away only saves it.", "bind": "code", "show_if": "media_url", "kw": "media video URL local file path Enter Load play"},
      {"l": "", "k": "custom", "w": "vc_media_file_actions", "h": "Choose a local video or check and play the typed link.", "bind": "code", "show_if": "media_url", "kw": "media Browse Load Enter play local file video picker", "custom_tag": "panel", "actions": [{"w": "vc_media_browse", "l": "Browse…", "h": "Pick and check a local video file asynchronously; cancellation leaves this slot unchanged.", "width": 92}, {"w": "vc_media_load", "l": "Load", "h": "Check and play this link (Enter does the same)", "width": 72}]},
      {"l": "", "k": "custom", "w": "vc_media_transport", "h": "Private video playback: Play, Pause or Stop. Stop cancels downloads.", "bind": "code", "custom_tag": "panel", "actions": [{"w": "vc_media_play", "l": "Play", "h": "Start or resume this video after validation.", "width": 72}, {"w": "vc_media_pause", "l": "Pause", "h": "Pause this video, including while downloading.", "width": 72}, {"w": "vc_media_stop", "l": "Stop", "h": "Stop the video and cancel pending work.", "width": 72}], "show_if": "media_url", "kw": "media video Play Pause Stop VLC"},
      {"l": "Loop", "k": "toggle", "w": "vc_media_loop", "h": "Restart the video when it ends.", "bind": "code", "show_if": "media_url", "kw": "media video Loop"},
      {"l": "Volume", "k": "slider", "w": "vc_media_volume", "volume_text": true, "h": "Private volume; starts muted. Global media volume also applies.", "bind": "code", "mn": 0, "mx": 1, "st": 0.05, "dc": 2, "show_if": "media_url", "kw": "media video Volume muted audio"},
      {"l": "Prim face", "k": "readout", "w": "vc_media_face", "h": "The authored prim media face; its own player keeps running.", "bind": "code", "show_if": "media_face", "kw": "media prim face source"},
      {"l": "", "k": "custom", "w": "vc_media_face_actions", "h": "Pick, replace or locate the source face. Escape cancels the pick.", "bind": "code", "custom_tag": "panel", "actions": [{"w": "vc_pick_media_face", "l": "Pick prim face", "h": "Click a prim video face. Escape cancels.", "width": 112}, {"w": "vc_media_locate", "l": "Locate face", "h": "Move your camera to the source prim face.", "width": 96}], "show_if": "media_face", "kw": "media prim face Pick replace Locate"},
      {"l": "Status", "k": "readout", "w": "vc_media_status", "h": "Playback, download, admission, or source-binding status.", "bind": "code", "wrap": true, "kw": "media video download status VLC"},
      {"l": "Source aspect", "k": "combo", "w": "vc_source_aspect", "h": "Auto uses reported video geometry, falling back to 16:9. Overrides never resize the player.", "bind": "code", "it": ["Auto", "16:9", "4:3", "2.39"], "iv": [0, 1, 2, 3], "kw": "media video source aspect Auto"},
      {"l": "", "k": "button", "w": "vc_media_running", "h": "Hold this image; video and audio keep playing.", "bind": "code", "btn": "Freeze", "kw": "media video Freeze Resume image"},
      {"l": "", "k": "readout", "w": "vc_media_note", "h": "Only you see and hear this. Volume starts muted. Local files work only on this PC; scenes never auto-play.", "bind": "code", "wrap": true, "kw": "media private video local file"},
      {"l": "Media cache", "k": "readout", "w": "vc_media_cache_status", "h": "Cache usage/limit is available only to the cache lock owner.", "bind": "code", "wrap": true, "kw": "media video cache usage limit download", "show_if": "media_url"},
      {"l": "", "k": "button", "w": "vc_media_cache_clear", "h": "Clear stops cache-backed slots and cancels downloads. Local files and scene cues are preserved.", "bind": "code", "btn": "Clear video cache", "kw": "media video cache Clear download", "show_if": "media_url"},
      {"l": "Keep downloads between sessions", "k": "toggle", "w": "vc_media_cache_keep", "fill_width": true, "s": "VCamMediaCacheKeepBetweenSessions", "h": "Off: downloaded videos are deleted when you quit. On: kept up to the cache limit for faster replays. Local files are never copied.", "kw": "media video cache downloads keep sessions lifetime quit purge", "show_if": "media_url"}
    ]},
    {"id": "source", "t": "Source", "k": "rows", "badge": "CAM n", "rows": [
      {"l": "Name", "k": "text", "w": "vc_camera_name", "h": "A short camera name saved with the Prism scene. Empty restores the default name.", "bind": "code"},
      {"l": "Source", "k": "segmented", "w": "vc_source_type", "h": "Choose Object, Virtual, Skeleton POV, or the local 512 px test pattern. Surface Lens captures keep their fixed source.", "it": ["Object", "Virtual", "Skeleton POV", "Test pattern"], "iv": [0,1,2,3], "bind": "code"},
      {"l": "Bound to", "k": "readout", "w": "vc_source_bound", "h": "The object, stored transform, or skeleton driver used by this camera.", "bind": "code"},
      {"l": "Object note", "k": "readout", "w": "vc_source_note_object", "h": "Object source note: Object cameras follow the selected camera object.", "bind": "code", "show_if": "object"},
      {"l": "Virtual note", "k": "readout", "w": "vc_source_note_virtual", "h": "Virtual source note: Virtual cameras store a position and rotation and need no prim.", "bind": "code", "show_if": "virtual"},
      {"l": "Skeleton note", "k": "readout", "w": "vc_source_note_skeleton", "h": "Skeleton source note: Skeleton POV follows a cast subject or you.", "bind": "code", "show_if": "skeleton"},
      {"l": "Type", "k": "readout", "w": "vc_lens_type", "h": "A Surface Lens looks through one aperture face. The type is fixed; add a camera for a different source.", "bind": "code", "show_if": "surface_lens"},
      {"l": "Aperture", "k": "readout", "w": "vc_lens_aperture", "h": "The world face this lens looks through.", "bind": "code", "show_if": "surface_lens"},
      {"l": "Locate aperture", "k": "button", "w": "vc_lens_locate", "h": "Flash the aperture face in-world.", "btn": "Locate aperture", "bind": "code", "show_if": "surface_lens"},
      {"l": "Surface Lens note", "k": "readout", "w": "vc_lens_note", "h": "A Lens owns exactly one aperture face. Its mapping is fixed; remove the capture to remove that face.", "bind": "code", "show_if": "surface_lens"}
    ]},
    {"id": "placement", "t": "Placement", "k": "rows", "badge": "CAM n", "rows": [
      {"l": "Set camera", "k": "button", "w": "vc_set_selected_camera", "h": "Set selected camera: Bind this camera to the object you have selected in-world.", "btn": "Set selected camera", "bind": "code", "show_if": "object"},
      {"l": "Place eye in front", "k": "readout", "w": "vc_place_eye_front", "h": "Info only: no existing model command safely derives an eye offset from arbitrary selected-object geometry.", "bind": "code", "show_if": "object"},
      {"l": "Marker style", "k": "readout", "w": "vc_placement_note", "h": "Marker convention: Local -Z looks forward and local +Y is up. Use a transparent marker or move the eye beyond visible housing.", "bind": "code", "show_if": "object"},
      {"l": "Eye offset X", "k": "slider", "w": "vc_eye_x", "h": "Local eye offset in metres (object cameras only).", "mn": -64, "mx": 64, "st": 0.01, "dc": 3, "unit": "m", "bind": "code", "a": 1, "show_if": "object"},
      {"l": "Eye offset Y", "k": "slider", "w": "vc_eye_y", "h": "Local eye offset in metres, +Y is up.", "mn": -64, "mx": 64, "st": 0.01, "dc": 3, "unit": "m", "bind": "code", "a": 1, "show_if": "object"},
      {"l": "Eye offset Z", "k": "slider", "w": "vc_eye_z", "h": "Local eye offset in metres, -Z looks forward.", "mn": -64, "mx": 64, "st": 0.01, "dc": 3, "unit": "m", "bind": "code", "a": 1, "show_if": "object"},
      {"l": "Snap to my view", "k": "button", "w": "vc_snap_view", "h": "Store your current camera position and orientation as this virtual camera's transform.", "btn": "Snap to my view", "bind": "code", "show_if": "virtual"},
      {"l": "Placement note", "k": "readout", "w": "vc_virtual_note", "h": "Virtual placement note: Fly your view to the shot, then Snap. The eye offset does not apply to virtual cameras.", "bind": "code", "show_if": "virtual"}
    ]},
    {"id": "skeleton", "t": "Skeleton POV", "k": "rows", "badge": "CAM n", "show_if": "virtual", "rows": [
      {"l": "Bone POV", "k": "toggle", "w": "vc_bone_enabled", "h": "Attach this virtual camera to a skeleton joint.", "bind": "code"},
      {"l": "Anchor subject", "k": "combo", "w": "vc_bone_anchor", "h": "Whose skeleton the camera follows.", "it": ["Me", "Subject A", "Subject B", "Subject C", "Subject D"], "iv": [0,1,2,3,4], "bind": "code"},
      {"l": "POV joint", "k": "combo", "w": "vc_bone_joint", "h": "Eyeline or any joint from the anchor skeleton. Off-spine joints default to Stabilized aim.", "it": ["Eyeline", "mHead", "mNeck", "mChest", "mPelvis", "mShoulderRight", "mElbowRight", "mWristRight", "mWristLeft", "mFootRight"], "iv": ["", "mHead", "mNeck", "mChest", "mPelvis", "mShoulderRight", "mElbowRight", "mWristRight", "mWristLeft", "mFootRight"], "bind": "code"},
      {"l": "Aim mode", "k": "combo", "w": "vc_bone_aim", "h": "Full-follow drives orientation; Stabilized drives position only and leaves your aim untouched.", "it": ["Full-follow", "Stabilized"], "iv": [0,1], "bind": "code"},
      {"l": "Roll mode", "k": "combo", "w": "vc_bone_roll", "h": "Horizon-lock keeps the horizon level; Inherit roll copies the joint roll.", "it": ["Horizon-lock", "Inherit roll"], "iv": [0,1], "bind": "code"},
      {"l": "Smooth", "k": "slider", "w": "vc_bone_smooth", "h": "Exponential position and orientation damping; zero snaps.", "mn": 0, "mx": 10, "st": 0.05, "dc": 2, "unit": "s", "bind": "code"},
      {"l": "Status", "k": "readout", "w": "vc_bone_status", "h": "Live attachment state.", "bind": "code"},
      {"l": "Offset X", "k": "slider", "w": "vc_bone_x", "h": "Offset in metres, joint-local X.", "mn": -64, "mx": 64, "st": 0.01, "dc": 3, "unit": "m", "bind": "code", "a": 1},
      {"l": "Offset Y", "k": "slider", "w": "vc_bone_y", "h": "Offset in metres, joint-local Y.", "mn": -64, "mx": 64, "st": 0.01, "dc": 3, "unit": "m", "bind": "code", "a": 1},
      {"l": "Offset Z", "k": "slider", "w": "vc_bone_z", "h": "Offset in metres, joint-local Z.", "mn": -64, "mx": 64, "st": 0.01, "dc": 3, "unit": "m", "bind": "code", "a": 1},
      {"l": "Trim pitch", "k": "slider", "w": "vc_bone_pitch", "h": "Aim trim, pitch, in degrees.", "mn": -180, "mx": 180, "st": 0.5, "dc": 1, "unit": "deg", "bind": "code", "a": 1},
      {"l": "Trim yaw", "k": "slider", "w": "vc_bone_yaw", "h": "Aim trim, yaw, in degrees.", "mn": -180, "mx": 180, "st": 0.5, "dc": 1, "unit": "deg", "bind": "code", "a": 1},
      {"l": "Clone-scale aware", "k": "toggle", "w": "vc_bone_scale", "h": "Scale the joint point about the avatar foot and the local offset by the clone's uniform scale.", "bind": "code", "a": 1},
      {"l": "Reset attach", "k": "button", "w": "vc_bone_reset", "h": "Restore every skeleton attachment option to its default.", "btn": "Reset attach", "bind": "code", "a": 1}
    ]},
    {"id": "optics", "t": "Optics", "k": "rows", "badge": "CAM n", "copy_type": "vcam_optics", "rows": [
      {"l": "Lens equiv.", "k": "readout", "w": "vc_lens_equiv", "h": "Full-frame equivalent focal length from the vertical field of view (24 mm sensor height).", "bind": "code"},
      {"l": "Field of view", "k": "combo", "w": "vc_fov_mode", "h": "Fixed uses Degrees below; Follow projector takes it from the projector.", "it": ["Fixed vertical FOV", "Follow projector"], "iv": [0,1], "bind": "code", "show_if": "not_skeleton"},
      {"l": "Degrees", "k": "slider", "w": "vc_fov_deg", "h": "Vertical field of view in degrees.", "mn": 5, "mx": 175, "st": 0.5, "dc": 1, "unit": "deg", "bind": "code", "show_if": "fixed_fov"},
      {"l": "Degrees", "k": "readout", "w": "vc_fov_projector", "h": "The projector currently supplies the field of view.", "bind": "code", "show_if": "projector_fov"},
      {"l": "FOV (attached)", "k": "slider", "w": "vc_fov_attached", "h": "Vertical field of view while attached to the skeleton. Replaces Field of view.", "mn": 10, "mx": 150, "st": 1, "dc": 0, "unit": "deg", "bind": "code", "show_if": "skeleton"},
      {"l": "Near clip", "k": "slider", "w": "vc_near_clip", "h": "Near clipping plane distance.", "mn": 0.01, "mx": 10, "st": 0.01, "dc": 3, "unit": "m", "bind": "code"},
      {"l": "Far clip", "k": "slider", "w": "vc_far_clip", "h": "Far clipping plane distance.", "mn": 0.2, "mx": 512, "st": 0.1, "dc": 1, "unit": "m", "bind": "code"}
    ]},
    {"id": "surface_lens", "t": "Surface lens", "k": "rows", "badge": "ALL CAMERAS", "rows": [
      {"l": "Lens zoom", "k": "slider", "w": "vc_lens_zoom", "h": "Magnification shared by every Surface Lens.", "kw": "surface lens zoom magnify", "s": "PrismLensZoom", "d": 2.0, "mn": 1, "mx": 8, "st": 0.1, "dc": 2, "unit": "x", "bind": "setting"},
      {"l": "Lens zoom note", "k": "readout", "w": "vc_lens_zoom_note", "h": "Lens zoom applies to all lenses, not just this one.", "bind": "code"}
    ]},
    {"id": "guide", "t": "In-world guide", "k": "rows", "badge": "CAM n", "rows": [
      {"l": "Show guide", "k": "toggle", "w": "vc_guide_show", "h": "Draw a client-side wireframe frustum at this camera. No prim is rezzed; nothing is drawn while the UI is hidden (filming).", "bind": "code"},
      {"l": "Rule of thirds", "k": "toggle", "w": "vc_guide_thirds", "h": "Subdivide the framing gate into a 3x3 grid.", "bind": "code", "show_if": "guide_on"},
      {"l": "Up / roll", "k": "toggle", "w": "vc_guide_up", "h": "Draw an up/roll nub on the top edge of the gate so tilt reads.", "bind": "code", "show_if": "guide_on"},
      {"l": "Center crosshair", "k": "toggle", "w": "vc_guide_cross", "h": "Draw a small crosshair at the gate centre.", "bind": "code", "show_if": "guide_on"},
      {"l": "Clip markers", "k": "toggle", "w": "vc_guide_clip", "h": "Clip range markers: Draw the near-clip rectangle so the depth range reads.", "bind": "code", "show_if": "guide_on"},
      {"l": "Guide note", "k": "readout", "w": "vc_guide_note", "h": "Shows where this camera is and what its lens covers, so you can place it in the world.", "bind": "code", "show_if": "guide_off"}
    ]},
    {"id": "camera_look", "t": "Camera look", "k": "rows", "badge": "CAM n", "copy_type": "vcam_look", "rows": [
      {"l": "Exposure EV", "k": "slider", "w": "vc_exposure", "h": "Exposure offset for this camera's picture, separate from any face brightness.", "mn": -4, "mx": 4, "st": 0.1, "dc": 1, "unit": "EV", "bind": "code"},
      {"l": "Film grain", "k": "slider", "w": "vc_grain", "h": "Animated film grain over the picture.", "mn": 0, "mx": 1, "st": 0.01, "dc": 2, "bind": "code"},
      {"l": "Chromatic ab.", "k": "slider", "w": "vc_chromatic", "h": "Colour fringing toward the frame edges.", "mn": 0, "mx": 1, "st": 0.01, "dc": 2, "bind": "code"},
      {"l": "CRT lines", "k": "slider", "w": "vc_camera_crt", "h": "Scanlines baked into this camera's picture (every face gets them).", "mn": 0, "mx": 1, "st": 0.01, "dc": 2, "bind": "code"}
    ]},
    {"id": "look_goes", "t": "Where this look goes", "k": "rows", "badge": "CAM n", "rows": [
      {"l": "Feeds", "k": "readout", "w": "vc_look_feeds", "h": "Every face bound to this camera receives this look.", "bind": "code"},
      {"l": "Look note", "k": "readout", "w": "vc_look_note", "h": "These change the camera's picture itself. Per-screen TV effects belong to one face in 4 Output.", "bind": "code"},
      {"l": "Go to Output", "k": "button", "w": "vc_go_output", "h": "Open the Output section.", "btn": "Go to Output", "bind": "code"}
    ]},
    {"id": "output_frame", "t": "Output frame", "k": "rows", "badge": "CAM n", "copy_type": "vcam_output", "rows": [
      {"l": "Output aspect", "k": "combo", "w": "vc_output_aspect", "h": "Shape of the picture this camera renders.", "it": ["16:9", "4:3", "1:1", "Custom"], "iv": [1.7777778, 1.3333333, 1, -1], "selectable_values": [-1], "bind": "code"},
      {"l": "Custom W/H", "k": "slider", "w": "vc_output_custom", "h": "Width over height.", "mn": 0.25, "mx": 4, "st": 0.01, "dc": 3, "bind": "code", "show_if": "custom_aspect"},
      {"l": "Picture", "k": "readout", "w": "vc_output_picture", "h": "Logical axes are capped at 1024 px; Quality ceiling and Adaptive scale it.", "bind": "code"}
    ]},
    {"id": "faces", "t": "Faces this camera feeds", "k": "rows", "badge": "CAM n", "rows": [
      {"l": "", "k": "custom", "w": "vc_face_list", "h": "Choose raw camera output or a bound face. Drop another camera's monitor on a face row to move it.", "custom_tag": "vcam_face_list", "bind": "code", "row_height": 150},
      {"l": "Add selected face", "k": "button", "w": "vc_add_face", "h": "Bind the selected in-world prim face to this camera.", "btn": "Add selected face", "bind": "code"},
      {"l": "New face map", "k": "combo", "w": "vc_new_face_fit", "h": "Mapping for new face: Default mapping used for a newly bound face.", "it": ["Fit", "Fill", "Stretch"], "iv": [0,1,2], "bind": "code"},
      {"l": "Add virtual screen", "k": "button", "w": "vc_add_screen", "h": "Add a viewer-local virtual screen in front of your view.", "btn": "Add virtual screen", "bind": "code"},
      {"l": "Face capacity", "k": "readout", "w": "vc_face_count", "h": "Faces used across all cameras.", "bind": "code"}
    ]},
    {"id": "projectors", "t": "Projectors", "k": "rows", "badge": "CAM n", "rows": [
      {"l": "", "k": "custom", "w": "vc_projector_list", "h": "Projector lights using this camera. Select a row to edit it; Remove clears only the viewer-local feed.", "custom_tag": "vcam_projector_list", "bind": "code", "row_height": 150},
      {"l": "Tip", "k": "readout", "w": "vc_projector_hint", "h": "Select a projector row to reveal its look controls.", "bind": "code", "show_if": "no_selected_projector"}
    ]},
    {"id": "projector", "t": "Projector", "k": "rows", "badge": "PROJECTOR n", "copy_type": "vcam_projector", "show_if": "selected_projector", "rows": [
      {"l": "Look preset", "k": "combo", "w": "vc_proj_look", "h": "Apply only the projector look fields. Editing any look field makes this Custom.", "it": ["Custom", "Clean digital", "Cinema xenon", "16mm home movie", "Old slide projector", "Worn film reel"], "iv": [-1,0,1,2,3,4], "bind": "code"},
      {"l": "Framing", "k": "segmented", "w": "vc_proj_fit", "h": "Fit keeps the whole picture, Fill crops by the anchor, and Stretch maps the complete picture.", "it": ["Fit", "Fill", "Stretch"], "iv": [0,1,2], "bind": "code"},
      {"l": "Anchor X", "k": "slider", "w": "vc_proj_anchor_x", "h": "Horizontal crop anchor for the projected feed.", "mn": 0, "mx": 1, "st": 0.05, "dc": 2, "bind": "code"},
      {"l": "Anchor Y", "k": "slider", "w": "vc_proj_anchor_y", "h": "Vertical crop anchor for the projected feed.", "mn": 0, "mx": 1, "st": 0.05, "dc": 2, "bind": "code"},
      {"l": "Flip H", "k": "toggle", "w": "vc_proj_flip_h", "h": "Mirror the projected picture left to right.", "bind": "code"},
      {"l": "Flip V", "k": "toggle", "w": "vc_proj_flip_v", "h": "Mirror the projected picture top to bottom.", "bind": "code"},
      {"l": "Rotate", "k": "segmented", "w": "vc_proj_rotate", "h": "Rotate the projected picture in quarter turns.", "it": ["0", "90", "180", "270"], "iv": [0,1,2,3], "bind": "code"},
