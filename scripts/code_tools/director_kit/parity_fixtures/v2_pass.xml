<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- Parity fixture: v2 side that satisfies every check for v1_leaf.xml. -->
<floater name="fx_v2_floater">
 <kit_card sel_setting="FxComboSetting">
  <kit_option label="Alpha" value="1"/>
  <kit_option label="Gamma" value="3"/>
 </kit_card>
 <kit_card sel_setting="FxCineSetting">
  <kit_option label="Cine 41" value="41"/>
 </kit_card>
 <kit_card sel_setting="FxNewSelector">
  <kit_option label="Key" value="0"/>
 </kit_card>
 <slider name="fx_slider" control_name="FxSliderSetting"/>
 <kit_switch name="fx_check" control_name="FxCheckSetting"/>
 <combo_box name="fx_combo" control_name="FxComboSetting"/>
 <combo_box name="fx_cine_mode" control_name="FxCineSetting"/>
 <button name="fx_combo_reset"/>
 <text name="fx_readout"/>
 <slider name="fx_embedded" control_name="FxEmbedded"/>
 <slider name="fx_shortcut" control_name="FxSliderSetting" shortcut_of="fx_slider"/>
 <slider name="fx_left"/>
 <slider name="fx_right"/>
</floater>
