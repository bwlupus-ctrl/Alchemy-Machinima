            float facetLod = 1.0-smoothstep(0.003,0.016,max(fw2.x,fw2.y));
            float reform = 0.5 + 0.5 * sin(t*3.0 + rnd*6.2831853);
            float piece = cellAA.x * cellAA.y;
            rgb = vec3(0.009,0.015,0.024) + cyan * (seam * facetLod * piece * (0.25+reform*0.65)
