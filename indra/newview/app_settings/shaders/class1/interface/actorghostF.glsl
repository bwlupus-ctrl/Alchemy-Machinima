        }
        else if (ghostLook == 95) // Intrusion
        {
            float epoch = floor(t / 1.8);
            vec2 q = p2 / 0.12;
            vec2 id = floor(q), f = fract(q);
            float turn = step(0.5,ghost_hash(id+vec2(epoch,seed)));
