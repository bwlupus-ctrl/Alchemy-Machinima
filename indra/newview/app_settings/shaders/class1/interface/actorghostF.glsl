            float tear=smoothstep(threshold-0.035-fw*4.0,threshold+0.035+fw*4.0,field);
            float border=exp(-sq((field-threshold)/(0.025+fw*4.0)));
            float ribs=pow(0.5+0.5*cos(P.z*58.0),8.0)*detail;
            float spine=exp(-abs(P.y)*42.0)*anatomical
                        * smoothstep(sl_pelvis,sl_chest,P.z)*(1.0-smoothstep(sl_neck,sl_head,P.z));
