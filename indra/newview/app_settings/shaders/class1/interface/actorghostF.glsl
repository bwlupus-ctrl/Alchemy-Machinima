                        * (1.0-smoothstep(eyeWidth,sl_half_width,abs(P.y))) * front * anatomical;
            vec3 chassis=vec3(0.02,0.03,0.045)+vec3(0.35,0.42,0.46)*(ribs+spine)
                        + cyan*sensor*0.9
                        + vec3(1.0,0.08,0.015)*spine*(0.3+0.25*sin(t*3.0-P.z*8.0));
