        else if (ghostLook == 99) // Hunter Vision
        {
            // A short acquisition edge snaps into the body-locked centre;
            // the rest of the cycle hunts through candidate positions.
            float hunt = 1.0-smoothstep(0.54,0.56,fract(t/3.0));
            float bracketHeight=(sl_neck-sl_knee)*0.5;
            vec2 target=vec2(sin(t*2.1)*sl_half_width*0.4,cos(t*1.7)*(sl_chest-sl_pelvis)*0.4)*hunt;
            target.y += (sl_neck+sl_knee)*0.5;
            vec2 b=abs(P.yz-target);
            float aa=fw+0.004;
            float vertical=(1.0-smoothstep(0.006,0.006+aa,abs(b.x-sl_half_width)))
                           *(1.0-smoothstep(bracketHeight-0.01,bracketHeight+0.01,b.y))
                           *smoothstep(bracketHeight*0.55,bracketHeight*0.75,b.y)*anatomical*front;
            float horizontal=(1.0-smoothstep(0.006,0.006+aa,abs(b.y-bracketHeight)))
                             *(1.0-smoothstep(sl_half_width-0.01,sl_half_width+0.01,b.x))
                             *smoothstep(sl_half_width*0.5,sl_half_width*0.8,b.x)*anatomical*front;
            float ladder=pow(0.5+0.5*sin(P.z*40.0),12.0)*detail;
            vec2 suv=fragCoord/max(ghostScreenSize,vec2(1.0));
            float raster=exp(-sq((fract(suv.y-t*0.22)-0.5)/0.035));
            float ticks=ladder*smoothstep(sl_half_width*0.8,sl_half_width*1.3,abs(P.y))*anatomical*front;
            rgb=vec3(0.13,0.006,0.008)*(0.6+lum)+vec3(1.0,0.025,0.008)
                *(vertical+horizontal+ticks*0.6+raster*0.5+edge*0.20);
        }
        else // 100: Ooze
        {
            float slosh=sin(P.z*5.0+t*1.4)+cos(P.y*9.0-t*1.1);
            vec2 q=vec2(P.y*9.0+sin(P.z*3.0+t)*0.45,P.z*3.0+t*0.65);
            vec2 id=floor(q), f=fract(q)-0.5;
            float life=fract(t*0.3+ghost_hash(id+seed));
            float radius=0.05+0.30*sin(life*3.1415927);
            float bubble=exp(-sq((length(f)-radius)/(0.035+fw*9.0)))*(1.0-smoothstep(0.82,1.0,life));
            float drip=exp(-abs(sin(P.y*26.0+sin(P.z*4.0+t)))*7.0)
                      *(0.5+0.5*sin(P.z*14.0+t*3.2));
            vec3 halfVector=vec3(0.3,-0.4,0.85)+v;
            float wet=pow(max(dot(n,halfVector/max(length(halfVector),1e-6)),0.0),32.0);
            rgb=vec3(0.025,0.17,0.095)*(1.2+slosh*0.35)+vec3(0.18,0.95,0.43)
                *(edge*0.7+(bubble*0.42+drip*0.32)*detail)+ivory*wet*0.75;
        }
        // Authored MASK/BLEND/vertex alpha is authoritative for every material.
        alpha = color.a * tex.a;
    }

    else if (ghostLook == 77) // Studio: Contour
    {
        float z   = -vary_position.z;                                        // eye depth, metres
        float sp = 0.02; // Fixed depth planes; footprint changes coverage, never phase.
        float depthPx = fz + 1e-6;                                        // take in E-B block
        float q   = z / sp + ghostTime * 0.15 + ghostAux.w;
        float iso = abs(fract(q) - 0.5);
        float unresolved = smoothstep(0.18, 0.45, depthPx / sp);
        float width = clamp((depthPx / sp) * 1.5, 1e-5, 0.48);
        float line = mix(1.0 - smoothstep(0.0, width, iso), 0.45, unresolved);
        float major = mix(1.0 - step(0.5, mod(floor(q), 5.0)), 0.2, unresolved);
        vec3 lc = mix(vec3(0.3, 1.0, 0.8), color.rgb, 0.4);
        rgb   = color.rgb * 0.06 * (1.0 + lum) + lc * (line * (0.9 + major * 0.8) + edge * 0.35);
        alpha = color.a * tex.a * clamp(0.25 + line * 0.75 + edge * 0.3, 0.0, 1.0);
    }
    else if (ghostLook == 66) // Studio: Marble
    {
        vec3  P    = vary_object_position + vec3(cos(ghostAux.w), sin(ghostAux.w), 0.3*ghostAux.w) * 0.37;
        // Fixed authored veins beneath a slowly travelling polished sheen.
        float warp = ghost_fbm(P.xz * 1.9 + P.y * 0.6);
        float v1   = ghost_ridge(P.xy * 3.1 + warp * 1.6);                  // broad veins
        float v2 = 0.0;
        if (max(fwP.x, max(fwP.y, fwP.z)) < 0.006)
            v2 = ghost_ridge(vec2(P.z, P.x) * 7.5 - warp * 0.9)
                * (1.0 - smoothstep(0.003, 0.006, max(fwP.x, max(fwP.y, fwP.z)))) ;        // fine veins
        float vein = pow(v1, 9.0) * 0.85 + pow(v2, 14.0) * 0.45;
        // AA: fade veins when their width approaches the pixel footprint
        vein *= smoothstep(0.25, 1.0, 1.0 / (1.0 + 40.0 * max(fwP.x, max(fwP.y, fwP.z))));
        const vec3 L = normalize(vec3(0.35, 0.6, 0.72));
        float lam  = 0.35 + 0.65 * max(dot(n, L), 0.0);                    // wrapped lambert
        float sss  = pow(1.0 - facing, 3.0) * 0.35;                        // warm grazing glow
        vec3 stone = mix(vec3(0.93, 0.91, 0.87), color.rgb, 0.15);
        stone *= 0.85 + 0.15 * lum;                                        // keep face/cloth folds
        rgb = mix(stone, vec3(0.28, 0.33, 0.30), clamp(vein, 0.0, 1.0)) * lam
            + vec3(0.35, 0.22, 0.14) * sss;
        float cycle = (ghostTime > 314.159265359 ? ghostTime - 628.318530718 : ghostTime) * 0.01;
        float phase = P.z*7.0 + P.y*2.0 + ghostAux.w;
        float sheen = pow(0.5 + 0.5*sin(phase - cycle*75.0), 3.0);
        rgb += min(vec3(0.12,0.115,0.105), max(vec3(0.0), vec3(0.98)-rgb)) * sheen;
        alpha = color.a * tex.a;
    }
    else if (ghostLook == 73) // Studio: Lidar
    {
        vec3  P   = vary_object_position;
        vec3  nb  = (cross(oPx, oPy) / max(length(cross(oPx, oPy)), 1e-8));                                // rest-space surface normal
        float fw  = max(length(oPx), length(oPy));
        float cs = 0.022; // Fixed rest lattice: LOD must not reseed cells on camera moves.                   // â‰¥4 px between dots
        vec3  c   = floor(P / cs);
        vec3  jit = (vec3(ghost_hash3(c), ghost_hash3(c + 5.1), ghost_hash3(c + 9.7)) - 0.5) * 0.35;
        vec3  cc  = (c + 0.5 + jit) * cs;
        vec3  dl  = P - cc;
        vec3  tg  = dl - nb * dot(dl, nb);                                     // distance in the surface plane
        float r   = length(tg);
        float dotR = max(cs * 0.18, fw * 1.4);                                 // â‰¥1.4 px radius
        float detail = 1.0 - smoothstep(cs / 6.0, cs / 3.0, fw);
        // Projected centres can jump at 3-D cell faces. Fade to zero at
        // those faces over a captured pixel footprint, before selecting a new
        // centre, so fractional camera motion cannot pop a clipped dot.
        vec3 cellEdge = min(fract(P / cs), 1.0 - fract(P / cs));
        vec3 cellAA = smoothstep(vec3(0.0), max(2.0 * fwP / cs, vec3(1e-5)), cellEdge);
        float cellMask = cellAA.x * cellAA.y * cellAA.z;
        float m = mix(0.20, (1.0 - smoothstep(max(0.0, dotR - fw), dotR + fw + 1e-6, r)) * cellMask, detail);
