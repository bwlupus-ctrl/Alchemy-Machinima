<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!--
    Donor: I:\enve (phoenix-reshade-XL / Firestorm, LGPL),
    skins/default/xui/en/floater_animation_explorer.xml.
    Ported for the BD/FS -> Alchemy merge campaign, item F7 (Animation Explorer).
    [BDMerge F7]

    Adapted to Alchemy's floater conventions (see floater_explore_sounds.xml):
    <columns> instead of <scroll_list.column>, positioning="centered",
    single_instance/save_visibility, and the animation_explorer_* strings are
    declared locally via <floater.string> instead of the shared strings.xml.
-->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 positioning="centered"
 height="374"
 min_height="374"
 min_width="676"
 width="676"
 name="animation_explorer"
 title="Animation Explorer"
 save_rect="true"
 save_visibility="true"
 single_instance="true"
 reuse_instance="false">

	<floater.string name="animation_explorer_still_playing">
		Still playing
	</floater.string>
	<floater.string name="animation_explorer_seconds_ago">
		[SECONDS] seconds ago
	</floater.string>
	<floater.string name="animation_explorer_unknown_priority">
		unknown
	</floater.string>

	<scroll_list
	 bottom="-34"
	 column_padding="0"
	 draw_heading="true"
	 follows="left|top|bottom"
	 layout="topleft"
	 left="4"
	 name="animation_list"
	 search_column="1"
	 top="4"
	 width="306">
		<columns
		 label="Played by"
		 name="played_by" />
		<columns
		 label="Played"
		 name="played" />
		<columns
		 label="Priority"
		 name="priority"
		 width="60"/>
		<columns
		 label="Timestamp"
		 name="timestamp"
		 width="-1" />
		<columns
		 label="Animation ID"
		 name="animation_id"
		 width="-1" />
		<columns
		 label="Object ID"
		 name="object_id"
		 width="-1" />
	</scroll_list>

	<!-- Shared preview pane + own-avatar controls: the spinning LLPreviewAnimation
	     dummy (drag to orbit, wheel to zoom), auto-loops the selected animation,
	     and the Capture-all / Stop / Stop and Revoke / Blacklist controls. The
	     same ALPanelAnimPreview the Director Console Animate tab embeds -> the
	     preview + its mouse handling live in one place and cannot drift. -->
	<panel
	 class="panel_anim_preview"
	 filename="panel_anim_preview.xml"
	 follows="top|right"
	 height="188"
	 layout="topleft"
	 left="316"
	 name="anim_preview_panel"
	 top="4"
	 width="354" />

	<!-- Explorer-only: filters the recent-played list, not a preview control -->
	<check_box
	 follows="top|right"
	 height="22"
	 label="No Owned Animations"
	 layout="topleft"
	 left="316"
	 name="no_owned_animations_check"
	 tool_tip="When checked this will filter out all animations that are owned by your avatar, like AO animations or system default animations."
	 top="200"
	 width="354" />

	<!-- [ActorMover] UUID tools strip: selected anim UUID readout + copy/handoff -->
	<line_editor
	 follows="left|bottom"
	 height="20"
	 layout="topleft"
	 left="4"
	 bottom="-6"
	 max_length_chars="36"
	 name="anim_uuid_editor"
	 tool_tip="Asset UUID of the selected animation"
	 width="270" />

	<button
	 follows="left|bottom"
	 height="20"
	 label="Copy UUID"
	 layout="topleft"
	 left_pad="6"
	 bottom_delta="0"
	 name="copy_uuid_btn"
	 tool_tip="Copy the selected animation's asset UUID to the clipboard"
	 width="90" />

	<button
	 follows="left|bottom"
	 height="20"
	 label="To Actor Mover"
	 layout="topleft"
	 left_pad="6"
	 bottom_delta="0"
	 name="to_actor_mover_btn"
	 tool_tip="Use the selected animation as the Actor Mover's custom locomotion anim and open the Actor Mover"
	 width="120" />

</floater>
