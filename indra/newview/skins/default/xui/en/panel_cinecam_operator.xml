    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorSeed" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="301" name="reset_FlycamOperatorSeed" tool_tip="Reset to default" top="656" width="12" />

    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft"
     left="12" name="operator_motion_title" top="676" width="304">Motion feel</text>
    <spinner control_name="FlycamOperatorMotionCalm" decimal_digits="2" height="16" increment="0.05" label="Motion calm" label_width="72" layout="topleft" left="12" top="696" min_val="0" max_val="4" name="FlycamOperatorMotionCalm" tool_tip="How strongly motion calms high-frequency tremor." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorMotionCalm" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="149" name="reset_FlycamOperatorMotionCalm" tool_tip="Reset to default" top="696" width="12" />
    <spinner control_name="FlycamOperatorMotionPan" decimal_digits="2" height="16" increment="0.05" label="Motion pan" label_width="72" layout="topleft" left="164" top="696" min_val="0" max_val="2" name="FlycamOperatorMotionPan" tool_tip="Motion response on yaw/pan." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorMotionPan" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="301" name="reset_FlycamOperatorMotionPan" tool_tip="Reset to default" top="696" width="12" />
    <spinner control_name="FlycamOperatorMotionTilt" decimal_digits="2" height="16" increment="0.05" label="Motion tilt" label_width="72" layout="topleft" left="12" top="716" min_val="0" max_val="2" name="FlycamOperatorMotionTilt" tool_tip="Motion response on pitch/tilt." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorMotionTilt" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="149" name="reset_FlycamOperatorMotionTilt" tool_tip="Reset to default" top="716" width="12" />
