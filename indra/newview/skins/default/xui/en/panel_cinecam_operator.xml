<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Camera Shake authority and rig-choice page. Persisted setting names retain
     FlycamOperator* for compatibility; only the user-facing language changes. -->
<panel
 background_visible="false"
 border="false"
 height="1325"
 layout="topleft"
 name="panel_cinecam_operator"
 width="340">
    <panel.string name="no_preset_label">-none-</panel.string>
    <text follows="left|top" font="SansSerifBold" height="16"
     layout="topleft" left="12" top="8" width="316">CAMERA SHAKE AUTHORITY</text>
    <text follows="left|top" height="30" layout="topleft" left="12"
     top="27" width="316" word_wrap="true">
        Authority is how much shake reaches each axis: 0 off, 1 natural, 2 exaggerated.
    </text>

    <check_box control_name="CameraShakeApplyActive" follows="left|top" height="16"
     label="Apply to active camera" layout="topleft" left="12" top="61"
     name="CameraShakeApplyActive"
     tool_tip="One switch: apply Camera Shake to whichever camera you are using — third-person mouse cam, joystick flycam, or the cinematic camera. Per-camera toggles below still work when this is off."
     width="288" />
    <button commit_callback.function="Machinima.ResetControl"
     commit_callback.parameter="CameraShakeApplyActive" follows="left|top" height="16"
     image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="301"
     name="reset_CameraShakeApplyActive" tool_tip="Reset to default" top="61" width="12" />

    <panel background_visible="false" border="false" height="1301"
     layout="topleft" left="0" mouse_opaque="false" name="camera_shake_controls" top="24" width="340">
    <text follows="left|top" height="16" layout="topleft" left="12"
     top="61" width="86">Shake preset</text>
    <combo_box follows="left|top" height="20" layout="topleft" left="100"
     name="shake_preset_combo" top="57"
     tool_tip="Curated one-click looks. Applying one changes the controls below; your saved named rigs remain separate."
     width="216">
        <combo_box.item label="Choose a look..." name="shake_none" value="0" />
        <combo_box.item label="Locked Tripod" name="shake_locked" value="1" />
        <combo_box.item label="Subtle Handheld" name="shake_subtle" value="2" />
        <combo_box.item label="Documentary" name="shake_documentary" value="3" />
        <combo_box.item label="Shoulder Rig" name="shake_shoulder" value="4" />
        <combo_box.item label="Run-and-Gun" name="shake_run_gun" value="5" />
        <combo_box.item label="Vehicle / Drive" name="shake_vehicle" value="6" />
        <combo_box.item label="Drone Float" name="shake_drone" value="7" />
        <combo_box.item label="Verite" name="shake_verite" value="8" />
        <combo_box.item label="Heartbeat" name="shake_heartbeat" value="9" />
    </combo_box>

    <combo_box control_name="FlycamOperatorLocomotionMode" follows="left|top"
     height="20" layout="topleft" left="12" name="shake_locomotion_mode"
     top="84" tool_tip="What the camera carrier is physically doing. Auto follows camera translation speed."
     width="304">
        <combo_box.item label="Motion: Legacy / authored" name="loco_legacy" value="0" />
        <combo_box.item label="Motion: Creep" name="loco_creep" value="1" />
        <combo_box.item label="Motion: Walk" name="loco_walk" value="2" />
        <combo_box.item label="Motion: Run" name="loco_run" value="3" />
        <combo_box.item label="Motion: Drive" name="loco_drive" value="4" />
        <combo_box.item label="Motion: Float" name="loco_float" value="5" />
        <combo_box.item label="Motion: Unsteady" name="loco_unsteady" value="6" />
        <combo_box.item label="Motion: Auto from speed" name="loco_auto" value="100" />
    </combo_box>
    <button commit_callback.function="Machinima.ResetControl"
     commit_callback.parameter="FlycamOperatorLocomotionMode" follows="left|top"
     height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_FlycamOperatorLocomotionMode" tool_tip="Reset to Legacy"
     top="86" width="12" />
    <combo_box control_name="FlycamOperatorStyle" follows="left|top" height="20"
     layout="topleft" left="12" name="shake_style" top="108"
     tool_tip="The physical rig character, independent of locomotion."
     width="304">
        <combo_box.item label="Rig: Custom" name="style_custom" value="0" />
        <combo_box.item label="Rig: Tripod / sticks" name="style_tripod" value="1" />
        <combo_box.item label="Rig: Subtle handheld" name="style_subtle" value="2" />
        <combo_box.item label="Rig: Documentary" name="style_documentary" value="3" />
        <combo_box.item label="Rig: Run-and-gun" name="style_run_gun" value="4" />
        <combo_box.item label="Rig: Shoulder" name="style_shoulder" value="5" />
        <combo_box.item label="Rig: Gimbal float" name="style_gimbal" value="6" />
        <combo_box.item label="Rig: Verite" name="style_verite" value="7" />
        <combo_box.item label="Rig: Breathing only" name="style_breath" value="8" />
    </combo_box>
    <button commit_callback.function="Machinima.ResetControl"
     commit_callback.parameter="FlycamOperatorStyle" follows="left|top" height="16"
     image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="320"
     name="reset_FlycamOperatorStyle" tool_tip="Reset rig style" top="110" width="12" />
    <combo_box control_name="FlycamOperatorProfile" follows="left|top" height="20"
     layout="topleft" left="12" name="shake_profile" top="132"
     tool_tip="Performance feel used by Legacy motion; explicit locomotion modes supply their own physical profile."
     width="304">
        <combo_box.item label="Feel: Natural" name="profile_natural" value="0" />
        <combo_box.item label="Feel: Locked" name="profile_locked" value="1" />
        <combo_box.item label="Feel: Follow" name="profile_follow" value="2" />
        <combo_box.item label="Feel: Restless" name="profile_restless" value="3" />
        <combo_box.item label="Feel: Composed" name="profile_composed" value="4" />
        <combo_box.item label="Feel: Drift" name="profile_drift" value="5" />
        <combo_box.item label="Feel: Snap" name="profile_snap" value="6" />
        <combo_box.item label="Feel: March" name="profile_march" value="7" />
    </combo_box>
    <button commit_callback.function="Machinima.ResetControl"
     commit_callback.parameter="FlycamOperatorProfile" follows="left|top" height="16"
     image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="320"
     name="reset_FlycamOperatorProfile" tool_tip="Reset motion feel" top="134" width="12" />

    <text follows="left|top" font="SansSerifBold" height="16"
     layout="topleft" left="12" name="operator_rig_title" top="156"
     width="304">Handheld rig / persona</text>
    <check_box control_name="FlycamOperatorEnabled" follows="left|top" height="16"
     label="Use on live flycam" layout="topleft" left="12" top="176"
     name="FlycamOperatorEnabled" tool_tip="Apply this operator rig to the live joystick flycam."
     width="135" />
    <button commit_callback.function="Machinima.ResetControl"
     commit_callback.parameter="FlycamOperatorEnabled" follows="left|top" height="16"
     image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="149"
     name="reset_FlycamOperatorEnabled" tool_tip="Reset to default" top="176" width="12" />
    <check_box control_name="FlycamOperatorForceWalk" follows="left|top" height="16"
     label="Force gait" layout="topleft" left="164" top="176"
     name="FlycamOperatorForceWalk" tool_tip="Keep the authored Legacy gait active even below its motion gate."
     width="135" />
    <button commit_callback.function="Machinima.ResetControl"
     commit_callback.parameter="FlycamOperatorForceWalk" follows="left|top" height="16"
     image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="301"
     name="reset_FlycamOperatorForceWalk" tool_tip="Reset to default" top="176" width="12" />

    <text follows="left|top" font="SansSerifBold" height="16"
     layout="topleft" left="12" top="204" width="316">TRANSLATION</text>
    <slider control_name="FlycamOperatorGainSurge" decimal_digits="2"
     follows="left|top" height="18" increment="0.05" label="Surge - forward/back"
     label_width="126" layout="topleft" left="12" max_val="2" min_val="0"
     name="FlycamOperatorGainSurge" top="224"
     tool_tip="Forward/back travel, including Drive road movement." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorGainSurge"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_FlycamOperatorGainSurge" tool_tip="Reset surge authority" top="225" width="12" />
    <slider control_name="FlycamOperatorGainSway" decimal_digits="2"
     follows="left|top" height="18" increment="0.05" label="Sway - left/right"
     label_width="126" layout="topleft" left="12" max_val="2" min_val="0"
     name="FlycamOperatorGainSway" top="247"
     tool_tip="Side-to-side body and footfall movement." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorGainSway"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_FlycamOperatorGainSway" tool_tip="Reset sway authority" top="248" width="12" />
    <slider control_name="FlycamOperatorGainHeave" decimal_digits="2"
     follows="left|top" height="18" increment="0.05" label="Heave - up/down"
     label_width="126" layout="topleft" left="12" max_val="2" min_val="0"
     name="FlycamOperatorGainHeave" top="270"
     tool_tip="Step bob, breathing lift, and vehicle suspension." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorGainHeave"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_FlycamOperatorGainHeave" tool_tip="Reset heave authority" top="271" width="12" />

    <text follows="left|top" font="SansSerifBold" height="16"
     layout="topleft" left="12" top="300" width="316">ROTATION</text>
    <slider control_name="FlycamOperatorGainRoll" decimal_digits="2"
     follows="left|top" height="18" increment="0.05" label="Roll - horizon tilt"
     label_width="126" layout="topleft" left="12" max_val="2" min_val="0"
     name="FlycamOperatorGainRoll" top="320"
     tool_tip="Rotation around the lens axis: shoulder lean and heel strikes." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorGainRoll"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_FlycamOperatorGainRoll" tool_tip="Reset roll authority" top="321" width="12" />
    <slider control_name="FlycamOperatorGainPitch" decimal_digits="2"
     follows="left|top" height="18" increment="0.05" label="Pitch - look up/down"
     label_width="126" layout="topleft" left="12" max_val="2" min_val="0"
     name="FlycamOperatorGainPitch" top="343"
     tool_tip="Vertical aim wander and reactive tilt." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorGainPitch"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_FlycamOperatorGainPitch" tool_tip="Reset pitch authority" top="344" width="12" />
    <slider control_name="FlycamOperatorGainYaw" decimal_digits="2"
     follows="left|top" height="18" increment="0.05" label="Yaw - look left/right"
     label_width="126" layout="topleft" left="12" max_val="2" min_val="0"
     name="FlycamOperatorGainYaw" top="366"
     tool_tip="Horizontal aim wander and reactive pan." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorGainYaw"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_FlycamOperatorGainYaw" tool_tip="Reset yaw authority" top="367" width="12" />

    <text follows="left|top" font="SansSerifBold" height="16"
     layout="topleft" left="12" top="396" width="316">LENS</text>
    <slider control_name="FlycamOperatorGainFOV" decimal_digits="2"
     follows="left|top" height="18" increment="0.05" label="FOV - lens breathing"
     label_width="126" layout="topleft" left="12" max_val="2" min_val="0"
     name="FlycamOperatorGainFOV" top="416"
     tool_tip="Breathing zoom authority. Zero pins the multiplier to neutral; it never collapses the FOV." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorGainFOV"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_FlycamOperatorGainFOV" tool_tip="Reset FOV authority" top="417" width="12" />

    <text follows="left|top" font="SansSerifBold" height="16"
     layout="topleft" left="12" top="446" width="316">FEEL</text>
    <slider control_name="CinematicCamSmoothing" decimal_digits="2"
     follows="left|top" height="18" increment="0.01" label="Smoothing (seconds)"
     label_width="126" layout="topleft" left="12" max_val="2" min_val="0"
     name="CinematicCamSmoothing" top="466"
     tool_tip="How slowly the cinematic camera follows its resolved pose. Zero is rigid; higher values glide." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="CinematicCamSmoothing"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_CinematicCamSmoothing" tool_tip="Reset smoothing" top="467" width="12" />
    <spinner control_name="CinematicCamFrameOffsetUp" decimal_digits="2"
     follows="left|top" height="18" increment="0.05" label="Frame up (meters)"
     label_width="126" layout="topleft" left="12" max_val="3" min_val="-3"
     name="CinematicCamFrameOffsetUp" top="490"
     tool_tip="Raise or lower the subject framing point. Not used by Bone Lock." width="304" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="CinematicCamFrameOffsetUp"
     follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft"
     left="320" name="reset_CinematicCamFrameOffsetUp" tool_tip="Reset frame-up offset" top="491" width="12" />

    <text follows="left|top" height="16" layout="topleft" left="12"
     name="preset_lbl" top="526" width="52">My rig</text>
    <combo_box follows="left|top" height="20" layout="topleft" left="64"
     name="preset_combo" top="522"
     tool_tip="Your saved full camera rigs. These are separate from the curated Shake preset looks."
     width="124" />
    <button follows="left|top" height="20" label="Save" layout="topleft"
     left="194" name="btn_preset_save" top="522"
     tool_tip="Save the complete current cinematic camera rig" width="60" />
    <button follows="left|top" height="20" label="Del" layout="topleft"
     left="260" name="btn_preset_delete" top="522"
     tool_tip="Delete the selected saved rig" width="54" />

    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft"
     left="12" name="operator_reaction_title" top="556" width="304">Reaction &amp; authority</text>
    <spinner control_name="FlycamOperatorMaster" decimal_digits="2" height="16"
     increment="0.05" label="Master" label_width="72" layout="topleft"
     left="12" top="576" min_val="0" max_val="2" name="FlycamOperatorMaster"
     tool_tip="Master intensity for all handheld motion." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorMaster" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="149" name="reset_FlycamOperatorMaster" tool_tip="Reset to default" top="576" width="12" />
    <spinner control_name="FlycamOperatorReactivity" decimal_digits="2" height="16"
     increment="0.05" label="Reactivity" label_width="72" layout="topleft"
     left="164" top="576" min_val="0" max_val="4" name="FlycamOperatorReactivity"
     tool_tip="Overall motion-response strength." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorReactivity" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="301" name="reset_FlycamOperatorReactivity" tool_tip="Reset to default" top="576" width="12" />
    <spinner control_name="FlycamOperatorProfileInfluence" decimal_digits="2" height="16"
     increment="0.05" label="Profile mix" label_width="72" layout="topleft"
     left="12" top="596" min_val="0" max_val="1" name="FlycamOperatorProfileInfluence"
     tool_tip="How strongly the Legacy motion profile modifies the rig." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorProfileInfluence" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="149" name="reset_FlycamOperatorProfileInfluence" tool_tip="Reset to default" top="596" width="12" />
    <spinner control_name="FlycamOperatorTimeSpeed" decimal_digits="2" height="16"
     increment="0.05" label="Time speed" label_width="72" layout="topleft"
     left="164" top="596" min_val="0" max_val="4" name="FlycamOperatorTimeSpeed"
     tool_tip="Global speed multiplier for procedural phases." width="135" />
