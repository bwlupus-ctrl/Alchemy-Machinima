    <spinner control_name="FlycamOperatorSmoothing" decimal_digits="2" height="16"
     increment="0.05" label="Smoothing" label_width="72" layout="topleft"
     left="12" top="616" min_val="0" max_val="2" name="FlycamOperatorSmoothing"
     tool_tip="Trim for the motion input EMA." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorSmoothing" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="149" name="reset_FlycamOperatorSmoothing" tool_tip="Reset to default" top="616" width="12" />
    <spinner control_name="FlycamOperatorIdleIntensity" decimal_digits="2" height="16"
     increment="0.05" label="Idle" label_width="72" layout="topleft"
     left="164" top="616" min_val="0" max_val="4" name="FlycamOperatorIdleIntensity"
     tool_tip="Legacy idle wander intensity." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorIdleIntensity" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="301" name="reset_FlycamOperatorIdleIntensity" tool_tip="Reset to default" top="616" width="12" />
    <spinner control_name="FlycamOperatorEnergyTrim" decimal_digits="2" height="16"
     increment="0.05" label="Energy" label_width="72" layout="topleft"
     left="12" top="636" min_val="0" max_val="4" name="FlycamOperatorEnergyTrim"
     tool_tip="Trim for speed-reactive energy." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorEnergyTrim" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="149" name="reset_FlycamOperatorEnergyTrim" tool_tip="Reset to default" top="636" width="12" />
    <spinner control_name="FlycamOperatorOnset" decimal_digits="2" height="16"
     increment="0.05" label="Onset" label_width="72" layout="topleft"
     left="164" top="636" min_val="0" max_val="4" name="FlycamOperatorOnset"
     tool_tip="Acceleration whip amount." width="135" />
