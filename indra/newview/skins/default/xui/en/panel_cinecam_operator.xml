    <spinner control_name="FlycamOperatorDrag" decimal_digits="2" height="16"
     increment="0.05" label="Drag" label_width="72" layout="topleft"
     left="12" top="656" min_val="0" max_val="4" name="FlycamOperatorDrag"
     tool_tip="Lead/lag framing drag amount." width="135" />
    <button commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOperatorDrag" follows="left|top" height="16" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="149" name="reset_FlycamOperatorDrag" tool_tip="Reset to default" top="656" width="12" />
    <spinner control_name="FlycamOperatorSeed" decimal_digits="0" height="16"
     increment="1" label="Seed" label_width="72" layout="topleft"
     left="164" top="656" min_val="-1000000" max_val="1000000" name="FlycamOperatorSeed"
