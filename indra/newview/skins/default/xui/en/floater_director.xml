<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Director Console (D2): ACTION/CUT transport + persistent cast column +
     left-rail Move / Path / Animate / Camera / Takes tabs (poser visual
     language).
     Pure view over LLDirectorCast and the machinima singletons; every
     parameter control is settings-backed, shared with the standalone
     floaters. -->
<floater
 legacy_header_height="18"
 can_resize="true"
 height="650"
 min_height="560"
 min_width="660"
 layout="topleft"
 name="floater_director"
 title="Director Console"
 save_rect="true"
 single_instance="true"
 width="1020">

    <!-- ============ transport bar ============ -->
    <button
     follows="left|top"
     font="SansSerifBold"
     height="26"
     label="ACTION"
     layout="topleft"
     left="8"
     top="22"
     name="btn_action"
     width="110" />
    <button
     follows="left|top"
     font="SansSerifBold"
     height="26"
     image_color="0.85 0.25 0.25 1"
     label="CUT"
     label_color="White"
     layout="topleft"
     left="8"
     top="22"
     name="btn_cut"
     visible="false"
     width="110" />
    <spinner
     control_name="DirectorActionDelay"
     decimal_digits="1"
     follows="left|top"
     height="20"
     increment="0.5"
     label="Delay (s)"
     label_width="52"
     layout="topleft"
     left="126"
     max_val="10"
     min_val="0"
     top="26"
     name="delay_spinner"
     tool_tip="Countdown before ACTION fires (s), so a solo operator can get into frame. 0 = immediately"
     width="104" />
    <button
     follows="left|top"
     height="22"
     label="Set marks"
     layout="topleft"
     left="236"
     top="24"
     name="btn_set_marks"
     width="76" />
    <button
     follows="left|top"
     height="22"
     label="Reset to marks"
     layout="topleft"
     left="316"
     top="24"
     name="btn_reset_marks"
     width="100" />
    <combo_box
     follows="left|top"
     height="22"
     layout="topleft"
     left="420"
     top="24"
     name="scene_combo"
     tool_tip="Load a scene: restores cast, marks, loco anims, subjects and parameters"
     width="118" />
    <line_editor
     commit_on_focus_lost="false"
     follows="left|top"
     height="22"
     layout="topleft"
     left="420"
     top="24"
     max_length_chars="64"
     name="scene_name_editor"
     tool_tip="Scene name. Enter or Save writes the file; an empty name cancels"
     visible="false"
     width="118" />
    <button
     follows="left|top"
     height="22"
     label="Save"
     layout="topleft"
     left="542"
     top="24"
     name="btn_scene_save"
     tool_tip="Save the whole setup as a scene"
     width="44" />
    <button
     follows="left|top"
     height="22"
     label="X"
     layout="topleft"
     left="590"
     top="24"
     name="btn_scene_delete"
     tool_tip="Delete the selected scene file (asks to confirm)"
     width="22" />

    <!-- ============ arming row ============ -->
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="8"
     top="54"
     name="arming_lbl"
     width="74">
        Action fires:
    </text>
    <check_box
     control_name="DirectorArmMoves"
     follows="left|top"
     height="16"
     label="Actor moves"
     layout="topleft"
     left="84"
     top="53"
     name="arm_moves_check"
     tool_tip="ACTION starts a ghost walk for every cast member (you, if the cast is empty); CUT stops them"
     width="94" />
    <check_box
     control_name="DirectorArmCamera"
     follows="left|top"
     height="16"
     label="Camera"
     layout="topleft"
     left="182"
     top="53"
     name="arm_camera_check"
     tool_tip="ACTION enables the cinematic camera pattern; CUT restores the enable state it changed"
     width="76" />
    <check_box
     control_name="DirectorArmRecorderPlay"
     follows="left|top"
     height="16"
     label="Recorder play"
     layout="topleft"
     left="262"
     top="53"
     name="arm_play_check"
     tool_tip="ACTION starts Flycam Recorder playback of the loaded take; CUT stops it. Ignored while capture is also armed"
     width="104" />
    <check_box
     control_name="DirectorArmRecorderCapture"
     follows="left|top"
     height="16"
     label="Recorder capture"
     layout="topleft"
     left="370"
     top="53"
     name="arm_capture_check"
     tool_tip="ACTION starts a fresh camera capture (replaces the current take); CUT stops it. Beats recorder play when both are armed"
     width="124" />
    <button
     follows="right|top"
     font="SansSerifBold"
     height="18"
     label="?"
     layout="topleft"
     left="994"
     top="51"
     name="btn_help"
     tool_tip="Show a legend for the cast icons, A/B subjects, marks and path colors"
     width="18" />

    <!-- ============ cast column (persistent) ============ -->
    <scroll_list
     column_padding="0"
     draw_heading="true"
     follows="left|top|bottom"
     height="286"
     layout="topleft"
     left="8"
     multi_select="true"
     top="74"
     name="cast_list"
     tool_tip="The cast: right-click a row for subjects, marks and more. Multi-select drives batch Move-tab ops. A member's group shows as a suffix after the name"
     width="180">
        <columns
         label=""
         name="status"
         width="20" />
        <columns
         label="Actor"
         name="name"
         width="92" />
        <columns
         label="AB"
         name="ab"
         width="22" />
        <columns
         label="M"
         name="mark"
         width="24" />
    </scroll_list>
    <text
     follows="left|top"
     height="60"
     layout="topleft"
     left="14"
     top="110"
     mouse_opaque="false"
     name="cast_hint"
     text_color="LtGray_50"
     word_wrap="true"
     width="166">
        Right-click an avatar or animesh in world &gt; Add to Cast
    </text>
    <!-- group assign: tag the selected member(s); type a new name or pick an
         existing one (Enter commits, empty ungroups). Groups drive the Move
         tab's Start/Stop group transport. -->
    <text
     follows="left|bottom"
     height="16"
     layout="topleft"
     left="8"
     top="367"
     name="group_assign_lbl"
     width="42">
        Group
    </text>
    <combo_box
     allow_text_entry="true"
     follows="left|bottom"
     height="20"
     layout="topleft"
     left="52"
     max_chars="32"
     top="364"
     name="group_assign_combo"
     tool_tip="Group tag for the selected member(s): type a new name or pick an existing one, Enter commits. Empty ungroups"
     width="136" />
    <check_box
     control_name="ActorMoverShowHeading"
     follows="left|bottom"
     height="16"
     label="Show path"
     layout="topleft"
     left="8"
     top="390"
     name="show_heading_check"
     tool_tip="Show the in-world path preview for each cast actor. With a walkable path: the thick outlined spline with direction chevrons and numbered node markers (start green, end red, dwell nodes ringed). With no path: the thick straight heading ray along the planned bearing (m). Client-side only; tracks the heading dial live"
     width="170" />
    <button
     follows="left|bottom"
     height="22"
     label="+ You"
     layout="topleft"
     left="8"
     top="408"
     name="btn_add_you"
     tool_tip="Add your own avatar to the cast"
     width="54" />
    <button
     follows="left|bottom"
     height="22"
     label="Remove"
     layout="topleft"
     left="66"
     top="408"
     name="btn_remove"
     width="56" />
    <button
     follows="left|bottom"
     height="22"
     label="Focus"
     layout="topleft"
     left="126"
     top="408"
     name="btn_focus"
     tool_tip="Frame the selected cast member in the camera"
     width="62" />

    <!-- ============ left-rail tabs ============ -->
    <tab_container
     follows="all"
     height="550"
     layout="topleft"
     left="196"
     top="74"
     name="director_tabs"
     tab_height="22"
     tab_width="80"
     tab_group="1"
     tab_position="left"
     width="816">

        <!-- ============ Move tab ============ -->
        <panel
         follows="all"
         background_visible="false"
         height="550"
         label="Move"
         layout="topleft"
         name="move_tab"
         top="0"
         width="374">
            <!-- shared Actor Mover transport (ALPanelActorMover): scope,
                 heading compass dial, Speed/Distance/Cadence, End behavior,
                 custom walk anim, Walk/Stop. The SAME panel the standalone
                 Actor Mover floater embeds, so the two can never drift. The
                 persistent cast column to the left supplies the selection;
                 refreshMoveTab() feeds it to the panel each draw. -->
            <panel
             class="panel_actor_mover"
             filename="panel_actor_mover.xml"
             follows="left|top|right"
             height="360"
             layout="topleft"
             left="0"
             name="actor_mover_panel"
             top="0"
             width="374" />
            <!-- console-only group transport: Start/Stop every member of a
                 cast group at once (members are tagged via the Group box under
                 the cast list). Calls LLActorMover start()/stop() per member;
                 the group-scoped sibling of the shared panel's Walk/Stop, not
                 a fork of it. -->
            <text
             follows="left|top"
             height="16"
             layout="topleft"
             left="10"
             top="369"
             name="group_run_lbl"
             width="44">
                Group:
            </text>
            <combo_box
             follows="left|top"
             height="20"
             label="Group"
             layout="topleft"
             left="56"
             top="366"
             name="group_run_combo"
             tool_tip="The group Start/Stop act on"
             width="122" />
            <button
             follows="left|top"
             height="20"
             label="Start group"
             layout="topleft"
             left="184"
             top="366"
             name="btn_group_start"
             width="88" />
            <button
             follows="left|top"
             height="20"
             label="Stop group"
             layout="topleft"
             left="276"
             top="366"
             name="btn_group_stop"
             width="88" />
            <!-- Groups MANAGEMENT: every group at a glance (member count +
                 start delay), select a row to highlight its members in the
                 cast list and edit its delay / name below. Dissolve only
                 untags; nobody leaves the cast. Delays drive the staggered
                 starts (ACTION / Start group launch a delayed group's members
                 N seconds late) and save with the scene. -->
            <text
             follows="left|top"
             font="SansSerifSmallBold"
             height="14"
             layout="topleft"
             left="10"
             top="392"
             name="groups_lbl"
             width="120">
                Groups
            </text>
            <scroll_list
             column_padding="0"
             draw_heading="true"
             follows="left|top"
             height="76"
             layout="topleft"
             left="10"
             top="408"
             name="groups_list"
             tool_tip="Every group with its member count and start delay. Select a row to highlight its members in the cast list and load the delay / rename fields below"
             width="354">
                <columns
                 label="Group"
                 name="group"
                 width="180" />
                <columns
                 label="Members"
                 name="members"
                 width="70" />
                <columns
                 label="Delay"
                 name="delay"
                 width="80" />
            </scroll_list>
            <spinner
             decimal_digits="1"
             follows="left|top"
             height="20"
             increment="0.5"
             label="Delay (s)"
             label_width="52"
             layout="topleft"
             left="10"
             max_val="120"
             min_val="0"
             name="group_delay_spinner"
             tool_tip="Start delay for the selected group (s): ACTION and Start group launch its members this many seconds late (staggered starts). 0 = immediate. Saved with the scene"
             top="490"
             width="130" />
            <button
             follows="left|top"
             height="22"
             label="Dissolve"
             layout="topleft"
             left="264"
             top="488"
             name="btn_group_dissolve"
             tool_tip="Clear the selected group: every member is untagged (nobody is removed from the cast); its delay is dropped"
             width="100" />
            <line_editor
             commit_on_focus_lost="false"
             follows="left|top"
             height="20"
             layout="topleft"
             left="10"
             max_length_chars="32"
             name="group_rename_editor"
             tool_tip="New name for the selected group; Enter or Rename commits. Renaming onto an existing group merges them"
             top="516"
             width="248" />
            <button
             follows="left|top"
             height="22"
             label="Rename"
             layout="topleft"
             left="264"
             top="515"
             name="btn_group_rename"
             tool_tip="Rename the selected group to the name on the left (retags every member)"
             width="100" />
        </panel>

        <!-- ============ Path tab ============ -->
        <!-- The shared path editor is 716 tall (its Look-at / Gaze section
             sits at the very bottom). At the console's default height the tab
             viewport is shorter than that, so the editor is wrapped in a
             scroll_container (same idiom as the Camera tab) - every control,
             gaze included, is reachable without resizing the floater. -->
        <panel
         follows="all"
         background_visible="false"
         height="550"
         label="Path"
         layout="topleft"
         name="path_tab"
         top="0"
         width="374">
            <scroll_container
             follows="all"
             height="540"
             layout="topleft"
             left="0"
             top="0"
             name="path_scroll"
             opaque="false"
             width="374">
                <panel
                 background_visible="false"
                 height="732"
                 layout="topleft"
                 left="0"
                 top="0"
                 name="path_scroll_content"
                 width="354">
                    <panel
                     class="panel_path_editor"
                     filename="panel_path_editor.xml"
                     follows="left|top|right"
                     height="716"
                     layout="topleft"
                     left="0"
                     name="path_editor"
                     top="8"
                     width="354" />
                </panel>
            </scroll_container>
        </panel>

        <!-- ============ Ghosts tab ============ -->
        <!-- The shared Ghost Studio panel (panel_ghost_studio.xml): the SAME
             panel the standalone Ghost Studio floater hosts, so every overlay
             look (Ghost through Prism) is mirrored here automatically and the
             console remains a superset. Self-contained (it carries its own cast-source
             picker); nothing to feed it from the console. -->
        <panel
         follows="all"
         background_visible="false"
         height="550"
         label="Ghosts"
         layout="topleft"
         name="ghosts_tab"
         top="0"
         width="374">
            <panel
             class="panel_ghost_studio"
             filename="panel_ghost_studio.xml"
             follows="left|top|right"
             height="534"
             layout="topleft"
             left="0"
             name="ghost_studio_panel"
             top="8"
             width="354" />
        </panel>

        <!-- ============ Props tab ============ -->
        <!-- The shared Prop Mover panel (panel_prop_mover.xml): the SAME panel
             the standalone Prop Mover floater hosts, so the console is a
             superset. Self-contained (enrollment reads the in-world selection
             or the object context menu); nothing to feed it from the console. -->
        <panel
         follows="all"
         background_visible="false"
         height="550"
         label="Props"
         layout="topleft"
         name="props_tab"
         top="0"
         width="374">
            <panel
             class="panel_prop_mover"
             filename="panel_prop_mover.xml"
             follows="left|top|right"
             height="470"
             layout="topleft"
             left="0"
             name="prop_mover_panel"
             top="8"
             width="354" />
        </panel>

        <!-- ============ Animate tab ============ -->
        <!-- Top: the selected cast member's live signaled-animation list plus
             per-actor loco / play-local tools. Bottom: an embedded spinning
             preview (drag to orbit, wheel to zoom) that auto-plays the selected
             row / pasted UUID on loop, plus the Animation Explorer's own
             Capture-all / Stop / Stop and Revoke / Blacklist controls, so the
             console does everything the standalone Explorer can. -->
        <panel
         follows="all"
         background_visible="false"
         height="550"
         label="Animate"
         layout="topleft"
         name="animate_tab"
         top="0"
         width="374">
            <text
             follows="left|top"
             font="SansSerifBold"
             height="16"
             layout="topleft"
             left="10"
             top="8"
             name="animate_header"
             use_ellipses="true"
             width="354">
                No cast member selected
            </text>
            <scroll_list
             column_padding="0"
             draw_heading="true"
             follows="left|top|right"
             height="118"
             layout="topleft"
             left="10"
             top="28"
             name="anim_list"
             tool_tip="Animations currently signaled on the selected cast member. Right-click a row for actions"
             width="354">
                <columns
                 label="Animation UUID"
                 name="anim_id"
                 width="242" />
                <columns
                 label="Pri"
                 name="prio"
                 tool_tip="Animation priority when the motion is resolvable; ? otherwise"
                 width="30" />
                <columns
                 label="On"
                 name="playing"
                 tool_tip="Marker: the animation is actually playing right now"
                 width="28" />
            </scroll_list>
            <text
             follows="left|top"
             height="40"
             layout="topleft"
             left="20"
             top="60"
             mouse_opaque="false"
             name="anim_hint"
             text_color="LtGray_50"
             word_wrap="true"
             width="330">
                Select a cast member to see the animations playing on them
            </text>
            <button
             follows="left|top"
             height="20"
             label="Copy UUID"
             layout="topleft"
             left="10"
             top="150"
             name="btn_anim_copy"
             width="78" />
            <button
             follows="left|top"
             height="20"
             label="Set as loco"
             layout="topleft"
             left="92"
             top="150"
             name="btn_anim_setloco"
             width="88" />
            <button
             follows="left|top"
             height="20"
             label="Play local"
             layout="topleft"
             left="184"
             top="150"
             name="btn_anim_play"
             width="82" />
            <button
             follows="left|top"
             height="20"
             label="Stop local"
             layout="topleft"
             left="270"
             top="150"
             name="btn_anim_stop"
             width="82" />
            <text
             follows="left|top"
             height="14"
             layout="topleft"
             left="10"
             top="176"
             name="paste_lbl"
             width="354">
                Play any animation on the selected member (client-side only):
            </text>
            <line_editor
             follows="left|top|right"
             height="20"
             layout="topleft"
             left="10"
             top="192"
             max_length_chars="36"
             name="paste_uuid_editor"
             tool_tip="Animation asset UUID. Paste one from the Animation Explorer or your inventory. Also previews below on loop"
             width="354" />
            <button
             follows="left|top"
             height="20"
             label="Play local"
             layout="topleft"
             left="10"
             top="216"
             name="btn_paste_play"
             width="82" />
            <button
             follows="left|top"
             height="20"
             label="Stop local"
             layout="topleft"
             left="96"
             top="216"
             name="btn_paste_stop"
             width="82" />
            <button
             follows="left|top"
             height="20"
             label="Set as loco"
             layout="topleft"
             left="182"
             top="216"
             name="btn_paste_setloco"
             width="88" />
            <combo_box
             control_name="DirectorAnimPlayLocalPriority"
             follows="left|top"
             height="20"
             layout="topleft"
             left="274"
             top="216"
             name="play_local_priority_combo"
             tool_tip="Client-side priority both Play local actions use (the selected row and the pasted UUID). Local playback only; per-instance, so other avatars are unaffected. Baked keeps the animation's own priority; higher wins over lower when animations overlap."
             width="88">
                <combo_box.item label="Baked" name="dpl_baked" value="-1" />
                <combo_box.item label="Pri 0 - Low" name="dpl_low" value="0" />
                <combo_box.item label="Pri 1 - Medium" name="dpl_med" value="1" />
                <combo_box.item label="Pri 2 - High" name="dpl_high" value="2" />
                <combo_box.item label="Pri 3 - Higher" name="dpl_higher" value="3" />
                <combo_box.item label="Pri 4 - Highest" name="dpl_highest" value="4" />
            </combo_box>
            <text
             follows="left|top"
             height="14"
             layout="topleft"
             left="10"
             top="244"
             name="loco_text"
             tool_tip="The selected member's locomotion override: the animation the mover plays while walking them"
             use_ellipses="true"
             width="272">
                Loco anim: &#8212;
            </text>
            <button
             follows="left|top"
             height="20"
             label="Clear"
             layout="topleft"
             left="288"
             top="242"
             name="btn_clear_loco"
             width="66" />

            <!-- ==== shared preview pane + own-avatar controls ==== -->
            <!-- The spinning preview, its drag-to-rotate mouse handling, the
                 auto-loop, and the Capture-all / Stop / Stop and Revoke /
                 Blacklist controls are the shared ALPanelAnimPreview: the same
                 panel the standalone Animation Explorer floater embeds, so the
                 preview + mouse handling live in one place and cannot drift. -->
            <text
             follows="left|top"
             font="SansSerifBold"
             height="14"
             layout="topleft"
             left="10"
             top="270"
             name="preview_section_lbl"
             width="354">
                Preview &amp; animation control
            </text>
            <panel
             class="panel_anim_preview"
             filename="panel_anim_preview.xml"
             follows="left|top"
             height="188"
             layout="topleft"
             left="10"
             top="288"
             name="anim_preview_panel"
             width="354" />
            <!-- console-only: open the standalone Explorer (recent-anim list) -->
            <button
             follows="left|top"
             height="22"
             label="Open Animation Explorer"
             layout="topleft"
             left="200"
             top="482"
             name="btn_open_animexp"
             tool_tip="Open the standalone Animation Explorer (recent-animation list, name lookups)"
             width="164" />
        </panel>

        <!-- ============ Camera tab ============ -->
        <panel
         follows="all"
         background_visible="false"
         height="550"
         label="Camera"
         layout="topleft"
         name="camera_tab"
         top="0"
         width="374">
            <text
             follows="left|top"
             height="14"
             layout="topleft"
             left="10"
             top="8"
             name="subject_a_text"
             tool_tip="Subject A: the CineCam / orbit anchor. Set from the cast list's right-click menu or the button"
             use_ellipses="true"
             width="140">
                A:
            </text>
            <button
             follows="left|top"
             height="18"
             label="Set from selection"
             layout="topleft"
             left="152"
             top="5"
             name="btn_set_a"
             width="120" />
            <button
             follows="left|top"
             height="18"
             label="Clear"
             layout="topleft"
             left="276"
             top="5"
             name="btn_clear_a"
             width="52" />
            <text
             follows="left|top"
             height="14"
             layout="topleft"
             left="10"
             top="28"
             name="subject_b_text"
             tool_tip="Subject B: the second body for Two-Shot / Over-the-Shoulder"
             use_ellipses="true"
             width="140">
                B:
            </text>
            <button
             follows="left|top"
             height="18"
             label="Set from selection"
             layout="topleft"
             left="152"
             top="25"
             name="btn_set_b"
             width="120" />
            <button
