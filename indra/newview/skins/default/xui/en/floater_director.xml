<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Director Console (D2): ACTION/CUT transport + persistent cast column +
     left-rail Move / Path / Animate / Camera / Takes tabs (poser visual
     language).
     Pure view over LLDirectorCast and the machinima singletons; every
     parameter control is settings-backed, shared with the standalone
     floaters. -->
<floater
 legacy_header_height="18"
 can_resize="true"
 height="650"
 min_height="560"
 min_width="658"
 layout="topleft"
 name="floater_director"
 title="Director Console"
 save_rect="true"
 single_instance="true"
 width="658">

    <!-- ============ transport bar ============ -->
    <button
     follows="left|top"
     font="SansSerifBold"
     height="26"
     label="ACTION"
     layout="topleft"
     left="8"
     top="22"
     name="btn_action"
     width="110" />
    <button
     follows="left|top"
     font="SansSerifBold"
     height="26"
     image_color="0.85 0.25 0.25 1"
     label="CUT"
     label_color="White"
     layout="topleft"
     left="8"
     top="22"
     name="btn_cut"
     visible="false"
     width="110" />
    <spinner
     control_name="DirectorActionDelay"
     decimal_digits="1"
     follows="left|top"
     height="20"
     increment="0.5"
     label="Delay (s)"
     label_width="52"
     layout="topleft"
     left="126"
     max_val="10"
     min_val="0"
     top="26"
     name="delay_spinner"
     tool_tip="Countdown before ACTION fires (s), so a solo operator can get into frame. 0 = immediately"
     width="104" />
    <button
     follows="left|top"
     height="22"
     label="Set marks"
     layout="topleft"
     left="236"
     top="24"
     name="btn_set_marks"
     width="76" />
    <button
     follows="left|top"
     height="22"
     label="Reset to marks"
     layout="topleft"
     left="316"
     top="24"
     name="btn_reset_marks"
     width="100" />
    <combo_box
     follows="left|top"
     height="22"
     layout="topleft"
     left="420"
     top="24"
     name="scene_combo"
     tool_tip="Load a scene: restores cast, marks, loco anims, subjects and parameters"
     width="118" />
    <line_editor
     commit_on_focus_lost="false"
     follows="left|top"
     height="22"
     layout="topleft"
     left="420"
     top="24"
     max_length_chars="64"
     name="scene_name_editor"
     tool_tip="Scene name. Enter or Save writes the file; an empty name cancels"
     visible="false"
     width="118" />
    <button
     follows="left|top"
     height="22"
     label="Save"
     layout="topleft"
     left="542"
     top="24"
     name="btn_scene_save"
     tool_tip="Save the whole setup as a scene"
     width="44" />
    <button
     follows="left|top"
     height="22"
     label="X"
     layout="topleft"
     left="590"
     top="24"
     name="btn_scene_delete"
     tool_tip="Delete the selected scene file (asks to confirm)"
     width="22" />

    <!-- ============ arming row ============ -->
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="8"
     top="54"
     name="arming_lbl"
     width="74">
        Action fires:
    </text>
    <check_box
     control_name="DirectorArmMoves"
     follows="left|top"
     height="16"
     label="Actor moves"
     layout="topleft"
     left="84"
     top="53"
     name="arm_moves_check"
     tool_tip="ACTION starts a ghost walk for every cast member (you, if the cast is empty); CUT stops them"
     width="94" />
    <check_box
     control_name="DirectorArmCamera"
     follows="left|top"
     height="16"
     label="Camera"
     layout="topleft"
     left="182"
     top="53"
     name="arm_camera_check"
     tool_tip="ACTION enables the cinematic camera pattern; CUT restores the enable state it changed"
     width="76" />
    <check_box
     control_name="DirectorArmRecorderPlay"
     follows="left|top"
     height="16"
     label="Recorder play"
     layout="topleft"
     left="262"
     top="53"
     name="arm_play_check"
     tool_tip="ACTION starts Flycam Recorder playback of the loaded take; CUT stops it. Ignored while capture is also armed"
     width="104" />
    <check_box
     control_name="DirectorArmRecorderCapture"
     follows="left|top"
     height="16"
     label="Recorder capture"
     layout="topleft"
     left="370"
     top="53"
     name="arm_capture_check"
     tool_tip="ACTION starts a fresh camera capture (replaces the current take); CUT stops it. Beats recorder play when both are armed"
     width="124" />
    <button
     follows="right|top"
     font="SansSerifBold"
     height="18"
     label="?"
     layout="topleft"
     left="632"
     top="51"
     name="btn_help"
     tool_tip="Show a legend for the cast icons, A/B subjects, marks and path colors"
     width="18" />

    <!-- ============ cast column (persistent) ============ -->
    <scroll_list
     column_padding="0"
     draw_heading="true"
     follows="left|top|bottom"
     height="312"
     layout="topleft"
     left="8"
     multi_select="true"
     top="74"
     name="cast_list"
     tool_tip="The cast: right-click a row for subjects, marks and more. Multi-select drives batch Move-tab ops"
     width="180">
        <columns
         label=""
         name="status"
         width="20" />
        <columns
         label="Actor"
         name="name"
         width="92" />
        <columns
         label="AB"
         name="ab"
         width="22" />
        <columns
         label="M"
         name="mark"
         width="24" />
    </scroll_list>
    <text
     follows="left|top"
     height="60"
     layout="topleft"
     left="14"
     top="110"
     mouse_opaque="false"
     name="cast_hint"
     text_color="LtGray_50"
     word_wrap="true"
     width="166">
        Right-click an avatar or animesh in world &gt; Add to Cast
    </text>
    <check_box
     control_name="ActorMoverShowHeading"
     follows="left|bottom"
     height="16"
     label="Show path"
     layout="topleft"
     left="8"
     top="390"
     name="show_heading_check"
     tool_tip="Show the in-world path preview for each cast actor. With a walkable path: the thick outlined spline with direction chevrons and numbered node markers (start green, end red, dwell nodes ringed). With no path: the thick straight heading ray along the planned bearing (m). Client-side only; tracks the heading dial live"
     width="170" />
    <button
     follows="left|bottom"
     height="22"
     label="+ You"
     layout="topleft"
     left="8"
     top="408"
     name="btn_add_you"
     tool_tip="Add your own avatar to the cast"
     width="54" />
    <button
     follows="left|bottom"
     height="22"
     label="Remove"
     layout="topleft"
     left="66"
     top="408"
     name="btn_remove"
     width="56" />
    <button
     follows="left|bottom"
     height="22"
     label="Focus"
     layout="topleft"
     left="126"
     top="408"
     name="btn_focus"
     tool_tip="Frame the selected cast member in the camera"
     width="62" />

    <!-- ============ left-rail tabs ============ -->
    <tab_container
     follows="all"
     height="550"
     layout="topleft"
     left="196"
     top="74"
     name="director_tabs"
     tab_height="22"
     tab_width="80"
     tab_group="1"
     tab_position="left"
     width="454">

        <!-- ============ Move tab ============ -->
        <panel
         follows="all"
         background_visible="false"
         height="360"
         label="Move"
         layout="topleft"
         name="move_tab"
         top="0"
         width="374">
            <!-- shared Actor Mover transport (ALPanelActorMover): scope,
                 heading compass dial, Speed/Distance/Cadence, End behavior,
                 custom walk anim, Walk/Stop. The SAME panel the standalone
                 Actor Mover floater embeds, so the two can never drift. The
                 persistent cast column to the left supplies the selection;
                 refreshMoveTab() feeds it to the panel each draw. -->
            <panel
             class="panel_actor_mover"
             filename="panel_actor_mover.xml"
             follows="all"
             height="360"
             layout="topleft"
             left="0"
             name="actor_mover_panel"
             top="0"
             width="374" />
        </panel>

        <!-- ============ Path tab ============ -->
        <!-- The shared path editor is 656 tall (its Look-at / Gaze section
             sits at the very bottom). At the console's default height the tab
             viewport is shorter than that, so the editor is wrapped in a
             scroll_container (same idiom as the Camera tab) - every control,
             gaze included, is reachable without resizing the floater. -->
        <panel
         follows="all"
         background_visible="false"
         height="550"
         label="Path"
         layout="topleft"
         name="path_tab"
         top="0"
         width="374">
            <scroll_container
             follows="all"
             height="540"
             layout="topleft"
             left="0"
             top="0"
             name="path_scroll"
             opaque="false"
             width="374">
                <panel
                 background_visible="false"
                 height="672"
                 layout="topleft"
                 left="0"
                 top="0"
                 name="path_scroll_content"
                 width="354">
                    <panel
                     class="panel_path_editor"
                     filename="panel_path_editor.xml"
                     follows="left|top|right"
                     height="656"
                     layout="topleft"
                     left="0"
                     name="path_editor"
                     top="8"
                     width="354" />
                </panel>
            </scroll_container>
        </panel>

        <!-- ============ Animate tab ============ -->
        <!-- Top: the selected cast member's live signaled-animation list plus
             per-actor loco / play-local tools. Bottom: an embedded spinning
             preview (drag to orbit, wheel to zoom) that auto-plays the selected
             row / pasted UUID on loop, plus the Animation Explorer's own
             Capture-all / Stop / Stop and Revoke / Blacklist controls, so the
             console does everything the standalone Explorer can. -->
        <panel
         follows="all"
         background_visible="false"
         height="360"
         label="Animate"
         layout="topleft"
         name="animate_tab"
         top="0"
         width="374">
            <text
             follows="left|top"
             font="SansSerifBold"
             height="16"
             layout="topleft"
             left="10"
             top="8"
             name="animate_header"
             use_ellipses="true"
             width="354">
                No cast member selected
            </text>
            <scroll_list
             column_padding="0"
             draw_heading="true"
             follows="left|top|right"
             height="118"
             layout="topleft"
             left="10"
             top="28"
             name="anim_list"
             tool_tip="Animations currently signaled on the selected cast member. Right-click a row for actions"
             width="354">
                <columns
                 label="Animation UUID"
                 name="anim_id"
                 width="242" />
                <columns
                 label="Pri"
                 name="prio"
                 tool_tip="Animation priority when the motion is resolvable; ? otherwise"
                 width="30" />
                <columns
                 label="On"
                 name="playing"
                 tool_tip="Marker: the animation is actually playing right now"
                 width="28" />
            </scroll_list>
            <text
             follows="left|top"
             height="40"
             layout="topleft"
             left="20"
             top="60"
             mouse_opaque="false"
             name="anim_hint"
             text_color="LtGray_50"
             word_wrap="true"
             width="330">
                Select a cast member to see the animations playing on them
            </text>
            <button
             follows="left|top"
             height="20"
             label="Copy UUID"
             layout="topleft"
             left="10"
             top="150"
             name="btn_anim_copy"
             width="78" />
            <button
             follows="left|top"
             height="20"
             label="Set as loco"
             layout="topleft"
             left="92"
             top="150"
             name="btn_anim_setloco"
             width="88" />
            <button
             follows="left|top"
             height="20"
             label="Play local"
             layout="topleft"
             left="184"
             top="150"
             name="btn_anim_play"
             width="82" />
            <button
             follows="left|top"
             height="20"
             label="Stop local"
             layout="topleft"
             left="270"
             top="150"
             name="btn_anim_stop"
             width="82" />
            <text
             follows="left|top"
             height="14"
             layout="topleft"
             left="10"
             top="176"
             name="paste_lbl"
             width="354">
                Play any animation on the selected member (client-side only):
            </text>
            <line_editor
             follows="left|top|right"
             height="20"
             layout="topleft"
             left="10"
             top="192"
             max_length_chars="36"
             name="paste_uuid_editor"
             tool_tip="Animation asset UUID. Paste one from the Animation Explorer or your inventory. Also previews below on loop"
             width="354" />
            <button
             follows="left|top"
             height="20"
             label="Play local"
             layout="topleft"
             left="10"
             top="216"
             name="btn_paste_play"
             width="82" />
            <button
             follows="left|top"
             height="20"
             label="Stop local"
             layout="topleft"
             left="96"
             top="216"
             name="btn_paste_stop"
             width="82" />
            <button
             follows="left|top"
             height="20"
             label="Set as loco"
             layout="topleft"
             left="182"
             top="216"
             name="btn_paste_setloco"
             width="88" />
            <text
             follows="left|top"
             height="14"
             layout="topleft"
             left="10"
             top="244"
             name="loco_text"
             tool_tip="The selected member's locomotion override: the animation the mover plays while walking them"
             use_ellipses="true"
             width="272">
                Loco anim: &#8212;
            </text>
            <button
             follows="left|top"
             height="20"
             label="Clear"
             layout="topleft"
             left="288"
             top="242"
             name="btn_clear_loco"
             width="66" />

            <!-- ==== shared preview pane + own-avatar controls ==== -->
            <!-- The spinning preview, its drag-to-rotate mouse handling, the
                 auto-loop, and the Capture-all / Stop / Stop and Revoke /
                 Blacklist controls are the shared ALPanelAnimPreview: the same
                 panel the standalone Animation Explorer floater embeds, so the
                 preview + mouse handling live in one place and cannot drift. -->
            <text
             follows="left|top"
             font="SansSerifBold"
             height="14"
             layout="topleft"
             left="10"
             top="270"
             name="preview_section_lbl"
             width="354">
                Preview &amp; animation control
            </text>
            <panel
             class="panel_anim_preview"
             filename="panel_anim_preview.xml"
             follows="left|top"
             height="188"
             layout="topleft"
             left="10"
             top="288"
             name="anim_preview_panel"
             width="354" />
            <!-- console-only: open the standalone Explorer (recent-anim list) -->
            <button
             follows="left|top"
             height="22"
             label="Open Animation Explorer"
             layout="topleft"
             left="200"
             top="482"
             name="btn_open_animexp"
             tool_tip="Open the standalone Animation Explorer (recent-animation list, name lookups)"
             width="164" />
        </panel>

        <!-- ============ Camera tab ============ -->
        <panel
         follows="all"
         background_visible="false"
         height="360"
         label="Camera"
         layout="topleft"
         name="camera_tab"
         top="0"
         width="374">
            <text
             follows="left|top"
             height="14"
             layout="topleft"
             left="10"
             top="8"
             name="subject_a_text"
             tool_tip="Subject A: the CineCam / orbit anchor. Set from the cast list's right-click menu or the button"
             use_ellipses="true"
             width="140">
                A:
            </text>
            <button
             follows="left|top"
             height="18"
             label="Set from selection"
             layout="topleft"
             left="152"
             top="5"
             name="btn_set_a"
             width="120" />
            <button
             follows="left|top"
             height="18"
             label="Clear"
             layout="topleft"
             left="276"
             top="5"
             name="btn_clear_a"
             width="52" />
            <text
             follows="left|top"
             height="14"
             layout="topleft"
             left="10"
             top="28"
             name="subject_b_text"
             tool_tip="Subject B: the second body for Two-Shot / Over-the-Shoulder"
             use_ellipses="true"
             width="140">
                B:
            </text>
            <button
             follows="left|top"
             height="18"
             label="Set from selection"
             layout="topleft"
             left="152"
             top="25"
             name="btn_set_b"
             width="120" />
            <button
             follows="left|top"
             height="18"
             label="Clear"
             layout="topleft"
             left="276"
             top="25"
             name="btn_clear_b"
             width="52" />
            <scroll_container
             follows="all"
             height="312"
             layout="topleft"
             left="0"
             top="48"
             name="camera_scroll"
             opaque="false"
             width="374">
                <panel
                 background_visible="false"
                 height="484"
                 layout="topleft"
                 left="0"
                 top="0"
                 name="camera_scroll_content"
                 width="354">
                    <panel
                     class="panel_cinecam_params"
                     filename="panel_cinecam_params.xml"
                     follows="left|top"
                     height="262"
                     layout="topleft"
                     left="0"
                     top="0"
                     name="cinecam_params_embedded"
                     width="320" />
                    <panel
                     class="panel_flycam_orbit"
                     filename="panel_flycam_orbit.xml"
                     follows="left|top"
                     height="214"
                     layout="topleft"
                     left="6"
                     top="266"
                     name="flycam_orbit_embedded"
                     width="320" />
                </panel>
            </scroll_container>
        </panel>

        <!-- ============ Takes tab ============ -->
        <!-- Transport + controls are the shared ALPanelFlycamRecorder
             (panel_flycam_recorder.xml), the same panel the standalone Flycam
             Recorder floater embeds -> identical UI, one LLFlycamRecorder
             singleton, no hand-copied widgets to drift. -->
        <panel
         follows="all"
         background_visible="false"
         height="360"
         label="Takes"
         layout="topleft"
         name="takes_tab"
         top="0"
         width="374">
            <panel
             class="panel_flycam_recorder"
             filename="panel_flycam_recorder.xml"
             follows="left|top"
             height="314"
             layout="topleft"
             left="8"
             top="6"
             name="flycam_recorder_embedded"
             width="320" />
        </panel>
    </tab_container>

    <!-- ============ status strip ============ -->
    <text
     follows="left|bottom"
     height="14"
     layout="topleft"
     left="8"
     top="440"
     name="status_strip"
     width="548">
        0 moving
    </text>
    <text
     follows="right|bottom"
     halign="right"
     height="14"
     layout="topleft"
     left="576"
     top="440"
     name="rec_indicator"
     tool_tip="Recorder capture indicator: red while a take is being captured"
     width="74">
        REC
    </text>

    <!-- ============ legend popover (toggled by the ? button) ============ -->
    <panel
     background_opaque="true"
     background_visible="true"
     border="true"
     follows="left|top"
     height="196"
     layout="topleft"
     left="210"
     name="legend_panel"
     top="110"
     visible="false"
     width="424">
        <text
         follows="left|top"
         font="SansSerifBold"
         height="16"
         layout="topleft"
         left="12"
         top="10"
         name="legend_title"
         width="300">
            Director Console legend
        </text>
        <text
         follows="left|top|right"
         height="150"
         layout="topleft"
         left="12"
         top="30"
         name="legend_body"
         word_wrap="true"
         width="400">
Status column: a walking figure means the actor is moving, a green dot means idle and in world, a gray dot means the actor is not in world (shown "(away)").

AB column: A marks Subject A and B marks Subject B, the bodies the cinematic camera frames. Set them from the cast right-click menu, the Camera tab, or by double-clicking a cast row (sets Subject A).

M column: a flag means a mark (a saved position) is set for that actor.

Paths: each actor's in-world path preview and its numbered nodes are drawn in a stable per-actor color, so overlapping routes stay readable.
        </text>
        <button
         follows="left|top"
         height="20"
         label="Close"
         layout="topleft"
         left="12"
         top="168"
         name="btn_legend_close"
         width="60" />
    </panel>
</floater>
