<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Standalone host for the shared Ghost Studio panel; the Director Console
     embeds the SAME panel in its Ghosts tab (superset rule), so this floater
     is pure chrome: a plain LLFloater, same idiom as the Flycam Recorder. -->
<floater
 legacy_header_height="18"
 can_resize="true"
 height="470"
 min_height="330"
 min_width="380"
 layout="topleft"
 name="floater_ghost_studio"
 title="GHOST STUDIO (LOCAL)"
 width="380">
  <panel
   class="panel_ghost_studio"
   filename="panel_ghost_studio.xml"
   follows="all"
   height="440"
   layout="topleft"
   left="8"
   top="24"
   name="ghost_studio_panel"
   width="360" />
</floater>
