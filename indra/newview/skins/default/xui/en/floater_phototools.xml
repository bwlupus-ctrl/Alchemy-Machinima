<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
    Phototools: EEP environment quick-switcher, DoF focus point
    lock/follow/crosshair, and rule-of-thirds/golden-ratio composition guide
    overlay.

    Ported from Firestorm's floater_phototools.xml (donor: I:\enve
    indra/newview/skins/default/xui/en/floater_phototools.xml) for the
    BD/Alchemy merge campaign, item F4 (+F8). Thinned to a from-scratch
    layout: the donor's per-axis Vignette/shadow/SSAO sliders and avatar
    Z-offset/max complexity sliders are pruned because Alchemy already
    exposes the same debug settings on floater_lightbox_settings.xml's
    Rendering tab, panel_quick_settings.xml, and
    floater_preferences_graphics_advanced.xml - see the F4/F8 campaign
    report's pruned-control list. Depth-of-field WYSIWYG fix, focus point
    lock/crosshair, and composition guide overlay by William Weaver
    ("paperwork").
-->
<floater
    width="360"
    height="330"
    layout="topleft"
    min_height="280"
    min_width="330"
    name="floater_phototools"
    positioning="cascading"
    title="PHOTOTOOLS"
    save_rect="true"
    can_resize="true"
    can_resize_height="true">
    <tab_container
        top_pad="0"
        enabled="true"
        follows="all"
        height="300"
        mouse_opaque="false"
        name="phototools_tab_container"
        tab_position="top"
        tab_min_width="80"
        width="360">
        <!-- ===================== Environment tab ===================== -->
        <panel
            label="Environment"
            layout="topleft"
            name="phototools_environment"
            can_resize="false">
            <text
                name="sky_label"
                layout="topleft"
                follows="left|top"
                left="10"
                top="10"
                height="15"
                width="60">
                Sky:
            </text>
            <combo_box
                name="WLPresetsCombo"
                layout="topleft"
                follows="left|top|right"
                left_pad="5"
                top_delta="-2"
                height="23"
                width="220" />
            <button
                name="WLPrevPreset"
                layout="topleft"
                follows="right|top"
                left_pad="4"
                top_delta="0"
                width="20"
                height="23"
                label="&lt;" />
            <button
                name="WLNextPreset"
                layout="topleft"
                follows="right|top"
                left_pad="2"
                top_delta="0"
                width="20"
                height="23"
                label="&gt;" />

            <text
                name="water_label"
                layout="topleft"
                follows="left|top"
                left="10"
                top_pad="10"
                height="15"
                width="60">
                Water:
            </text>
            <combo_box
                name="WaterPresetsCombo"
                layout="topleft"
                follows="left|top|right"
                left_pad="5"
                top_delta="-2"
                height="23"
                width="220" />
            <button
                name="WWPrevPreset"
                layout="topleft"
                follows="right|top"
                left_pad="4"
                top_delta="0"
                width="20"
                height="23"
                label="&lt;" />
            <button
                name="WWNextPreset"
                layout="topleft"
                follows="right|top"
                left_pad="2"
                top_delta="0"
                width="20"
                height="23"
                label="&gt;" />

            <text
                name="daycycle_label"
                layout="topleft"
                follows="left|top"
                left="10"
                top_pad="10"
                height="15"
                width="60">
                Day Cycle:
            </text>
            <combo_box
                name="DCPresetsCombo"
                layout="topleft"
                follows="left|top|right"
                left_pad="5"
                top_delta="-2"
                height="23"
                width="220" />
            <button
                name="DCPrevPreset"
                layout="topleft"
                follows="right|top"
                left_pad="4"
                top_delta="0"
                width="20"
                height="23"
                label="&lt;" />
            <button
                name="DCNextPreset"
                layout="topleft"
                follows="right|top"
                left_pad="2"
                top_delta="0"
                width="20"
                height="23"
                label="&gt;" />

            <button
                name="ResetToRegionDefault"
                layout="topleft"
                follows="left|top"
                left="10"
                top_pad="16"
                height="23"
                width="180"
                label="Reset to Region Default" />
        </panel>
        <!-- =================== Focus &amp; Guides tab =================== -->
        <panel
            label="Focus &amp; Guides"
            layout="topleft"
            name="phototools_focus_guides"
            can_resize="false">
            <text
                name="dof_section_label"
                layout="topleft"
                follows="left|top"
                left="10"
                top="10"
                height="15"
                width="300"
                font="SansSerifBold">
                Depth of Field
            </text>
            <check_box
                name="UseDepthOfField"
                layout="topleft"
                follows="left|top"
                left="15"
                top_pad="6"
                height="16"
                width="300"
                label="Enable Depth of Field"
                control_name="RenderDepthOfField" />
            <check_box
                name="FocusLock"
                layout="topleft"
                follows="left|top"
                left="15"
                top_pad="4"
                height="16"
                width="300"
                label="Lock Focus Point (Alt+Shift+X)"
                tool_tip="Freezes the depth-of-field focus target at its current position instead of tracking the camera's alt-zoom/mouselook target."
                control_name="RenderFocusPointLocked" />
            <check_box
                name="FocusFollowsPointer"
                layout="topleft"
                follows="left|top"
                left="15"
                top_pad="4"
                height="16"
                width="300"
                label="Focus Follows Pointer"
                tool_tip="Depth-of-field focus target follows the point under the mouse cursor instead of the camera's alt-zoom target."
                control_name="RenderFocusPointFollowsPointer" />
            <check_box
                name="FocusCrosshair"
                layout="topleft"
                follows="left|top"
                left="15"
                top_pad="4"
                height="16"
                width="300"
                label="Show Focus Crosshair"
                tool_tip="Draws a small crosshair at the current depth-of-field focus point (red while locked, yellow otherwise). Never appears in snapshots."
                control_name="RenderFocusPointCrosshair" />

            <text
                name="guides_section_label"
                layout="topleft"
                follows="left|top"
                left="10"
                top_pad="14"
                height="15"
                width="300"
                font="SansSerifBold">
                Composition Guide
            </text>
            <check_box
                name="ShowGuides"
                layout="topleft"
                follows="left|top"
                left="15"
                top_pad="6"
                height="16"
                width="300"
                label="Show Composition Guide"
                tool_tip="Overlays a rule-of-thirds, golden ratio, or diagonal framing guide on the 3D view. Never appears in snapshots."
                control_name="RenderCompositionGuide" />
            <combo_box
                name="GuideStyle"
                layout="topleft"
                follows="left|top"
                left="15"
                top_pad="6"
                height="23"
                width="180"
                control_name="RenderCompositionGuideStyle">
                <combo_box.item
                    name="rule_of_thirds"
                    label="Rule of Thirds"
                    value="rule_of_thirds" />
                <combo_box.item
                    name="golden_ratio_top_left"
                    label="Golden Ratio (Top Left)"
                    value="golden_ratio_top_left" />
                <combo_box.item
                    name="golden_ratio_top_right"
                    label="Golden Ratio (Top Right)"
                    value="golden_ratio_top_right" />
                <combo_box.item
                    name="golden_ratio_bottom_left"
                    label="Golden Ratio (Bottom Left)"
                    value="golden_ratio_bottom_left" />
                <combo_box.item
                    name="golden_ratio_bottom_right"
                    label="Golden Ratio (Bottom Right)"
                    value="golden_ratio_bottom_right" />
                <combo_box.item
                    name="diagonal"
                    label="Diagonal"
                    value="diagonal" />
            </combo_box>
            <color_swatch
                name="GuideColor"
                layout="topleft"
                follows="right|top"
                left_pad="10"
                top_delta="0"
                width="40"
                height="23"
                can_apply_immediately="true"
                label=""
                control_name="RenderCompositionGuideColor" />

            <text
                name="guide_thickness_label"
                layout="topleft"
                follows="left|top"
                left="15"
                top_pad="8"
                height="15"
                width="80">
                Thickness:
            </text>
            <spinner
                name="GuideThickness"
                layout="topleft"
                follows="left|top"
                left_pad="4"
                top_delta="-2"
                height="20"
                width="80"
                decimal_digits="1"
                increment="0.1"
                min_val="0.0"
                max_val="20.0"
                control_name="RenderCompositionGuideWidth" />

            <text
                name="guide_opacity_label"
                layout="topleft"
                follows="left|top"
                left="15"
                top_pad="8"
                height="15"
                width="80">
                Opacity:
            </text>
            <slider
                name="GuideOpacity"
                layout="topleft"
                follows="left|top|right"
                left_pad="4"
                top_delta="-2"
                height="20"
                width="150"
                min_val="0.0"
                max_val="1.0"
                decimal_digits="2"
                control_name="RenderCompositionGuideVisibility" />

            <button
                name="OpenLightbox"
                layout="topleft"
                follows="left|bottom"
                left="15"
                bottom="10"
                height="23"
                width="220"
                label="More Rendering Settings..."
                tool_tip="Opens the Lightbox floater for full shadow/SSAO/vignette/tonemap control.">
                <button.commit_callback
                    function="Floater.Toggle"
                    parameter="lightbox" />
            </button>
        </panel>
    </tab_container>
</floater>
