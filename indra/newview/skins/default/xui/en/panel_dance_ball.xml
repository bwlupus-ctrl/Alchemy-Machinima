<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Dance Ball. Session-local, client-only multi-avatar dance playback
     (aldanceball.h). ALPanelDanceBall (alpaneldanceball.cpp) owns all wiring.
     Nothing here is sent to the simulator: only you see the dancing.
     Tab pages are wrapped and fitted at runtime by ALScrollFit
     (installForTabs), so tab contents may be taller than the tab. -->
