<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Flycam Orbit rig (ALPanelFlycamOrbit, class "panel_flycam_orbit"): enable,
     anchor hint, the Cinematic Cam joint + target-selected anchor controls, level
     horizon, min/max radius, smoothing, lens zoom, and up/left focus offsets.
     Embedded by BOTH the standalone Flycam Orbit floater and the Director Console
     Camera tab; every control is settings-backed (control_name) so live instances
     stay in sync through gSavedSettings and can never drift apart. -->
<panel
 background_visible="false"
 border="false"
 height="248"
 layout="topleft"
 name="panel_flycam_orbit"
 width="320">
    <check_box
     control_name="FlycamOrbitEnabled"
     follows="left|top"
     height="18"
     label="Enable Flycam Orbit"
     layout="topleft"
     left="12"
     top="4"
     name="FlycamOrbitEnabled"
     tool_tip="While in flycam: orbit, pan and dolly relative to the anchor joint instead of free flight. Uncheck for normal flycam."
     width="167" />
    <button top="4" left="180" follows="left|top" height="18" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_FlycamOrbitEnabled" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOrbitEnabled" />
    <text top="26"
     follows="left|top"
     halign="left"
     height="48"
     layout="topleft"
     left="12"
    
     width="296"
     word_wrap="true"
     text_color="LtGray_50"
     name="anchor_hint">
        Anchor: Cinematic Cam target + joint. Right-click an avatar &gt; Cinematic Cam Follow, or use Target selected.
    </text>
    <combo_box top="80"
     allow_text_entry="true"
     control_name="CinematicCamJoint"
     follows="left|top"
     height="20"
     layout="topleft"
     left="12"
    
     name="CinematicCamJoint"
     tool_tip="Skeleton joint to anchor the orbit on (type any joint name, including Bento bones)"
     width="127">
        <combo_box.item label="mHead" name="j_head" value="mHead" />
        <combo_box.item label="mNeck" name="j_neck" value="mNeck" />
        <combo_box.item label="mChest" name="j_chest" value="mChest" />
        <combo_box.item label="mTorso" name="j_torso" value="mTorso" />
        <combo_box.item label="mPelvis" name="j_pelvis" value="mPelvis" />
        <combo_box.item label="mShoulderRight" name="j_shr" value="mShoulderRight" />
        <combo_box.item label="mElbowRight" name="j_elr" value="mElbowRight" />
        <combo_box.item label="mWristRight" name="j_wrr" value="mWristRight" />
        <combo_box.item label="mShoulderLeft" name="j_shl" value="mShoulderLeft" />
        <combo_box.item label="mWristLeft" name="j_wrl" value="mWristLeft" />
        <combo_box.item label="mHipRight" name="j_hipr" value="mHipRight" />
        <combo_box.item label="mKneeRight" name="j_kner" value="mKneeRight" />
        <combo_box.item label="mFootRight" name="j_footr" value="mFootRight" />
        <combo_box.item label="mFootLeft" name="j_footl" value="mFootLeft" />
    </combo_box>
    <button top="80" left="140" follows="left|top" height="20" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_CinematicCamJoint" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="CinematicCamJoint" />
    <check_box top="106" left="12"
     control_name="CinematicCamUseSelected"
     follows="left|top"
     height="16"
     label="Target selected avatar"
     layout="topleft"
    
    
     name="CinematicCamUseSelected"
     tool_tip="Anchor on the selected avatar instead of yourself (falls back to you if nothing valid is selected)"
     width="168" />
    <button top="106" left="182" follows="left|top" height="16" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_CinematicCamUseSelected" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="CinematicCamUseSelected" />
    <check_box top="128"
     control_name="FlycamOrbitLevel"
     follows="left|top"
     height="16"
     label="Level horizon"
     layout="topleft"
     left="12"
    
     name="FlycamOrbitLevel"
     tool_tip="Keep the orbit ring horizontal (ignore bone roll/pitch). Off = ride the full bone frame, GoPro-style"
     width="137" />
    <button top="128" left="150" follows="left|top" height="16" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_FlycamOrbitLevel" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOrbitLevel" />
    <spinner top="150"
     control_name="FlycamOrbitMinRadius"
     decimal_digits="2"
     follows="left|top"
     height="16"
     increment="0.1"
     label="Min radius"
     label_width="70"
     layout="topleft"
     left="12"
     max_val="10"
     min_val="0.05"
    
     name="FlycamOrbitMinRadius"
     tool_tip="Closest the dolly can approach the anchor (m)"
     width="127" />
    <button top="150" left="140" follows="left|top" height="16" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_FlycamOrbitMinRadius" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOrbitMinRadius" />
    <spinner top="150" left="162"
     control_name="FlycamOrbitMaxRadius"
     decimal_digits="1"
     follows="left|top"
     height="16"
     increment="0.5"
     label="Max radius"
     label_width="70"
     layout="topleft"
    
     max_val="200"
     min_val="0.5"
    
     name="FlycamOrbitMaxRadius"
     tool_tip="Farthest the dolly can retreat from the anchor (m)"
     width="133" />
    <button top="150" left="296" follows="left|top" height="16" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_FlycamOrbitMaxRadius" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOrbitMaxRadius" />
    <slider top="176"
     control_name="FlycamOrbitSmoothing"
     decimal_digits="2"
     follows="left|top"
     height="16"
     increment="0.01"
     initial_value="0.15"
     label="Smoothing (s)"
     label_width="90"
     layout="topleft"
     left="12"
     max_val="2"
     min_val="0"
    
     name="FlycamOrbitSmoothing"
     tool_tip="Temporal smoothing of the anchor motion only. 0 = rigid lock, higher = steadicam glide"
     width="283" />
    <button top="176" left="296" follows="left|top" height="16" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_FlycamOrbitSmoothing" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOrbitSmoothing" />
    <slider top="200"
     control_name="FlycamOrbitZoom"
     decimal_digits="2"
     follows="left|top"
     height="16"
     increment="0.05"
     initial_value="1.0"
     label="Lens (zoom &#215;)"
     label_width="90"
     layout="topleft"
     left="12"
     max_val="2"
     min_val="0.2"
    
     name="FlycamOrbitZoom"
     tool_tip="FOV multiplier while orbiting only: below 1 = tighter/telephoto, above 1 = wider, 1 = unchanged. Free-flight zoom is untouched"
     width="283" />
    <button top="200" left="296" follows="left|top" height="16" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_FlycamOrbitZoom" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOrbitZoom" />
    <spinner top="226"
     control_name="FlycamOrbitOffsetUp"
     decimal_digits="2"
     follows="left|top"
     height="16"
     increment="0.05"
     label="Up"
     label_width="30"
     layout="topleft"
     left="12"
     max_val="2"
     min_val="-2"
    
     name="FlycamOrbitOffsetUp"
     tool_tip="Shift the anchor focus point upward (m): frame higher/lower on the body"
     width="127" />
    <button top="226" left="140" follows="left|top" height="16" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_FlycamOrbitOffsetUp" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOrbitOffsetUp" />
    <spinner top="226" left="162"
     control_name="FlycamOrbitOffsetLeft"
     decimal_digits="2"
     follows="left|top"
     height="16"
     increment="0.05"
     label="Left"
     label_width="34"
     layout="topleft"
    
     max_val="2"
     min_val="-2"
    
     name="FlycamOrbitOffsetLeft"
     tool_tip="Shift the anchor focus point to the left (m): off-center framing"
     width="133" />
    <button top="226" left="296" follows="left|top" height="16" width="12" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" name="reset_FlycamOrbitOffsetLeft" tool_tip="Reset to default" commit_callback.function="Machinima.ResetControl" commit_callback.parameter="FlycamOrbitOffsetLeft" />
</panel>
