<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- [EnvIntensity userpresets] Save / Load / Delete floater for the Personal Lighting
     Light Intensity presets (alfloaterenvintensitypresets.cpp). Absolute left/top layout. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="false"
 height="258"
 layout="topleft"
 name="env_intensity_presets"
 save_rect="true"
 single_instance="true"
 title="LIGHT INTENSITY PRESETS"
 width="300">
    <text
     follows="left|top"
     height="14"
     layout="topleft"
     left="10"
     name="list_label"
     top="28"
     width="280">
        My presets (double-click to load):
    </text>
    <scroll_list
     can_sort="false"
     draw_heading="false"
     follows="left|top"
     height="134"
     layout="topleft"
     left="10"
     multi_select="false"
     name="preset_list"
     tool_tip="Your saved Light Intensity presets. Select one to Load or Delete it; double-click loads it."
     top="44"
     width="280">
        <scroll_list.columns
         dynamic_width="true"
         label="Name"
         name="name" />
    </scroll_list>
    <text
     follows="left|top"
     height="14"
     layout="topleft"
     left="10"
     name="name_label"
     top="184"
     width="280">
        Preset name:
    </text>
    <line_editor
     commit_on_focus_lost="false"
     follows="left|top"
     height="20"
     layout="topleft"
     left="10"
     max_length_bytes="256"
     name="preset_name"
     tool_tip="Name for the preset (up to 64 characters). Save stores the current Light Intensity settings under this name; an existing name asks before overwriting. Enter also saves."
     top="200"
     width="280" />
    <button
     follows="left|top"
     height="23"
     label="Save"
     layout="topleft"
     left="10"
     name="btn_save"
     tool_tip="Save the current Light Intensity settings (Sun / Moon, GI, probes, local lights, Kelvin, tints, shadow lift) under the name above"
     top="226"
     width="64" />
    <button
     follows="left|top"
     height="23"
     label="Load"
     layout="topleft"
     left="80"
     name="btn_load"
     tool_tip="Apply the selected preset to the Light Intensity settings"
     top="226"
     width="64" />
    <button
     follows="left|top"
     height="23"
     label="Delete"
     layout="topleft"
     left="150"
     name="btn_delete"
     tool_tip="Delete the selected preset (asks first)"
     top="226"
     width="64" />
    <button
     follows="left|top"
     height="23"
     label="Close"
     layout="topleft"
     left="226"
     name="btn_close"
     top="226"
     width="64" />
</floater>
