  <!-- [Director] Machinima tools for my own avatar, consolidated. Every item
       resolves the clicked avatar (here, self) via find_avatar_from_object and
       shares the Director cast state. Subjects and marks are cast members, so
       their setters add to the cast when needed. Attachments Alpha is the
       avatar-wide session alpha override (all my attachments; a per-object
       override still beats it). Client-side, session-only. -->
  <context_menu
   label="Director"
   layout="topleft"
   name="Director">
    <menu_item_check
      label="Add to Cast"
      name="Add To Cast">
      <menu_item_check.on_click
        function="Avatar.AddToCast" />
      <menu_item_check.on_check
        function="Avatar.CheckAddToCast" />
      <menu_item_check.on_enable
        function="Avatar.EnableAlphaMode" />
    </menu_item_check>
    <menu_item_check
