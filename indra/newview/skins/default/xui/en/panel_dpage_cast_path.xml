            </kit_row>
            <kit_row bind="code" decimals="1" help="Seconds the walk takes to slow down at the end." increment="0.5" keywords="ease out stop decelerate seconds" kind="number" label="Ease out (s)" max_val="10" min_val="0" unit="s" widget="path_easeout_spinner" widget_history="false">
                <spinner name="path_easeout_spinner" decimal_digits="1" increment="0.5" max_val="10" min_val="0" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" decimals="2" help="How smoothly the path rounds its corners, from 0 to 1." increment="0.05" keywords="corner smoothing tension curve round" kind="slider" label="Corner smooth" max_val="1" min_val="0" widget="path_tension_slider" widget_history="false">
                <slider name="path_tension_slider" can_edit_text="true" decimal_digits="2" increment="0.05" max_val="1" min_val="0" show_text="true" text_width="52">
                    <slider.slider_bar thumb_center_color="KitSliderThumb" thumb_image="Kit_SliderThumb" thumb_image_disabled="Kit_SliderThumb" thumb_image_pressed="Kit_SliderThumb" thumb_outline_color="KitSliderThumb" track_color="KitSliderTrackEmpty" track_highlight_color="KitSliderTrackFill" track_highlight_horizontal_image="Kit_SliderTrack" track_image_horizontal="Kit_SliderTrack" />
                </slider>
            </kit_row>
            <kit_row advanced="true" bind="code" help="The world colour this path is drawn in." keywords="color world path line colour" kind="custom" label="Color" row_height="28" widget="color_swatch" widget_history="false">
                <panel name="color_swatch" background_visible="true" background_opaque="true" border="true" />
            </kit_row>
        </kit_card>
        <kit_card name="kc_ground_end" id="ground_end" kind="rows" title="Ground &amp; end">
            <kit_row bind="code" help="Keep the actor on the ground surface as the path crosses slopes and terrain." keywords="ground follow terrain height snap" kind="toggle" label="Ground-follow" widget="path_groundfollow_check" widget_history="false">
                <kit_switch name="path_groundfollow_check" />
            </kit_row>
            <kit_row bind="code" help="Tilt the actor to match the slope under the path." keywords="pitch slope tilt incline" kind="toggle" label="Pitch to slope" widget="path_pitch_check" widget_history="false">
                <kit_switch name="path_pitch_check" />
            </kit_row>
            <kit_row bind="code" help="Let the path run through the air instead of following the ground." keywords="air path fly airborne height" kind="toggle" label="Air path" widget="path_airborne_check" widget_history="false">
                <kit_switch name="path_airborne_check" />
            </kit_row>
            <kit_row bind="code" help="What happens at the end of the path: stop, stop and face the target, loop, or ping-pong." keywords="end behavior loop ping-pong stop face target" kind="combo" label="At the end" widget="path_end_combo" widget_history="false">
                <combo_box name="path_end_combo" tool_tip="What happens at the end of the path">
                    <combo_box.item name="pe_stop" label="Stop at end" value="0" />
                    <combo_box.item name="pe_stopface" label="Stop + face target" value="1" />
                    <combo_box.item name="pe_loop" label="Loop" value="2" />
                    <combo_box.item name="pe_pingpong" label="Ping-pong" value="3" />
                    <combo_box.drop_down_button image_color="KitControlBg" image_overlay="KitIcon_chevron_down_10_16" image_overlay_alignment="right" image_overlay_color="KitIconTint" image_pressed="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_unselected="Kit_RoundRect4" pad_right="6" />
                    <combo_box.combo_editor bg_color="KitInputBg" text_color="KitText" use_bg_color="true" />
                </combo_box>
            </kit_row>
        </kit_card>
        <kit_card name="kc_shape" id="shape" kind="rows" title="Path shape">
            <kit_row bind="code" help="Waypoints keeps your own points. The other shapes generate a path from the settings below." keywords="shape circle ellipse helix diamond figure 8 sine waypoints" kind="combo" label="Shape" widget="path_shape_combo" widget_history="false">
                <combo_box name="path_shape_combo">
                    <combo_box.item name="shape_waypoints" label="Waypoints" value="0" />
                    <combo_box.item name="shape_circle" label="Circle / Arc" value="1" />
                    <combo_box.item name="shape_ellipse" label="Ellipse / Arc" value="2" />
                    <combo_box.item name="shape_helix" label="Helix" value="3" />
                    <combo_box.item name="shape_diamond" label="Diamond" value="4" />
                    <combo_box.item name="shape_figure_eight" label="Figure 8" value="5" />
                    <combo_box.item name="shape_sine_wave" label="Sine Wave" value="6" />
                    <combo_box.drop_down_button image_color="KitControlBg" image_overlay="KitIcon_chevron_down_10_16" image_overlay_alignment="right" image_overlay_color="KitIconTint" image_pressed="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_unselected="Kit_RoundRect4" pad_right="6" />
                    <combo_box.combo_editor bg_color="KitInputBg" text_color="KitText" use_bg_color="true" />
                </combo_box>
            </kit_row>
            <kit_row bind="code" help="Centre the generated shape on the actor." keywords="center shape on actor" kind="button" label="Center" widget="btn_primitive_center">
                <button name="btn_primitive_center" label="Center on actor" image_unselected="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_pressed="Kit_RoundRect4" image_hover_unselected="Kit_RoundRect4" image_hover_selected="Kit_RoundRect4" image_color="KitControlBg" label_color="KitLabel" label_color_selected="KitTextStrong" label_color_disabled="KitFaint" label_shadow="false" />
            </kit_row>
            <kit_row bind="code" help="Fit a semicircle whose ends are the first and last points." keywords="fit half arc endpoints semicircle" kind="button" label="Half arc" widget="btn_fit_half_arc">
                <button name="btn_fit_half_arc" label="Fit Half Arc to Endpoints" tool_tip="Use the first and last path points as the ends of an exact semicircle" image_unselected="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_pressed="Kit_RoundRect4" image_hover_unselected="Kit_RoundRect4" image_hover_selected="Kit_RoundRect4" image_color="KitControlBg" label_color="KitLabel" label_color_selected="KitTextStrong" label_color_disabled="KitFaint" label_shadow="false" />
            </kit_row>
            <kit_row bind="code" help="Fit a sine wave whose ends are the first and last points." keywords="fit sine wave endpoints" kind="button" label="Sine fit" widget="btn_fit_sine">
                <button name="btn_fit_sine" label="Fit Sine Wave to Endpoints" tool_tip="Use the first and last path points as the ends of an exact sine wave" image_unselected="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_pressed="Kit_RoundRect4" image_hover_unselected="Kit_RoundRect4" image_hover_selected="Kit_RoundRect4" image_color="KitControlBg" label_color="KitLabel" label_color_selected="KitTextStrong" label_color_disabled="KitFaint" label_shadow="false" />
            </kit_row>
            <kit_row bind="code" help="Turns the first and last authored points into an exact generated path." keywords="fit ends endpoints generated path" kind="readout" label="Fit ends" widget="endpoint_generator_lbl">
                <text name="endpoint_generator_lbl" text_color="LtGray_50">Turn the first and last authored points into an exact generated path:</text>
            </kit_row>
        </kit_card>
        <kit_card name="kc_size_tilt" id="size_tilt" kind="combined" title="Size &amp; tilt">
            <kit_row bind="code" decimals="2" help="Size of the shape along X, in metres." increment="0.1" keywords="extent x radius width shape size" kind="number" label="Extent X (m)" max_val="10000" min_val="0.01" sub="Shape size" unit="m" widget="primitive_radius_x" widget_history="false">
                <spinner name="primitive_radius_x" decimal_digits="2" increment="0.1" max_val="10000" min_val="0.01" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" decimals="2" help="Size of the shape along Y, in metres." increment="0.1" keywords="extent y radius depth shape size" kind="number" label="Extent Y (m)" max_val="10000" min_val="0.01" sub="Shape size" unit="m" widget="primitive_radius_y" widget_history="false">
                <spinner name="primitive_radius_y" decimal_digits="2" increment="0.1" max_val="10000" min_val="0.01" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" decimals="1" help="Angle the shape starts from, in degrees." increment="5" keywords="start phase degrees angle shape" kind="number" label="Start (deg)" max_val="36000" min_val="-36000" sub="Shape size" unit="deg" widget="primitive_start_deg" widget_history="false">
                <spinner name="primitive_start_deg" decimal_digits="1" increment="5" max_val="36000" min_val="-36000" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" decimals="1" help="Angle the arc or wave sweeps, in degrees." increment="5" keywords="sweep cycles degrees arc shape" kind="number" label="Sweep (deg)" max_val="36000" min_val="-36000" sub="Shape size" unit="deg" widget="primitive_sweep_deg" widget_history="false">
                <spinner name="primitive_sweep_deg" decimal_digits="1" increment="5" max_val="36000" min_val="-36000" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" decimals="2" help="Height difference between the start and the end, in metres." increment="0.25" keywords="rise height end z climb" kind="number" label="Rise (m)" max_val="10000" min_val="-10000" sub="Shape size" unit="m" widget="primitive_rise" widget_history="false">
                <spinner name="primitive_rise" decimal_digits="2" increment="0.25" max_val="10000" min_val="-10000" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" decimals="1" help="Turns the shape's plane around the vertical axis, in degrees." increment="5" keywords="plane yaw rotate turn shape tilt" kind="number" label="Plane yaw" max_val="360" min_val="-360" sub="Plane tilt" unit="deg" widget="primitive_yaw_deg" widget_history="false">
                <spinner name="primitive_yaw_deg" decimal_digits="1" increment="5" max_val="360" min_val="-360" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" decimals="1" help="Tilts the shape's plane forward or back, in degrees." increment="5" keywords="plane pitch tilt shape" kind="number" label="Plane pitch" max_val="180" min_val="-180" sub="Plane tilt" unit="deg" widget="primitive_pitch_deg" widget_history="false">
                <spinner name="primitive_pitch_deg" decimal_digits="1" increment="5" max_val="180" min_val="-180" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" decimals="1" help="Tilts the shape's plane sideways, in degrees." increment="5" keywords="plane roll tilt shape" kind="number" label="Plane roll" max_val="180" min_val="-180" sub="Plane tilt" unit="deg" widget="primitive_roll_deg" widget_history="false">
                <spinner name="primitive_roll_deg" decimal_digits="1" increment="5" max_val="180" min_val="-180" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
        </kit_card>
        <kit_card name="kc_camera_sync" enable_quick="controller" enable_widget="sync_take_check" id="camera_sync" kind="custom" title="Camera sync">
            <kit_row bind="code" decimals="1" help="Seconds the walk runs ahead of (+) or behind (-) the camera take." increment="0.5" keywords="camera sync lead trail offset seconds take" kind="number" label="Lead/trail (s)" max_val="60" min_val="-60" unit="s" widget="sync_offset_spinner" widget_history="false">
                <spinner name="sync_offset_spinner" decimal_digits="1" increment="0.5" max_val="60" min_val="-60" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" help="Shows whether the walk follows the camera take or its own clock." keywords="camera sync status take" kind="readout" label="Status" widget="sync_status">
                <text name="sync_status" text_color="LtGray_50" use_ellipses="true">Off, the walk uses its own clock</text>
            </kit_row>
        </kit_card>
        <kit_card name="kc_follow_leader" id="follow_leader" kind="custom" title="Follow leader">
            <kit_row bind="code" help="The cast member this actor follows." keywords="follow leader member cast chase" kind="combo" label="Leader" widget="follow_leader_combo" widget_history="false">
                <combo_box name="follow_leader_combo">
                    <combo_box.drop_down_button image_color="KitControlBg" image_overlay="KitIcon_chevron_down_10_16" image_overlay_alignment="right" image_overlay_color="KitIconTint" image_pressed="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_unselected="Kit_RoundRect4" pad_right="6" />
                    <combo_box.combo_editor bg_color="KitInputBg" text_color="KitText" use_bg_color="true" />
                </combo_box>
            </kit_row>
            <kit_row bind="code" decimals="1" help="Distance the follower stays behind its leader, in metres." increment="0.5" keywords="follow behind distance metres" kind="number" label="Behind (m)" max_val="64" min_val="0" unit="m" widget="follow_offset_spinner" widget_history="false">
                <spinner name="follow_offset_spinner" decimal_digits="1" increment="0.5" initial_value="3.0" max_val="64" min_val="0" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="code" help="Stop following the leader." keywords="stop following leader" kind="button" label="Stop following" widget="btn_stop_following">
                <button name="btn_stop_following" label="Stop following" image_unselected="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_pressed="Kit_RoundRect4" image_hover_unselected="Kit_RoundRect4" image_hover_selected="Kit_RoundRect4" image_color="KitControlBg" label_color="KitLabel" label_color_selected="KitTextStrong" label_color_disabled="KitFaint" label_shadow="false" />
            </kit_row>
            <kit_row bind="code" help="Shows whether this actor is following someone." keywords="follow status leader" kind="readout" label="Status" widget="follow_status">
                <text name="follow_status" text_color="LtGray_50" use_ellipses="true">Not following</text>
            </kit_row>
        </kit_card>
        <kit_card name="kc_suspended" id="suspended" kind="custom" title="Paused walk">
            <kit_row bind="code" help="Why the walk is paused: the actor is away, has moved, or is back and about to resume." keywords="paused suspended walk status away" kind="readout" label="Status" widget="suspend_status">
                <text name="suspend_status" font="SansSerifSmallBold" text_color="EmphasisColor" use_ellipses="true">Walk suspended — actor away</text>
            </kit_row>
            <kit_row bind="code" help="Resume the walk now that the actor is back in range." keywords="resume paused walk continue" kind="button" label="Resume" widget="btn_suspend_resume">
                <button name="btn_suspend_resume" label="Resume" image_unselected="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_pressed="Kit_RoundRect4" image_hover_unselected="Kit_RoundRect4" image_hover_selected="Kit_RoundRect4" image_color="KitControlBg" label_color="KitLabel" label_color_selected="KitTextStrong" label_color_disabled="KitFaint" label_shadow="false" />
            </kit_row>
            <kit_row bind="code" help="Restart the walk from the actor's current position." keywords="re-anchor here restart walk position" kind="button" label="Re-anchor here" widget="btn_suspend_reanchor">
                <button name="btn_suspend_reanchor" label="Re-anchor here" image_unselected="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_pressed="Kit_RoundRect4" image_hover_unselected="Kit_RoundRect4" image_hover_selected="Kit_RoundRect4" image_color="KitControlBg" label_color="KitLabel" label_color_selected="KitTextStrong" label_color_disabled="KitFaint" label_shadow="false" />
            </kit_row>
            <kit_row bind="code" help="Cancel the suspended walk." keywords="cancel paused walk drop" kind="button" label="Cancel walk" widget="btn_suspend_cancel">
                <button name="btn_suspend_cancel" label="Cancel walk" image_unselected="Kit_RoundRect4" image_selected="Kit_RoundRect4" image_pressed="Kit_RoundRect4" image_hover_unselected="Kit_RoundRect4" image_hover_selected="Kit_RoundRect4" image_color="KitControlBg" label_color="KitLabel" label_color_selected="KitTextStrong" label_color_disabled="KitFaint" label_shadow="false" />
            </kit_row>
        </kit_card>
    </kit_page>
</panel>
