<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 legacy_header_height="18"
 can_resize="true"
 height="1250"
 min_height="440"
 min_width="390"
 layout="topleft"
 name="floater_actor_mover"
 title="ACTOR MOVER (LOCAL)"
 width="390">
  <scroll_list
   column_padding="0"
   draw_heading="true"
   follows="left|top"
   height="88"
   layout="topleft"
   left="12"
   top="24"
   name="roster_list"
   width="276">
    <columns
     label="Actor"
     name="name"
     width="170" />
    <columns
     label="Status"
     name="status"
     width="100" />
  </scroll_list>
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   left="12"
   top_pad="6"
   name="status_text"
   width="276">
    Idle
  </text>
  <text
   follows="left|top"
   height="14"
   layout="topleft"
   left="12"
   top_pad="4"
   name="hint_text"
   text_color="LtGray_50"
   width="276">
    Right-click avatar/animesh &gt; Actor Mover Target.
  </text>
  <!-- in-world path preview toggle: host chrome (the console keeps its own copy
       in the persistent cast column). Settings-backed, so it can never drift. -->
  <check_box
   control_name="ActorMoverShowHeading"
   follows="left|top"
   height="16"
   label="Show path"
   layout="topleft"
   left="12"
   top_pad="8"
   name="show_heading_check"
   tool_tip="Show the in-world path preview for each roster actor. With a walkable path: the thick outlined spline with direction chevrons and numbered node markers (start green, end red, dwell nodes ringed). With no path: the thick straight heading arrow along the planned bearing for the configured distance. Client-side only; updates live."
   width="276" />
  <!-- shared Actor Mover transport: same panel the Director Console Move tab
       embeds (scope, heading compass dial, Speed/Distance/Cadence, End behavior,
       custom walk anim, Walk/Stop). The roster list above stays this floater's
       own presentation; the floater feeds the panel its selection each draw. -->
  <panel
   class="panel_actor_mover"
   filename="panel_actor_mover.xml"
   follows="left|top|right"
   height="360"
   layout="topleft"
   left="6"
   top_pad="6"
   name="actor_mover_panel"
   width="374" />
  <!-- shared Actor Pathing editor: same panel the Director Console Path tab
       embeds. Targets the roster row selected above. -->
  <text
   follows="left|top"
   font="SansSerifBold"
   height="14"
   layout="topleft"
   left="12"
   top_pad="8"
   name="path_section_lbl"
   width="276">
    Path (waypoints)
  </text>
  <panel
   class="panel_path_editor"
   filename="panel_path_editor.xml"
   follows="left|top|right"
   height="656"
   layout="topleft"
   left="6"
   top_pad="4"
   name="path_editor"
   width="360" />
</floater>
