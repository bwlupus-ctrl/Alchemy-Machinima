<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 legacy_header_height="18"
 can_resize="true"
 height="700"
 min_height="440"
 min_width="390"
 layout="topleft"
 name="floater_actor_mover"
 save_rect="true"
 single_instance="true"
 title="ACTOR MOVER (LOCAL)"
 width="390">
  <scroll_list
   column_padding="0"
   draw_heading="true"
   follows="left|top"
   height="88"
   layout="topleft"
   left="12"
   top="24"
   name="roster_list"
   width="276">
    <columns
     label="Actor"
     name="name"
     width="170" />
    <columns
     label="Status"
     name="status"
     width="100" />
  </scroll_list>
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   left="12"
   top_pad="6"
   name="status_text"
   width="276">
    Idle
  </text>
  <text
   follows="left|top"
   height="14"
   layout="topleft"
   left="12"
   top_pad="4"
   name="hint_text"
   text_color="LtGray_50"
   width="276">
    Right-click avatar/animesh &gt; Actor Mover Target.
  </text>
  <!-- in-world path preview toggle: host chrome (the console keeps its own copy
       in the persistent cast column). Settings-backed, so it can never drift. -->
  <check_box
   control_name="ActorMoverShowHeading"
   follows="left|top"
   height="16"
   label="Show path"
   layout="topleft"
   left="12"
   top_pad="8"
   name="show_heading_check"
   tool_tip="Show the in-world path preview for each roster actor. With a walkable path: the thick outlined spline with direction chevrons and numbered node markers (start green, end red, dwell nodes ringed). With no path: the thick straight heading arrow along the planned bearing for the configured distance. Client-side only; updates live."
   width="276" />
  <!-- Move and Path are independent scroll documents. The roster remains
       sticky, and each embedded list/preview keeps its own wheel handling. -->
  <tab_container
   follows="all"
   height="500"
   layout="topleft"
   left="6"
   name="actor_mover_tabs"
   tab_height="24"
   top="190"
   width="378">
    <panel
     background_visible="false"
     follows="all"
     height="476"
     label="Move"
     layout="topleft"
     name="move_tab"
     width="378">
      <scroll_container
       follows="all"
       height="472"
       layout="topleft"
       left="0"
       name="move_scroll"
       opaque="false"
       reserve_scroll_corner="false"
       top="0"
       width="378">
        <panel
         background_visible="false"
         follows="left|top|right"
         height="402"
         layout="topleft"
         left="0"
         name="move_scroll_content"
         top="0"
         width="360">
          <!-- Shared Actor Mover transport: the same panel Director embeds. -->
          <panel
           class="panel_actor_mover"
           filename="panel_actor_mover.xml"
           follows="left|top|right"
           height="360"
           layout="topleft"
           left="0"
           name="actor_mover_panel"
           top="8"
           width="360" />
          <button
           follows="left|top"
           height="22"
           label="Actor Gaze..."
           layout="topleft"
           left="8"
           name="btn_actor_gaze"
           top="372"
           tool_tip="Open the Actor Gaze controls for the selected roster actor"
           width="170" />
          <button
           follows="left|top|right"
           height="22"
           label="Pose Polish..."
           layout="topleft"
           left="182"
           name="btn_pose_polish"
           top="372"
           tool_tip="Open the Pose Polish controls (transition smoothing, foot grounding, secondary motion, and other post-blend polish)"
           width="170" />
        </panel>
      </scroll_container>
    </panel>
    <panel
     background_visible="false"
     follows="all"
     height="476"
     label="Path"
     layout="topleft"
     name="path_tab"
     width="378">
      <scroll_container
       follows="all"
       height="472"
       layout="topleft"
       left="0"
       name="path_scroll"
       opaque="false"
       reserve_scroll_corner="false"
       top="0"
       width="378">
        <panel
         background_visible="false"
         follows="left|top|right"
         height="638"
         layout="topleft"
         left="0"
         name="path_scroll_content"
         top="0"
         width="360">
          <text
           follows="left|top"
           font="SansSerifBold"
           height="14"
           layout="topleft"
           left="6"
           top="6"
           name="path_section_lbl"
           width="348">
            Path (waypoints)
          </text>
          <!-- Shared Actor Pathing editor: the same panel Director embeds. -->
          <panel
           class="panel_path_editor"
           filename="panel_path_editor.xml"
           follows="left|top|right"
           height="604"
           layout="topleft"
           left="0"
           name="path_editor"
           top="26"
           width="360" />
        </panel>
      </scroll_container>
    </panel>
  </tab_container>
</floater>
