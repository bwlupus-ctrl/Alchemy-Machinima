<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Right-click menu for a Studio ENTITY clone (alghostclonemenu.cpp).
     Every item calls the same ALGhostStudio action as the Clones page, on the
     picked clone or on the whole Clones multi-selection when the picked clone
     belongs to it. Disabled items carry their reason in the label and tooltip.
     Session-only; nothing here is saved in scenes. -->
<context_menu
 layout="topleft"
 name="Ghost Clone Pie">
  <menu_item_call
   label="Select in Director"
   name="Select in Director"
   tool_tip="Make this clone the Director's selection.">
    <menu_item_call.on_click function="GhostClone.SelectInDirector" />
    <menu_item_call.on_enable function="GhostClone.EnableSelectInDirector" />
  </menu_item_call>
  <menu_item_separator />
  <menu_item_call
   label="Pause"
   name="Pause"
   tool_tip="Freeze the clone on its current animation frame.">
    <menu_item_call.on_click function="GhostClone.PlayPause" />
    <menu_item_call.on_enable function="GhostClone.EnablePlayPause" />
    <menu_item_call.on_visible function="GhostClone.VisiblePause" />
  </menu_item_call>
  <menu_item_call
   label="Play"
   name="Play"
   tool_tip="Resume the clone's animation.">
    <menu_item_call.on_click function="GhostClone.PlayPause" />
    <menu_item_call.on_enable function="GhostClone.EnablePlayPause" />
    <menu_item_call.on_visible function="GhostClone.VisiblePlay" />
  </menu_item_call>
  <menu_item_check
   label="Mirror"
   name="Mirror"
   tool_tip="Reflect the source's motion across a plane (the Reflect drive).">
    <menu_item_check.on_click function="GhostClone.Mirror" />
    <menu_item_check.on_check function="GhostClone.CheckMirror" />
    <menu_item_check.on_enable function="GhostClone.EnableMirror" />
  </menu_item_check>
  <context_menu
   label="Size"
   name="Size">
    <menu_item_call
     label="Smaller"
     name="Smaller">
      <menu_item_call.on_click function="GhostClone.Size" parameter="smaller" />
      <menu_item_call.on_enable function="GhostClone.EnableTargets" />
    </menu_item_call>
    <menu_item_call
     label="Larger"
     name="Larger">
      <menu_item_call.on_click function="GhostClone.Size" parameter="larger" />
      <menu_item_call.on_enable function="GhostClone.EnableTargets" />
    </menu_item_call>
    <menu_item_call
     label="Reset size"
     name="Reset size">
      <menu_item_call.on_click function="GhostClone.Size" parameter="reset" />
      <menu_item_call.on_enable function="GhostClone.EnableTargets" />
    </menu_item_call>
  </context_menu>
  <context_menu
   label="Stagger"
   name="Stagger">
    <menu_item_check
     label="In sync"
     name="In sync"
     tool_tip="Start every clone of the group together (the Sync path).">
      <menu_item_check.on_click function="GhostClone.Stagger" parameter="0" />
      <menu_item_check.on_check function="GhostClone.CheckStagger" parameter="0" />
      <menu_item_check.on_enable function="GhostClone.EnableStagger" />
    </menu_item_check>
    <menu_item_check
     label="Random"
     name="Random"
     tool_tip="Random start offsets over the Crowd tab's Spread.">
      <menu_item_check.on_click function="GhostClone.Stagger" parameter="1" />
      <menu_item_check.on_check function="GhostClone.CheckStagger" parameter="1" />
      <menu_item_check.on_enable function="GhostClone.EnableStagger" />
    </menu_item_check>
    <menu_item_check
     label="Ripple"
     name="Ripple"
     tool_tip="A wave of start offsets across the group, in the Crowd tab's Ripple direction.">
      <menu_item_check.on_click function="GhostClone.Stagger" parameter="2" />
      <menu_item_check.on_check function="GhostClone.CheckStagger" parameter="2" />
      <menu_item_check.on_enable function="GhostClone.EnableStagger" />
    </menu_item_check>
  </context_menu>
  <menu_item_check
   label="Edit"
   name="Edit"
   tool_tip="Move, rotate and delete this clone in the world (the Edit clones tool).">
    <menu_item_check.on_click function="GhostClone.Edit" />
    <menu_item_check.on_check function="GhostClone.CheckEdit" />
    <menu_item_check.on_enable function="GhostClone.EnableEdit" />
  </menu_item_check>
  <context_menu
   label="Look / turn"
   name="Look Turn">
    <context_menu
     label="Look at"
     name="Look At">
      <menu_item_call
       label="Camera"
       name="Look Camera"
       tool_tip="Keep the clone facing the camera.">
        <menu_item_call.on_click function="GhostClone.Look" parameter="camera" />
        <menu_item_call.on_enable function="GhostClone.EnableFace" />
      </menu_item_call>
      <menu_item_call
       label="Me"
       name="Look Me"
       tool_tip="Keep the clone facing your avatar.">
        <menu_item_call.on_click function="GhostClone.Look" parameter="me" />
        <menu_item_call.on_enable function="GhostClone.EnableFace" />
      </menu_item_call>
      <context_menu
       label="Nearby people"
       name="Look Nearby">
        <menu_item_call
         label="No one nearby"
         name="Nobody"
         enabled="false" />
      </context_menu>
      <menu_item_call
       label="Stop looking"
       name="Look Stop"
       tool_tip="Stop keeping the clone facing its look target.">
        <menu_item_call.on_click function="GhostClone.Look" parameter="stop" />
        <menu_item_call.on_enable function="GhostClone.EnableFace" />
      </menu_item_call>
    </context_menu>
    <context_menu
     label="Turn to face"
     name="Turn To Face">
      <menu_item_call
       label="Camera"
       name="Turn Camera"
       tool_tip="Turn once to face the camera, then hold.">
        <menu_item_call.on_click function="GhostClone.Turn" parameter="camera" />
        <menu_item_call.on_enable function="GhostClone.EnableFace" />
      </menu_item_call>
      <menu_item_call
       label="Me"
       name="Turn Me"
       tool_tip="Turn once to face your avatar, then hold.">
        <menu_item_call.on_click function="GhostClone.Turn" parameter="me" />
        <menu_item_call.on_enable function="GhostClone.EnableFace" />
      </menu_item_call>
      <context_menu
       label="Nearby people"
       name="Turn Nearby">
        <menu_item_call
         label="No one nearby"
         name="Nobody"
         enabled="false" />
      </context_menu>
      <menu_item_call
       label="Stop turning"
       name="Turn Stop"
       tool_tip="Stop turning the clone toward its turn target.">
        <menu_item_call.on_click function="GhostClone.Turn" parameter="stop" />
        <menu_item_call.on_enable function="GhostClone.EnableFace" />
      </menu_item_call>
    </context_menu>
  </context_menu>
  <context_menu
   label="Animation"
   name="Animation">
    <menu_item_call
     label="Restart animation"
     name="Restart animation"
     tool_tip="Start the clone's animation again from its beginning (re-sync).">
      <menu_item_call.on_click function="GhostClone.RestartAnim" />
      <menu_item_call.on_enable function="GhostClone.EnableEntities" />
    </menu_item_call>
    <context_menu
     label="Recent"
     name="Recent Animations">
      <menu_item_call
       label="No recent animations"
       name="Nobody"
       enabled="false" />
    </context_menu>
  </context_menu>
  <context_menu
   label="Appearance"
   name="Appearance">
    <context_menu
     label="Swap source"
     name="Swap Source">
      <menu_item_call
       label="No cast members"
       name="Nobody"
       enabled="false" />
    </context_menu>
    <context_menu
     label="Look"
     name="Entity Look">
      <menu_item_check
       label="Normal"
       name="look_normal">
        <menu_item_check.on_click function="GhostClone.EntityLook" parameter="0" />
        <menu_item_check.on_check function="GhostClone.CheckEntityLook" parameter="0" />
        <menu_item_check.on_enable function="GhostClone.EnableEntities" />
      </menu_item_check>
      <menu_item_check
       label="Apparition"
       name="look_apparition">
        <menu_item_check.on_click function="GhostClone.EntityLook" parameter="1" />
        <menu_item_check.on_check function="GhostClone.CheckEntityLook" parameter="1" />
        <menu_item_check.on_enable function="GhostClone.EnableEntities" />
      </menu_item_check>
      <menu_item_check
       label="Hologram*"
       name="look_hologram"
       tool_tip="Starred looks are not built yet.">
        <menu_item_check.on_click function="GhostClone.EntityLook" parameter="2" />
        <menu_item_check.on_check function="GhostClone.CheckEntityLook" parameter="2" />
        <menu_item_check.on_enable function="GhostClone.EnableEntities" />
      </menu_item_check>
      <menu_item_check
       label="Chrome*"
       name="look_chrome"
       tool_tip="Starred looks are not built yet.">
        <menu_item_check.on_click function="GhostClone.EntityLook" parameter="3" />
        <menu_item_check.on_check function="GhostClone.CheckEntityLook" parameter="3" />
        <menu_item_check.on_enable function="GhostClone.EnableEntities" />
      </menu_item_check>
      <menu_item_check
       label="Toon*"
       name="look_toon"
       tool_tip="Starred looks are not built yet.">
        <menu_item_check.on_click function="GhostClone.EntityLook" parameter="4" />
        <menu_item_check.on_check function="GhostClone.CheckEntityLook" parameter="4" />
        <menu_item_check.on_enable function="GhostClone.EnableEntities" />
      </menu_item_check>
      <menu_item_check
       label="Silhouette*"
       name="look_silhouette"
       tool_tip="Starred looks are not built yet.">
        <menu_item_check.on_click function="GhostClone.EntityLook" parameter="5" />
        <menu_item_check.on_check function="GhostClone.CheckEntityLook" parameter="5" />
        <menu_item_check.on_enable function="GhostClone.EnableEntities" />
      </menu_item_check>
    </context_menu>
    <menu_item_call
     label="Fade out"
     name="Fade out"
     tool_tip="Fade the clone out to invisible over the Crowd tab Fade out time. It stays hidden (never deleted) until Fade in.">
      <menu_item_call.on_click function="GhostClone.Fade" parameter="out" />
      <menu_item_call.on_enable function="GhostClone.EnableFade" parameter="out" />
    </menu_item_call>
    <menu_item_call
     label="Fade in"
     name="Fade in"
     tool_tip="Fade a faded-out clone back in over the Crowd tab Fade in time.">
      <menu_item_call.on_click function="GhostClone.Fade" parameter="in" />
      <menu_item_call.on_enable function="GhostClone.EnableFade" parameter="in" />
    </menu_item_call>
  </context_menu>
  <menu_item_separator />
  <menu_item_call
   label="Freeze pose"
   name="Freeze pose"
   tool_tip="Hold the clone's current pose while the live body keeps animating.">
    <menu_item_call.on_click function="GhostClone.FreezePose" />
    <menu_item_call.on_enable function="GhostClone.EnableTargets" />
  </menu_item_call>
  <menu_item_call
   label="Clear animations"
   name="Clear animations"
   tool_tip="Stop every animation on the clone and rest it in the neutral pose.">
    <menu_item_call.on_click function="GhostClone.ClearAnim" />
    <menu_item_call.on_enable function="GhostClone.EnableClearAnim" />
  </menu_item_call>
  <menu_item_check
   label="Solo"
   name="Solo"
   tool_tip="Show only the selected clones.">
    <menu_item_check.on_click function="GhostClone.Solo" />
    <menu_item_check.on_check function="GhostClone.CheckSolo" />
    <menu_item_check.on_enable function="GhostClone.EnableTargets" />
  </menu_item_check>
  <menu_item_call
   label="Duplicate"
   name="Duplicate">
    <menu_item_call.on_click function="GhostClone.Duplicate" />
    <menu_item_call.on_enable function="GhostClone.EnableTargets" />
  </menu_item_call>
  <menu_item_call
   label="Delete"
   name="Delete">
    <menu_item_call.on_click function="GhostClone.Delete" />
    <menu_item_call.on_enable function="GhostClone.EnableTargets" />
  </menu_item_call>
  <menu_item_separator />
  <menu_item_call
   label="Open in Director"
   name="Open in Director"
   tool_tip="Open the Director's Clones page with this clone selected.">
    <menu_item_call.on_click function="GhostClone.OpenInDirector" />
    <menu_item_call.on_enable function="GhostClone.EnableSelectInDirector" />
  </menu_item_call>
</context_menu>
