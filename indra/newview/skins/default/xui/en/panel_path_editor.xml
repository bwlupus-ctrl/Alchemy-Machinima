<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Shared Actor Path editor. The accordion keeps related controls readable,
     while preserving every stable widget name consumed by ALPanelPathEditor. -->
<panel
 background_visible="false"
 border="false"
 height="720"
 layout="topleft"
 name="panel_path_editor"
 width="500">

  <text
   follows="left|top|right"
   font="SansSerifBold"
   height="16"
   layout="topleft"
   left="8"
   top="2"
   name="path_header"
   use_ellipses="true"
   width="350">
    Path &#8212; select a cast member
  </text>
  <check_box
   follows="top|right"
   height="18"
   label="Edit in world"
   layout="topleft"
   left="370"
   top="1"
   name="edit_mode_check"
   tool_tip="Click ground to place, drag a node to move, and right-click a node to delete it. Leaving this tab hands the camera back."
   width="122" />
  <text
   follows="left|top|right"
   height="14"
   layout="topleft"
   left="8"
   top="21"
   mouse_opaque="false"
   name="hint"
   text_color="LtGray_50"
   use_ellipses="true"
   width="484">
    Build with points, then shape the route; open only the section you need.
  </text>

  <accordion
   follows="all"
   height="680"
   layout="topleft"
   left="4"
   name="path_sections"
   single_expansion="false"
   top="38"
   width="492">

    <accordion_tab
     expanded="true"
     fit_panel="true"
     height="304"
     layout="topleft"
     name="nodes_playback_tab"
     title="Nodes &amp; Playback">
      <panel follows="all" height="304" layout="topleft" left="0" name="nodes_playback_panel" top="0" width="488">
        <scroll_list
         column_padding="0" draw_heading="true" follows="left|top|right"
         height="112" layout="topleft" left="8" top="4"
         name="waypoint_list"
         tool_tip="Waypoints in order. Select a row to inspect or highlight that node in world"
         width="472">
          <columns label="#" name="num" width="28" />
          <columns label="Role" name="role" width="62" />
          <columns label="Detail" name="detail" width="370" />
        </scroll_list>

        <text follows="left|top" font="SansSerifSmall" height="14" layout="topleft"
         left="8" top="120" name="path_readout"
         tool_tip="Length and estimated duration including speed overrides, easing, and dwell"
         use_ellipses="true" width="194">No path yet</text>
        <check_box control_name="PathShowOnionSkin" follows="left|top" height="16"
         label="Pose ghosts" layout="topleft" left="208" top="119"
         name="onion_skin_check"
         tool_tip="Show styled actor copies at path anchors for blocking without playing the path"
         width="102" />
        <combo_box control_name="PathGhostStyle" follows="left|top|right" height="20"
         layout="topleft" left="312" top="116" name="ghost_style_combo"
         tool_tip="Appearance of path pose ghosts" width="168">
          <combo_box.item label="Ghost" name="gs_ghost" value="0" />
          <combo_box.item label="Clone" name="gs_clone" value="1" />
          <combo_box.item label="Hologram" name="gs_hologram" value="2" />
          <combo_box.item label="Wireframe" name="gs_wireframe" value="3" />
          <combo_box.item label="X-ray" name="gs_xray" value="4" />
          <combo_box.item label="Thermal" name="gs_thermal" value="5" />
          <combo_box.item label="Neon Outline" name="gs_neon" value="6" />
          <combo_box.item label="Silhouette" name="gs_silhouette" value="7" />
          <combo_box.item label="Toon/Ink" name="gs_toon" value="8" />
          <combo_box.item label="Chrome" name="gs_chrome" value="9" />
          <combo_box.item label="Dissolve" name="gs_dissolve" value="10" />
          <combo_box.item label="Negative" name="gs_negative" value="11" />
          <combo_box.item label="Gold Statue" name="gs_gold" value="12" />
          <combo_box.item label="Night-vision" name="gs_night" value="13" />
          <combo_box.item label="Blueprint" name="gs_blueprint" value="14" />
          <combo_box.item label="Ectoplasm" name="gs_ectoplasm" value="15" />
          <combo_box.item label="Frost/Ice" name="gs_frost" value="16" />
          <combo_box.item label="Prism" name="gs_prism" value="17" />
          <combo_box.item label="Thermal Scope" name="gs_thermal_scope" value="18" />
          <combo_box.item label="Wallhack/ESP" name="gs_wallhack" value="19" />
          <combo_box.item label="NV Tube" name="gs_nv_tube" value="20" />
          <combo_box.item label="Damage" name="gs_damage" value="21" />
          <combo_box.item label="Killcam" name="gs_killcam" value="22" />
          <combo_box.item label="Oil Slick" name="gs_oil_slick" value="23" />
          <combo_box.item label="Vaporwave" name="gs_vaporwave" value="24" />
          <combo_box.item label="Halftone" name="gs_halftone" value="25" />
          <combo_box.item label="Sonar" name="gs_sonar" value="26" />
          <combo_box.item label="Holo Echo" name="gs_holo_echo" value="27" />
        </combo_box>
        <combo_box control_name="PathGhostDistort" follows="left|top" height="20"
         layout="topleft" left="208" top="140" name="ghost_distort_combo"
         tool_tip="Independent path-ghost distortion" width="128">
          <combo_box.item label="No distortion" name="gd_none" value="0" />
          <combo_box.item label="Pixelate" name="gd_pixel" value="1" />
          <combo_box.item label="Voxel" name="gd_voxel" value="2" />
          <combo_box.item label="Lens" name="gd_lens" value="3" />
          <combo_box.item label="Wave" name="gd_wave" value="4" />
          <combo_box.item label="RGB Split" name="gd_rgb" value="5" />
          <combo_box.item label="Block" name="gd_block" value="6" />
          <combo_box.item label="V-Tear" name="gd_vertical" value="7" />
          <combo_box.item label="VHS" name="gd_vhs" value="8" />
        </combo_box>
        <slider control_name="PathGhostDistortAmount" can_edit_text="true"
         decimal_digits="2" follows="left|top" height="18" increment="0.05"
         label="Amount" label_width="48" layout="topleft" left="340"
         max_val="1" min_val="0" name="ghost_distort_amount" top="141" width="140" />
        <spinner control_name="PathGhostEffectFps" decimal_digits="0" follows="left|top"
         height="18" increment="1" initial_value="0" label="FX cadence (fps)"
         label_width="96" layout="topleft" left="8" max_val="30" min_val="0"
         name="ghost_effect_fps" tool_tip="0 is smooth; 1-30 gives stop-motion shader animation"
         top="141" width="190" />

        <button follows="left|top" height="22" label="Add at actor" layout="topleft" left="8" top="166" name="btn_wp_add" width="112" />
        <button follows="left|top" height="22" label="Insert after" layout="topleft" left="124" top="166" name="btn_wp_insert" width="112" />
        <button follows="left|top" height="22" label="Delete node" layout="topleft" left="240" top="166" name="btn_wp_delete" width="112" />
        <button follows="left|top" height="22" label="Clear path" layout="topleft" left="356" top="166" name="btn_wp_clear" width="124" />

        <button follows="left|top" height="22" label="Undo" layout="topleft" left="8" top="192" name="btn_edit_undo" width="66" />
        <button follows="left|top" height="22" label="Redo" layout="topleft" left="78" top="192" name="btn_edit_redo" width="66" />
        <button follows="left|top" height="22" label="Reverse" layout="topleft" left="148" top="192" name="btn_edit_reverse" width="92" />
        <button follows="left|top" height="22" label="Mirror" layout="topleft" left="244" top="192" name="btn_edit_mirror" width="90" />
        <button follows="left|top" height="22" label="Close loop" layout="topleft" left="338" top="192" name="btn_edit_loopclose" width="142" />

        <combo_box follows="left|top" height="22" layout="topleft" left="8" top="218"
         name="copy_to_combo" tool_tip="Cast member to copy this path onto" width="210" />
        <button follows="left|top" height="22" label="Copy path to" layout="topleft" left="222" top="218" name="btn_copy_to" width="112" />
        <button follows="left|top" height="22" label="Walk to Point..." layout="topleft" left="338" top="218" name="btn_walk_here" width="142" />

        <button follows="left|top" height="24" label="Play Path" layout="topleft" left="8" top="246" name="btn_play_path" width="232" />
        <button follows="left|top|right" height="24" label="Stop Path" layout="topleft" left="244" top="246" name="btn_stop_path" width="236" />
      </panel>
    </accordion_tab>

    <accordion_tab expanded="false" fit_panel="true" height="224" layout="topleft"
     name="node_camera_tab" title="Selected Node &amp; Camera">
      <panel follows="all" height="224" layout="topleft" left="0" name="node_camera_panel" top="0" width="488">
        <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="8" top="6" name="node_lbl" width="220">Selected node timing &amp; action</text>
        <spinner decimal_digits="2" follows="left|top" height="18" increment="0.05" label="Height nudge (m)" label_width="100" layout="topleft" left="8" max_val="5" min_val="-5" name="node_height_spinner" top="26" width="230" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="0.5" label="Dwell (s)" label_width="70" layout="topleft" left="246" max_val="120" min_val="0" name="node_dwell_spinner" top="26" width="234" />
        <spinner decimal_digits="2" follows="left|top" height="18" increment="0.05" label="Speed override (m/s)" label_width="124" layout="topleft" left="8" max_val="10" min_val="0" name="node_speed_spinner" top="50" width="230" />
        <spinner decimal_digits="2" follows="left|top" height="18" increment="0.1" label="Corner radius (m)" label_width="108" layout="topleft" left="246" max_val="10000" min_val="0" name="node_corner_radius_spinner" top="50" tool_tip="0 keeps the waypoint corner sharp; a positive value inserts an exact tangent circular turn" width="234" />
        <text follows="left|top" height="14" layout="topleft" left="8" top="76" name="node_anim_lbl" width="234">Node animation UUID</text>
        <line_editor follows="left|top|right" height="20" layout="topleft" left="8" max_length_chars="36" name="node_anim_editor" top="92" width="472" />

        <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="8" top="120" name="cam_lbl" width="80">Node camera</text>
        <check_box control_name="PathCameraEnabled" follows="left|top|right" height="18" label="Enable authored path camera for this session" layout="topleft" left="98" top="118" name="path_camera_enable_check" width="382" />
        <button follows="left|top" height="22" label="Capture camera here" layout="topleft" left="8" top="142" name="btn_node_setcam" width="154" />
        <button follows="left|top" height="22" label="Clear camera" layout="topleft" left="166" top="142" name="btn_node_clearcam" width="114" />
        <combo_box follows="left|top" height="22" layout="topleft" left="284" top="142" name="node_cam_transition_combo" width="94">
          <combo_box.item label="Cut" name="cam_cut" value="0" />
          <combo_box.item label="Ease" name="cam_ease" value="1" />
        </combo_box>
        <button follows="left|top|right" height="22" label="Preview shot" layout="topleft" left="382" top="142" name="btn_node_preview" width="98" />
        <text follows="left|top|right" height="28" layout="topleft" left="8" top="170" name="node_cam_status" text_color="LtGray_50" use_ellipses="true" width="472">Select a waypoint to author its camera</text>
      </panel>
    </accordion_tab>

    <accordion_tab expanded="false" fit_panel="true" height="174" layout="topleft"
     name="movement_timing_tab" title="Movement &amp; Timing">
      <panel follows="all" height="174" layout="topleft" left="0" name="movement_timing_panel" top="0" width="488">
        <spinner decimal_digits="2" follows="left|top" height="18" increment="0.05" label="Travel speed (m/s)" label_width="112" layout="topleft" left="8" max_val="10" min_val="0.05" name="path_speed_spinner" top="8" width="230" />
        <slider can_edit_text="true" decimal_digits="2" follows="left|top|right" height="18" increment="0.05" label="Foot cadence ref" label_width="94" layout="topleft" left="246" max_val="12" min_val="0.5" name="path_cadence_slider" tool_tip="Animation design-speed reference. Lower values make foot cycles quicker at a given travel speed; higher values make them slower. Stored per path." top="8" width="234" />
        <slider can_edit_text="true" decimal_digits="2" follows="left|top|right" height="18" increment="0.05" label="Corner smoothing" label_width="108" layout="topleft" left="8" max_val="1" min_val="0" name="path_tension_slider" top="34" width="472" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="0.5" label="Ease in (s)" label_width="76" layout="topleft" left="8" max_val="10" min_val="0" name="path_easein_spinner" top="60" width="230" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="0.5" label="Ease out (s)" label_width="78" layout="topleft" left="246" max_val="10" min_val="0" name="path_easeout_spinner" top="60" width="234" />
        <check_box follows="left|top" height="18" label="Ground-follow" layout="topleft" left="8" top="86" name="path_groundfollow_check" width="144" />
        <check_box follows="left|top" height="18" label="Pitch to slope" layout="topleft" left="160" top="86" name="path_pitch_check" width="144" />
        <check_box follows="left|top" height="18" label="Air path" layout="topleft" left="312" top="86" name="path_airborne_check" width="120" />
        <combo_box follows="left|top" height="22" layout="topleft" left="8" top="112" name="path_end_combo" tool_tip="What happens at the end of the path" width="230">
          <combo_box.item label="Stop at end" name="pe_stop" value="0" />
          <combo_box.item label="Stop + face target" name="pe_stopface" value="1" />
          <combo_box.item label="Loop" name="pe_loop" value="2" />
          <combo_box.item label="Ping-pong" name="pe_pingpong" value="3" />
        </combo_box>
        <text follows="left|top" height="14" layout="topleft" left="250" top="116" name="color_lbl" width="92">World color</text>
        <panel background_visible="true" background_opaque="true" border="true" follows="left|top" height="18" layout="topleft" left="344" top="114" name="color_swatch" width="136" />
      </panel>
    </accordion_tab>

    <accordion_tab expanded="false" fit_panel="true" height="210" layout="topleft"
     name="shape_designer_tab" title="Shape Designer">
      <panel follows="all" height="210" layout="topleft" left="0" name="shape_designer_panel" top="0" width="488">
        <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="8" top="8" name="primitive_lbl" width="54">Shape</text>
        <combo_box follows="left|top" height="22" layout="topleft" left="66" top="4" name="path_shape_combo" width="230">
          <combo_box.item label="Waypoints" name="shape_waypoints" value="0" />
          <combo_box.item label="Circle / Arc" name="shape_circle" value="1" />
          <combo_box.item label="Ellipse / Arc" name="shape_ellipse" value="2" />
          <combo_box.item label="Helix" name="shape_helix" value="3" />
          <combo_box.item label="Diamond" name="shape_diamond" value="4" />
          <combo_box.item label="Figure 8" name="shape_figure_eight" value="5" />
          <combo_box.item label="Sine Wave" name="shape_sine_wave" value="6" />
        </combo_box>
        <button follows="left|top|right" height="22" label="Center on actor" layout="topleft" left="304" top="4" name="btn_primitive_center" width="176" />

        <text follows="left|top|right" height="14" layout="topleft" left="8" top="32" name="endpoint_generator_lbl" text_color="LtGray_50" width="472">Turn the first and last authored points into an exact generated path:</text>
        <button follows="left|top" height="24" label="Fit Half Arc to Endpoints" layout="topleft" left="8" top="50" name="btn_fit_half_arc" tool_tip="Use the first and last path points as the ends of an exact semicircle" width="230" />
        <button follows="left|top|right" height="24" label="Fit Sine Wave to Endpoints" layout="topleft" left="246" top="50" name="btn_fit_sine" tool_tip="Use the first and last path points as the ends of an exact sine wave" width="234" />

        <spinner decimal_digits="2" follows="left|top" height="18" increment="0.1" label="Extent X (m)" label_width="82" layout="topleft" left="8" max_val="10000" min_val="0.01" name="primitive_radius_x" top="82" width="230" />
        <spinner decimal_digits="2" follows="left|top" height="18" increment="0.1" label="Extent Y (m)" label_width="82" layout="topleft" left="246" max_val="10000" min_val="0.01" name="primitive_radius_y" top="82" width="234" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="5" label="Start / phase (deg)" label_width="112" layout="topleft" left="8" max_val="36000" min_val="-36000" name="primitive_start_deg" top="108" width="230" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="5" label="Sweep / cycles (deg)" label_width="122" layout="topleft" left="246" max_val="36000" min_val="-36000" name="primitive_sweep_deg" top="108" width="234" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="5" label="Plane yaw" label_width="76" layout="topleft" left="8" max_val="360" min_val="-360" name="primitive_yaw_deg" top="134" width="230" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="5" label="Plane pitch" label_width="76" layout="topleft" left="246" max_val="180" min_val="-180" name="primitive_pitch_deg" top="134" width="234" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="5" label="Plane roll" label_width="76" layout="topleft" left="8" max_val="180" min_val="-180" name="primitive_roll_deg" top="160" width="230" />
        <spinner decimal_digits="2" follows="left|top" height="18" increment="0.25" label="Rise / end ΔZ (m)" label_width="112" layout="topleft" left="246" max_val="10000" min_val="-10000" name="primitive_rise" top="160" width="234" />
      </panel>
    </accordion_tab>

    <accordion_tab expanded="false" fit_panel="true" height="150" layout="topleft"
     name="choreography_tab" title="Choreography">
      <panel follows="all" height="150" layout="topleft" left="0" name="choreography_panel" top="0" width="488">
        <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="8" top="8" name="choreo_lbl" width="150">Camera take sync</text>
        <check_box follows="left|top" height="18" label="Sync to camera take" layout="topleft" left="8" top="28" name="sync_take_check" width="210" />
        <spinner decimal_digits="1" follows="left|top|right" height="18" increment="0.5" label="Lead/trail (s)" label_width="88" layout="topleft" left="246" max_val="60" min_val="-60" name="sync_offset_spinner" top="28" width="234" />
        <text follows="left|top|right" height="14" layout="topleft" left="8" top="50" name="sync_status" text_color="LtGray_50" use_ellipses="true" width="472">Off, the walk uses its own clock</text>
        <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="8" top="74" name="follow_lbl" width="70">Follow</text>
        <combo_box follows="left|top" height="22" layout="topleft" left="82" top="70" name="follow_leader_combo" width="236" />
        <button follows="left|top|right" height="22" label="Stop following" layout="topleft" left="326" top="70" name="btn_stop_following" width="154" />
        <spinner decimal_digits="1" follows="left|top" height="18" increment="0.5" initial_value="3.0" label="Behind (m)" label_width="72" layout="topleft" left="8" max_val="64" min_val="0" name="follow_offset_spinner" top="100" width="230" />
        <text follows="left|top|right" height="14" layout="topleft" left="246" top="103" name="follow_status" text_color="LtGray_50" use_ellipses="true" width="234">Not following</text>
      </panel>
    </accordion_tab>
  </accordion>

  <panel
   background_visible="true" background_opaque="true" bg_opaque_color="DkGray"
   border="true" follows="left|top|right" height="48" layout="topleft" left="4"
   name="suspend_banner" top="18" visible="false" width="492">
    <text follows="left|top|right" font="SansSerifSmallBold" height="14" layout="topleft" left="8" name="suspend_status" text_color="EmphasisColor" top="4" use_ellipses="true" width="476">Walk suspended &#8212; actor away</text>
    <button follows="left|top" height="22" label="Resume" layout="topleft" left="8" name="btn_suspend_resume" top="22" width="104" />
    <button follows="left|top" height="22" label="Re-anchor here" layout="topleft" left="120" name="btn_suspend_reanchor" top="22" width="210" />
    <button follows="left|top|right" height="22" label="Cancel walk" layout="topleft" left="338" name="btn_suspend_cancel" top="22" width="146" />
  </panel>
</panel>
