                </combo_box>
            </kit_row>
        </kit_card>
        <kit_card name="kc_character" id="character" kind="rows" title="Character">
            <kit_row bind="setting" help="Tiny random jitter on held poses, like stop-motion or clay. The same every playback." keywords="boil jitter stop motion clay" kind="toggle" label="Pose boil" reset_settings="StepAnimBoil" setting="StepAnimBoil" sub="Pose boil" widget="sa_boil">
                <kit_switch name="sa_boil" control_name="StepAnimBoil" />
            </kit_row>
            <kit_row bind="setting" decimals="2" help="Largest jitter per joint, in degrees." increment="0.05" keywords="boil amount degrees" kind="slider" label="Amount" max_val="3" min_val="0" reset_settings="StepAnimBoilAmount" setting="StepAnimBoilAmount" sub="Pose boil" unit="deg" widget="sa_boil_amount">
                <slider name="sa_boil_amount" control_name="StepAnimBoilAmount" show_text="true" text_width="52" min_val="0" max_val="3" increment="0.05" decimal_digits="2" enabled_control="StepAnimBoil">
                    <slider.slider_bar thumb_center_color="KitSliderThumb" thumb_image="Kit_SliderThumb" thumb_image_disabled="Kit_SliderThumb" thumb_image_pressed="Kit_SliderThumb" thumb_outline_color="KitSliderThumb" track_color="KitSliderTrackEmpty" track_highlight_color="KitSliderTrackFill" track_highlight_horizontal_image="Kit_SliderTrack" track_image_horizontal="Kit_SliderTrack" />
                </slider>
            </kit_row>
            <kit_row bind="setting" decimals="0" help="How many steps each jitter lasts. 1 is the fastest boil." increment="1" keywords="boil rate change every" kind="number" label="Boil every" max_val="8" min_val="1" reset_settings="StepAnimBoilTicks" setting="StepAnimBoilTicks" sub="Pose boil" unit="steps" widget="sa_boil_ticks">
                <spinner name="sa_boil_ticks" control_name="StepAnimBoilTicks" min_val="1" max_val="8" increment="1" decimal_digits="0" enabled_control="StepAnimBoil" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="setting" help="Hit-stop: when a limb stops sharply, the pose holds for a few extra steps." keywords="impact hit stop hold fight" kind="toggle" label="Hold on impact" reset_settings="StepAnimImpactHold" setting="StepAnimImpactHold" sub="Hold on impact" widget="sa_impact">
                <kit_switch name="sa_impact" control_name="StepAnimImpactHold" />
            </kit_row>
            <kit_row bind="setting" decimals="0" help="Extra steps the impact pose is held." increment="1" keywords="impact frames hold steps" kind="number" label="Frames" max_val="12" min_val="1" reset_settings="StepAnimImpactTicks" setting="StepAnimImpactTicks" sub="Hold on impact" unit="steps" widget="sa_impact_ticks">
                <spinner name="sa_impact_ticks" control_name="StepAnimImpactTicks" min_val="1" max_val="12" increment="1" decimal_digits="0" enabled_control="StepAnimImpactHold" text_enabled_color="KitText" text_disabled_color="KitMuted" />
            </kit_row>
            <kit_row bind="setting" decimals="0" help="How sharply a limb must slow down to count as an impact. Lower triggers more often." increment="1" keywords="impact threshold deceleration" kind="slider" label="Threshold" max_val="200" min_val="5" reset_settings="StepAnimImpactThreshold" setting="StepAnimImpactThreshold" sub="Hold on impact" unit="m/s²" widget="sa_impact_threshold">
                <slider name="sa_impact_threshold" control_name="StepAnimImpactThreshold" show_text="true" text_width="52" min_val="5" max_val="200" increment="1" decimal_digits="0" enabled_control="StepAnimImpactHold">
                    <slider.slider_bar thumb_center_color="KitSliderThumb" thumb_image="Kit_SliderThumb" thumb_image_disabled="Kit_SliderThumb" thumb_image_pressed="Kit_SliderThumb" thumb_outline_color="KitSliderThumb" track_color="KitSliderTrackEmpty" track_highlight_color="KitSliderTrackFill" track_highlight_horizontal_image="Kit_SliderTrack" track_image_horizontal="Kit_SliderTrack" />
                </slider>
            </kit_row>
            <kit_row bind="setting" help="On a fast step, the moving limb is drawn stretched between its old and new pose for one step, like an anime smear." keywords="smear stretch anime fast" kind="toggle" label="Smear frames" reset_settings="StepAnimSmear" setting="StepAnimSmear" sub="Smear frames" widget="sa_smear">
                <kit_switch name="sa_smear" control_name="StepAnimSmear" />
            </kit_row>
            <kit_row bind="setting" decimals="2" help="How far the smear stretches and lags the limb." increment="0.05" keywords="smear strength amount" kind="slider" label="Strength" max_val="1" min_val="0" reset_settings="StepAnimSmearStrength" setting="StepAnimSmearStrength" sub="Smear frames" widget="sa_smear_strength">
                <slider name="sa_smear_strength" control_name="StepAnimSmearStrength" show_text="true" text_width="52" min_val="0" max_val="1" increment="0.05" decimal_digits="2" enabled_control="StepAnimSmear">
                    <slider.slider_bar thumb_center_color="KitSliderThumb" thumb_image="Kit_SliderThumb" thumb_image_disabled="Kit_SliderThumb" thumb_image_pressed="Kit_SliderThumb" thumb_outline_color="KitSliderThumb" track_color="KitSliderTrackEmpty" track_highlight_color="KitSliderTrackFill" track_highlight_horizontal_image="Kit_SliderTrack" track_image_horizontal="Kit_SliderTrack" />
                </slider>
            </kit_row>
            <kit_row advanced="true" bind="setting" decimals="1" help="Limb speed, relative to the hips, a step must reach to smear." increment="0.1" keywords="smear threshold speed" kind="slider" label="Smear speed" max_val="10" min_val="0.5" reset_settings="StepAnimSmearThreshold" setting="StepAnimSmearThreshold" sub="Smear frames" unit="m/s" widget="sa_smear_threshold">
                <slider name="sa_smear_threshold" control_name="StepAnimSmearThreshold" show_text="true" text_width="52" min_val="0.5" max_val="10" increment="0.1" decimal_digits="1" enabled_control="StepAnimSmear">
                    <slider.slider_bar thumb_center_color="KitSliderThumb" thumb_image="Kit_SliderThumb" thumb_image_disabled="Kit_SliderThumb" thumb_image_pressed="Kit_SliderThumb" thumb_outline_color="KitSliderThumb" track_color="KitSliderTrackEmpty" track_highlight_color="KitSliderTrackFill" track_highlight_horizontal_image="Kit_SliderTrack" track_image_horizontal="Kit_SliderTrack" />
                </slider>
            </kit_row>
            <kit_row bind="setting" help="Biases held poses toward the extremes of a move, for snappy key poses." keywords="ease spacing extremes key poses snappy" kind="toggle" label="Ease spacing" reset_settings="StepAnimEase" setting="StepAnimEase" sub="Ease spacing" widget="sa_ease">
                <kit_switch name="sa_ease" control_name="StepAnimEase" />
            </kit_row>
            <kit_row bind="setting" decimals="2" help="How strongly held poses lean toward the nearest extreme. 0 holds the plain sample." increment="0.05" keywords="ease amount" kind="slider" label="Amount" max_val="1" min_val="0" reset_settings="StepAnimEaseAmount" setting="StepAnimEaseAmount" sub="Ease spacing" widget="sa_ease_amount">
                <slider name="sa_ease_amount" control_name="StepAnimEaseAmount" show_text="true" text_width="52" min_val="0" max_val="1" increment="0.05" decimal_digits="2" enabled_control="StepAnimEase">
                    <slider.slider_bar thumb_center_color="KitSliderThumb" thumb_image="Kit_SliderThumb" thumb_image_disabled="Kit_SliderThumb" thumb_image_pressed="Kit_SliderThumb" thumb_outline_color="KitSliderThumb" track_color="KitSliderTrackEmpty" track_highlight_color="KitSliderTrackFill" track_highlight_horizontal_image="Kit_SliderTrack" track_image_horizontal="Kit_SliderTrack" />
                </slider>
            </kit_row>
        </kit_card>
        <kit_card name="kc_pairs" id="pairs" kind="rows" title="Pairs well with">
            <kit_row bind="setting" help="Sets Roto Ink's redraw fps and hold frames to this rate, so the ink boils with the steps. Does not turn Roto Ink on." keywords="roto ink match redraw sketch fps" kind="toggle" label="Match Roto Ink" reset_settings="StepAnimMatchRotoInk" setting="StepAnimMatchRotoInk" widget="sa_match_roto">
                <kit_switch name="sa_match_roto" control_name="StepAnimMatchRotoInk" />
            </kit_row>
            <kit_row bind="code" help="Ink lines, sketch boil and line motion are on the Roto Ink page." kind="link" label="Roto Ink" link_to="look_group/stylize_tab" widget="sa_roto_link" />
            <kit_row bind="code" help="Neon grid, rim and trails are on the Tron page." kind="link" label="Tron" link_to="look_group/tron_tab" widget="sa_tron_link" />
            <kit_row bind="code" help="Per-actor looks and their effect fps are on the Actor FX page." kind="link" label="Actor FX" link_to="look_group/actor_style_tab" widget="sa_actorfx_link" />
            <kit_row advanced="true" bind="code" help="Capture time is the World clock on the Time page; slow it down there for exact stepped renders." kind="link" label="World clock" link_to="capture_group/temporal_tab" widget="sa_time_link" />
        </kit_card>
    </kit_page>
</panel>
