<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- [ExposureHub] One floater for the EXISTING exposure / brightness settings (UI only: no new
     setting, mode or behaviour). Every control binds through control_name to a setting that the
     engine already reads live (LLCachedControl / signal), so the original controls (Lightbox,
     Personal Lighting, Preferences, Cine Light Rig, Debug Settings) stay in sync. Tabs are
     wrapped and fitted at runtime by ALScrollFit (alfloaterexposurehub.cpp); sliders take the
     wheel. Reset buttons and the per-tonemapper row gating are wired in the C++ class. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="520"
 layout="topleft"
 min_height="300"
 min_width="360"
 name="exposure_hub"
 save_rect="true"
 single_instance="true"
 title="EXPOSURE"
 width="380">
    <tab_container
     follows="all"
     height="484"
     layout="topleft"
     left="4"
     name="exposure_tabs"
     tab_position="top"
     top="28"
     width="372">
        <panel label="Camera" layout="topleft" name="exp_tab_camera">
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_exposure" top="8" value="Exposure" width="330" />
            <check_box control_name="RenderDynamicExposureEnabled" follows="left|top" height="18" label="Auto exposure" layout="topleft" left="10" name="exp_auto_exposure" tool_tip="Dynamic (auto) exposure. It partially compensates intensity changes (about 2 stops of range), so the light sliders feel softer in dim scenes. Turn it off for a fixed exposure and exact slider control. S-Log3 capture already ignores it. Viewer setting, not saved into the sky." top="28" width="322" />
            <slider can_edit_text="true" control_name="RenderExposure" decimal_digits="1" follows="left|top" height="18" increment="0.1" initial_value="1" label="Exposure" label_width="120" layout="topleft" left="10" max_val="4" min_val="0.5" name="exp_exposure" show_text="true" text_width="48" tool_tip="Adjusts the overall brightness of the image via the Tonemapper (linear gain, 0.5 to 4). Same setting as the Lightbox Image tab and Preferences Advanced." top="52" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_RenderExposure" tab_stop="false" tool_tip="Reset to default" top="53" width="18" />
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_tonemap" top="86" value="Tone mapping" width="330" />
            <text follows="left|top" height="15" layout="topleft" left="10" name="exp_tonemap_type_label" tool_tip="Which algorithm should translate HDR values to SDR Colorspace" top="109" value="Tone mapper:" width="96" />
            <combo_box allow_text_entry="false" control_name="AlchemyRenderTonemapType" follows="left|top" height="20" layout="topleft" left="110" max_chars="128" name="exp_tonemap_type" tool_tip="Which algorithm should translate HDR values to SDR Colorspace" top="106" width="222">
                <combo_box.item label="Khronos Neutral" name="exp_tonemap_type_0" value="0" />
                <combo_box.item label="ACES" name="exp_tonemap_type_1" value="1" />
                <combo_box.item label="ACES Boosted" name="exp_tonemap_type_2" value="2" />
                <combo_box.item label="Reinhard" name="exp_tonemap_type_3" value="3" />
                <combo_box.item label="Filmic" name="exp_tonemap_type_4" value="4" />
                <combo_box.item label="GT" name="exp_tonemap_type_5" value="5" />
                <combo_box.item label="AgX" name="exp_tonemap_type_6" value="6" />
                <combo_box.item label="AMD LPM" name="exp_tonemap_type_7" value="7" />
                <combo_box.item label="S-Log3 Capture" name="exp_tonemap_type_8" value="8" />
            </combo_box>
            <slider can_edit_text="true" control_name="RenderTonemapMix" decimal_digits="1" follows="left|top" height="18" increment="0.1" initial_value="1" label="Tone map strength" label_width="120" layout="topleft" left="10" max_val="1" min_val="0" name="exp_tonemap_mix" show_text="true" text_width="48" tool_tip="Mix between linear and tone mapped colors" top="134" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_RenderTonemapMix" tab_stop="false" tool_tip="Reset to default" top="135" width="18" />
            <slider can_edit_text="true" control_name="AlchemyToneMapAMDExposure" decimal_digits="2" follows="left|top" height="18" increment="0.1" initial_value="7.4" label="AMD tone exposure" label_width="120" layout="topleft" left="10" max_val="16" min_val="1" name="exp_amd_exposure" show_text="true" text_width="48" tool_tip="AMD LPM tonemapper only (type 7): the LPM tone exposure. Dimmed for every other tonemapper." top="160" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyToneMapAMDExposure" tab_stop="false" tool_tip="Reset to default" top="161" width="18" />
            <slider can_edit_text="true" control_name="AlchemyToneMapSLogEV" decimal_digits="1" follows="left|top" height="18" increment="0.1" initial_value="0" label="S-Log EV offset" label_width="120" layout="topleft" left="10" max_val="8" min_val="-8" name="exp_slog_ev" show_text="true" text_width="48" tool_tip="S-Log3 Capture only (type 8): exposure offset (EV stops) applied before the log curve, on top of Exposure. Dimmed for every other tonemapper." top="186" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyToneMapSLogEV" tab_stop="false" tool_tip="Reset to default" top="187" width="18" />
            <check_box control_name="AlchemyTonemapLegacyGammaSkies" follows="left|top" height="18" label="Tonemap legacy-gamma skies" layout="topleft" left="10" name="exp_legacy_gamma_skies" tool_tip="Reflection Probe Ambiance 0 skies normally skip the whole post chain (exposure, auto-exposure, tonemapper, bloom, on-lens filters). ON keeps them active on those skies. Viewer-side only. Same setting as the Lightbox Image tab." top="216" width="322" />
        </panel>
        <panel label="Light" layout="topleft" name="exp_tab_light">
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_light" top="8" value="Scene light (Light Intensity)" width="330" tool_tip="Viewer-side light intensity offsets applied on top of the current sky, in stops (EV). Same settings as Personal Lighting. Saved with your viewer settings, never written into the sky (EEP) asset." />
            <slider can_edit_text="true" control_name="AlchemyEnvSunEV" decimal_digits="2" follows="left|top" height="18" increment="0.05" initial_value="0" label="Sun / Moon EV" label_width="120" layout="topleft" left="10" max_val="6" min_val="-4" name="exp_sun_ev" show_text="true" text_width="48" tool_tip="Sun intensity offset in stops (2^EV: +1 doubles, -1 halves); also the moon while 'Link Moon to Sun' is on. 0 = the sky's stock level, range -4 to +6." top="28" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyEnvSunEV" tab_stop="false" tool_tip="Reset to default" top="29" width="18" />
            <check_box control_name="AlchemyEnvMoonLinked" follows="left|top" height="18" label="Link Moon to Sun" layout="topleft" left="10" name="exp_moon_linked" tool_tip="On (default): the Sun / Moon slider drives both the sun and the moon. Off: the Moon slider takes over at night." top="54" width="322" />
            <slider can_edit_text="true" control_name="AlchemyEnvMoonEV" decimal_digits="2" disabled_control="AlchemyEnvMoonLinked" follows="left|top" height="18" increment="0.05" initial_value="0" label="Moon EV" label_width="120" layout="topleft" left="10" max_val="6" min_val="-4" name="exp_moon_ev" show_text="true" text_width="48" tool_tip="Moon intensity offset in stops (2^EV), used only while 'Link Moon to Sun' is off and the moon is the primary light. 0 = stock, range -4 to +6." top="78" wheel_adjust="true" width="300" />
            <button disabled_control="AlchemyEnvMoonLinked" follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyEnvMoonEV" tab_stop="false" tool_tip="Reset to default" top="79" width="18" />
            <slider can_edit_text="true" control_name="AlchemyEnvSkyGIEV" decimal_digits="2" follows="left|top" height="18" increment="0.05" initial_value="0" label="Sky light (GI) EV" label_width="120" layout="topleft" left="10" max_val="4" min_val="-4" name="exp_gi_ev" show_text="true" text_width="48" tool_tip="Sky light / GI master offset in stops (2^EV). Scales sky ambient and reflection-probe irradiance together. 0 = stock, range -4 to +4." top="104" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyEnvSkyGIEV" tab_stop="false" tool_tip="Reset to default" top="105" width="18" />
            <slider can_edit_text="true" control_name="AlchemyEnvGIAmbientEV" decimal_digits="2" follows="left|top" height="18" increment="0.05" initial_value="0" label="Sky ambient EV" label_width="120" layout="topleft" left="10" max_val="3" min_val="-3" name="exp_amb_ev" show_text="true" text_width="48" tool_tip="Sky ambient (EEP ambient) offset in stops, added to the Sky light (GI) master. 0 = stock, range -3 to +3." top="130" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyEnvGIAmbientEV" tab_stop="false" tool_tip="Reset to default" top="131" width="18" />
            <slider can_edit_text="true" control_name="AlchemyEnvGIProbeDiffuseEV" decimal_digits="2" follows="left|top" height="18" increment="0.05" initial_value="0" label="Probe diffuse EV" label_width="120" layout="topleft" left="10" max_val="3" min_val="-3" name="exp_probe_diff_ev" show_text="true" text_width="48" tool_tip="Reflection-probe irradiance (indirect diffuse) offset in stops, added to the Sky light (GI) master. 0 = stock, range -3 to +3." top="156" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyEnvGIProbeDiffuseEV" tab_stop="false" tool_tip="Reset to default" top="157" width="18" />
            <slider can_edit_text="true" control_name="AlchemyEnvGIProbeSpecEV" decimal_digits="2" follows="left|top" height="18" increment="0.05" initial_value="0" label="Probe reflect. EV" label_width="120" layout="topleft" left="10" max_val="3" min_val="-3" name="exp_probe_spec_ev" show_text="true" text_width="48" tool_tip="Reflection-probe radiance offset in stops (glossy / metal / water reflections). Independent of the GI master. 0 = stock, range -3 to +3." top="182" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyEnvGIProbeSpecEV" tab_stop="false" tool_tip="Reset to default" top="183" width="18" />
            <slider can_edit_text="true" control_name="AlchemyEnvLocalLightEV" decimal_digits="2" follows="left|top" height="18" increment="0.05" initial_value="0" label="Local lights EV" label_width="120" layout="topleft" left="10" max_val="4" min_val="-4" name="exp_local_ev" show_text="true" text_width="48" tool_tip="Local light intensity offset in stops for every world point / spot / projector light. 0 = stock, range -4 to +4. Rig lights are excluded unless 'incl. rig lights' is on in Personal Lighting (Advanced)." top="208" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyEnvLocalLightEV" tab_stop="false" tool_tip="Reset to default" top="209" width="18" />
            <slider can_edit_text="true" control_name="AlchemyEnvShadowLiftEV" decimal_digits="2" follows="left|top" height="18" increment="0.05" initial_value="0" label="Shadow lift EV" label_width="120" layout="topleft" left="10" max_val="2" min_val="0" name="exp_shadow_lift" show_text="true" text_width="48" tool_tip="Raises the ambient / indirect term where the sun or moon does not reach, in stops. 0 = off, range 0 to +2." top="234" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_AlchemyEnvShadowLiftEV" tab_stop="false" tool_tip="Reset to default" top="235" width="18" />
            <button follows="left|top" height="20" label="Personal Lighting..." layout="topleft" left="10" name="exp_personal_lighting_btn" tool_tip="Open Personal Lighting: Light Intensity presets, tints, Kelvin and the sky controls." top="264" width="150">
                <button.commit_callback function="Floater.ShowOrBringToFront" parameter="env_adjust_snapshot" />
            </button>
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_rig" top="304" value="Cine Light Rig" width="330" tool_tip="Same settings as the Cine Light Rig floater, applied live." />
            <spinner control_name="CineLightRigMasterEV" decimal_digits="2" follows="left|top" height="20" increment="0.25" label="Master EV" label_width="120" layout="topleft" left="10" max_val="16" min_val="-16" name="exp_rig_master_ev" tool_tip="Master cinematic light exposure in stops, applied to every rig light." top="324" width="200" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_CineLightRigMasterEV" tab_stop="false" tool_tip="Reset to default" top="325" width="18" />
            <spinner control_name="CineLightRigHeadroomStops" decimal_digits="2" follows="left|top" height="20" increment="0.25" label="Headroom (stops)" label_width="120" layout="topleft" left="10" max_val="16" min_val="0" name="exp_rig_headroom" tool_tip="Exposure stops reserved below the viewer light-intensity ceiling." top="350" width="200" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_CineLightRigHeadroomStops" tab_stop="false" tool_tip="Reset to default" top="351" width="18" />
            <button follows="left|top" height="20" label="Light Rig..." layout="topleft" left="10" name="exp_light_rig_btn" tool_tip="Open the Cinematic Light Rig floater." top="380" width="150">
                <button.commit_callback function="Floater.ShowOrBringToFront" parameter="cine_light_rig" />
            </button>
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_sky" top="420" value="Sky" width="330" />
            <text follows="left|top" font="SansSerifSmall" height="30" layout="topleft" left="10" name="exp_sky_note" top="440" value="Sky gamma and probe ambiance are per sky: edit in Personal Lighting." width="322" word_wrap="true" />
            <button follows="left|top" height="20" label="Personal Lighting..." layout="topleft" left="10" name="exp_sky_lighting_btn" tool_tip="Open Personal Lighting: Scene Gamma and Reflection Probe Ambiance are stored per sky there." top="474" width="150">
                <button.commit_callback function="Floater.ShowOrBringToFront" parameter="env_adjust_snapshot" />
            </button>
        </panel>
        <panel label="Post" layout="topleft" name="exp_tab_post">
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_bloom" top="8" value="Bloom / Glow (HDR)" width="330" tool_tip="HDR bloom composite. Requires HDR bloom (RenderBloomHDR, on by default)." />
            <slider can_edit_text="true" control_name="RenderBloomStrength" decimal_digits="3" enabled_control="RenderBloomHDR" follows="left|top" height="18" increment="0.01" initial_value="0.325" label="Bloom strength" label_width="120" layout="topleft" left="10" max_val="2" min_val="0" name="exp_bloom_strength" show_text="true" text_width="48" tool_tip="HDR bloom composite strength. Multiplies the final bloom pyramid before it is additively blended into the scene." top="28" wheel_adjust="true" width="300" />
            <button enabled_control="RenderBloomHDR" follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_RenderBloomStrength" tab_stop="false" tool_tip="Reset to default" top="29" width="18" />
            <slider can_edit_text="true" control_name="RenderBloomThreshold" decimal_digits="2" enabled_control="RenderBloomHDR" follows="left|top" height="18" increment="0.05" initial_value="2.5" label="Bloom threshold" label_width="120" layout="topleft" left="10" max_val="4" min_val="0" name="exp_bloom_threshold" show_text="true" text_width="48" tool_tip="HDR bloom luminance threshold in linear light. Values above this bloom; below, fall off softly via the knee. 1.0 = roughly brighter than white." top="54" wheel_adjust="true" width="300" />
            <button enabled_control="RenderBloomHDR" follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_RenderBloomThreshold" tab_stop="false" tool_tip="Reset to default" top="55" width="18" />
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_gnd" top="90" value="Graduated ND" width="330" />
            <check_box control_name="RenderGradNDEnabled" follows="left|top" height="18" label="Graduated ND (pre-tonemap)" layout="topleft" left="10" name="exp_gnd_enabled" tool_tip="Native neutral-density gradient applied to linear HDR before the tonemapper, to hold a blown-out sky. Off = no cost." top="110" width="322" />
            <text follows="left|top" enabled_control="RenderGradNDEnabled" height="15" layout="topleft" left="10" name="exp_gnd_preset_label" tool_tip="A preset overrides the Custom sliders. Custom uses Density below." top="137" value="Preset:" width="96" />
            <combo_box allow_text_entry="false" control_name="RenderGradNDPreset" enabled_control="RenderGradNDEnabled" follows="left|top" height="20" layout="topleft" left="110" max_chars="128" name="exp_gnd_preset" tool_tip="A preset overrides the Custom sliders. Custom uses Density below." top="134" width="222">
                <combo_box.item label="Custom (use sliders)" name="exp_gnd_preset_0" value="0" />
                <combo_box.item label="Sky Hold - Light (1 stop)" name="exp_gnd_preset_1" value="1" />
                <combo_box.item label="Sky Hold - Strong (2.5)" name="exp_gnd_preset_2" value="2" />
                <combo_box.item label="Harsh Noon (3 stops)" name="exp_gnd_preset_3" value="3" />
                <combo_box.item label="Golden Hour (sun-weighted)" name="exp_gnd_preset_4" value="4" />
                <combo_box.item label="Optical Grad (no sky mask)" name="exp_gnd_preset_5" value="5" />
                <combo_box.item label="Low / Reflection Hold" name="exp_gnd_preset_6" value="6" />
            </combo_box>
            <slider can_edit_text="true" control_name="RenderGradNDDensity" decimal_digits="2" enabled_control="RenderGradNDEnabled" follows="left|top" height="18" increment="0.1" initial_value="1.5" label="Density (stops)" label_width="120" layout="topleft" left="10" max_val="6" min_val="0" name="exp_gnd_density" show_text="true" text_width="48" tool_tip="Custom: strength in stops. Each stop halves the light. 0 = off. More ND controls are in the Lightbox Image tab." top="160" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_RenderGradNDDensity" tab_stop="false" tool_tip="Reset to default" top="161" width="18" />
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_pol" top="196" value="Polarizer" width="330" />
            <check_box control_name="RenderPolarizerEnabled" follows="left|top" height="18" label="Polarizer (pre-tonemap)" layout="topleft" left="10" name="exp_pol_enabled" tool_tip="Native CPL approximation in linear HDR before the tonemapper: cuts specular glare and deepens the sky. Off = no cost." top="216" width="322" />
            <text follows="left|top" enabled_control="RenderPolarizerEnabled" height="15" layout="topleft" left="10" name="exp_pol_preset_label" tool_tip="A preset overrides the Custom sliders. Custom uses Strength below." top="243" value="Preset:" width="96" />
            <combo_box allow_text_entry="false" control_name="RenderPolarizerPreset" enabled_control="RenderPolarizerEnabled" follows="left|top" height="20" layout="topleft" left="110" max_chars="128" name="exp_pol_preset" tool_tip="A preset overrides the Custom sliders. Custom uses Strength below." top="240" width="222">
                <combo_box.item label="Custom (use sliders)" name="exp_pol_preset_0" value="0" />
                <combo_box.item label="Deep Blue Sky" name="exp_pol_preset_1" value="1" />
                <combo_box.item label="Glare Killer (water/glass)" name="exp_pol_preset_2" value="2" />
                <combo_box.item label="Landscape (sky + glare)" name="exp_pol_preset_3" value="3" />
                <combo_box.item label="Subtle" name="exp_pol_preset_4" value="4" />
            </combo_box>
            <slider can_edit_text="true" control_name="RenderPolarizerStrength" decimal_digits="2" enabled_control="RenderPolarizerEnabled" follows="left|top" height="18" increment="0.05" initial_value="0.7" label="Strength" label_width="120" layout="topleft" left="10" max_val="1" min_val="0" name="exp_pol_strength" show_text="true" text_width="48" tool_tip="Custom: overall polarizer intensity. 0 = off. More polarizer controls are in the Lightbox Image tab." top="266" wheel_adjust="true" width="300" />
            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_RenderPolarizerStrength" tab_stop="false" tool_tip="Reset to default" top="267" width="18" />
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_nm" top="302" value="Night Mask" width="330" tool_tip="Same settings as the Night Mask card of the Cinematic Light Rig. Scene setting, not saved in Setups." />
