            <button follows="left|top" height="18" image_overlay="Refresh_Off" image_top_pad="0" layout="topleft" left="314" name="rst_CineLightRigNightMaskDarkness" tab_stop="false" tool_tip="Reset to default" top="349" width="18" />
            <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="10" name="exp_hdr_ir" top="384" value="Infrared Film" width="330" />
            <check_box control_name="RenderInfraredEnabled" follows="left|top" height="18" label="Enable infrared" layout="topleft" left="10" name="exp_ir_enabled" tool_tip="Infrared film emulation before tonemapping." top="404" width="322" />
            <text enabled_control="RenderInfraredEnabled" follows="left|top" height="15" layout="topleft" left="10" name="exp_ir_preset_label" top="431" value="Look:" width="96" />
            <combo_box allow_text_entry="false" enabled_control="RenderInfraredEnabled" follows="left|right|top" height="20" layout="topleft" left="110" name="exp_ir_preset" top="428" width="222">
