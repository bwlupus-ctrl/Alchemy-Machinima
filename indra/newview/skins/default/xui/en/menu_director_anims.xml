<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [Director] context menu for the Animate tab's signaled-animation list.
     Callbacks (Director.Anim*) are registered with a ScopedRegistrar in
     LLFloaterDirector::postBuild() before this file is instantiated. -->
<context_menu
 layout="topleft"
 name="DirectorAnimsContextMenu">
  <menu_item_call
   label="Copy UUID"
   layout="topleft"
   name="copy_uuid">
    <menu_item_call.on_click
     function="Director.AnimCopyUUID" />
  </menu_item_call>
  <menu_item_call
   label="Set as loco anim"
   layout="topleft"
   name="set_as_loco">
    <menu_item_call.on_click
     function="Director.AnimSetLoco" />
  </menu_item_call>
  <menu_item_separator layout="topleft" />
  <menu_item_call
   label="Play local"
   layout="topleft"
   name="play_local">
    <menu_item_call.on_click
     function="Director.AnimPlayLocal" />
  </menu_item_call>
  <menu_item_call
   label="Stop local"
   layout="topleft"
   name="stop_local">
    <menu_item_call.on_click
     function="Director.AnimStopLocal" />
  </menu_item_call>
</context_menu>
