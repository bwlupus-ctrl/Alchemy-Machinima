<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [ActorMover] context menu for the Animation Explorer's animation list.
     Callbacks (AnimExplorer.*) are registered with a ScopedRegistrar in
     AnimationExplorer::postBuild() before this file is instantiated. -->
<context_menu
 layout="topleft"
 name="AnimationExplorerContextMenu">
  <menu_item_call
   label="Copy Animation UUID"
   layout="topleft"
   name="copy_anim_uuid">
    <menu_item_call.on_click
     function="AnimExplorer.CopyUUID" />
  </menu_item_call>
  <menu_item_call
   label="Send to Actor Mover"
   layout="topleft"
   name="send_to_actor_mover">
    <menu_item_call.on_click
     function="AnimExplorer.ToActorMover" />
  </menu_item_call>
</context_menu>
