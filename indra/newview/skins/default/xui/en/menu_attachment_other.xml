<!-- *NOTE: See also menu_avatar_other.xml -->
<context_menu
 layout="topleft"
 name="Avatar Attachment Pie">
  <!-- [Director] Machinima tools, consolidated. The cast / subject / mover /
       cinecam / mark items resolve the attachment's WEARER avatar via
       find_avatar_from_object and share the Director cast state; subjects and
       marks are cast members, so their setters add to the cast when needed.
       Alpha Mode is the per-object session alpha override for THIS attachment.
       Client-side, session-only. -->
